var PROMPT='';
function getRequestedQuestionCount(){
  var input=document.getElementById('questionCount');
  if(!input)return DEFAULT_QUESTION_COUNT;
  var raw=String(input.value||'').trim();
  if(!raw)return DEFAULT_QUESTION_COUNT;
  var parsed=parseInt(raw,10);
  if(!Number.isFinite(parsed))return DEFAULT_QUESTION_COUNT;
  return Math.max(1,Math.min(MAX_AI_QUESTION_COUNT,parsed));
}
function normalizeQuestionCountInput(){
  var input=document.getElementById('questionCount');
  var count=getRequestedQuestionCount();
  if(input)input.value=String(count);
  return count;
}
function buildPrompt(){
  var count=getRequestedQuestionCount();
  var quizName=document.getElementById('quizName').value.trim();
  var quizNameRule=quizName
    ? '- Use this exact top-level "name": '+JSON.stringify(quizName)
    : '- If the setup name field is blank, infer a concise quiz title from the content';
  return `You are a veteran NBME/NBOME item writer producing board-style questions for USMLE Step 1 and COMLEX-USA Level 1 across ALL disciplines: anatomy, embryology, histology, physiology, biochemistry, molecular/genetics, microbiology, immunology, general and systems pathology, pharmacology, behavioral science and psychiatry, neuroscience, nutrition, aging, biostatistics/epidemiology, ethics/communication, patient safety, and (for COMLEX) osteopathic principles, OMM, and structural/viscerosomatic findings.

Your calibration target is the released NBME item pool ("USMLE Step 1 Sample Test Questions"): its stem conventions, its lead-in phrasings, and above all its DISTRACTOR CRAFT. Write items that would pass NBME item review, in whatever discipline the source content is about — do not force everything into psychiatry.

MODE 1 — GENERATE: If I give you notes or lecture content, write quiz questions from it.
MODE 2 — CONVERT: If I give you already-written questions in any format, convert them into the format below without changing the medical content.

Output ONLY a raw JSON object — no markdown, no backticks, no commentary.

{
  "name": "Concise quiz title here",
  "questions": [
    {
      "stem": "Full clinical vignette ending in the lead-in question.",
      "choices": [
        "A. Option text",
        "B. Option text",
        "C. Option text",
        "D. Option text",
        "E. Option text"
      ],
      "correct": 2,
      "explanation": "Why the correct answer is right. Use arrows (→) to show mechanisms.",
      "wrongExplanations": {
        "0": "Why A is wrong — name the one feature that would have to change for A to be correct.",
        "1": "Why B is wrong — name the one feature that would have to change for B to be correct.",
        "3": "Why D is wrong — name the one feature that would have to change for D to be correct.",
        "4": "Why E is wrong — name the one feature that would have to change for E to be correct."
      },
      "eli5": "Explain the concept like the student is 10. Max 3 sentences."
    }
  ]
}

JSON contract (exact):
- "correct" is a NUMBER: 0=A, 1=B, 2=C, 3=D, 4=E, 5=F, 6=G, 7=H, 8=I
- "wrongExplanations" keys are the 0-based indexes of the WRONG choices only. If correct is 2 (C), the keys are "0","1","3","4". Never key by position-among-wrong-answers; always key by actual choice index. Every wrong choice gets an explanation.
- Choice strings embed their letter prefix ("A. ...", "B. ...").
- 4 options minimum, 5 is the default, up to 9 (A–I) for ordered series, factorial grids, and matched-set table items. Vary the count across the batch the way the real exam does — do not make every item exactly five.
- Return exactly ${count} questions in "questions".
${quizNameRule}
- NO IMAGES: this app renders text only. Never write "shown in the photograph," "the arrow indicates," or "labeled region A." When the source concept is image-based (histology, gross specimen, x-ray, ECG, fundus, pedigree, graph), convert it into a described-findings item — put the findings into words in the stem ("A biopsy specimen shows sheets of small round blue cells with rosettes") and make the options named structures/diagnoses instead of letters on a picture.
- Plain-text tables are allowed inside "stem" (aligned columns or pipes) for lab panels and matched-set items.
- Output ONLY the JSON object.

════════ SILENT PLANNING PROTOCOL (do this for EVERY item, before writing its vignette) ════════
1. Pick the discipline and the testing point, one rung above recall when the content allows: mechanism, localization, genetics, causal organism, next step, treatment rationale, downstream consequence, or study-design consequence.
2. Pick the correct answer, and state to yourself the single sentence of reasoning that produces it.
3. Design the TRAP: the specific wrong answer a hurried reader should pick, plus the dramatic decoy detail that tempts them there.
4. Design the BURIED CLUE: the one quiet fact that decides the item (a duration, one vital, one lab, one exam finding, one exposure, one negative, one demographic). Clue and decoy must be different details.
5. Build the option set as one homogeneous family using DISTRACTOR ARCHITECTURE below — decide the family type first, then populate it.
6. Apply the COVER-THE-OPTIONS TEST: a competent student who reads the stem with the options hidden should be able to state the answer. If not, the stem is underspecified — fix the stem, do not fix it with the options.
7. Only then write the vignette around that plan.
Never show this planning. Only the finished items appear in output.

════════ IF YOU ARE A SMALLER / LESS RELIABLE MODEL ════════
The planning protocol above and the ANSWER KEY CHECK below only work if they actually run — a weaker model will often silently "claim" a hidden step and skip straight to output, which is exactly how low-quality batches slip through. If you are not a large frontier-scale model, don't trust yourself to do this invisibly:
1. Before anything else, output exactly one line of plain text, nothing else on it, no braces or brackets in it: "I just need to run a check before outputting the answers."
2. On the next lines, visibly run the ANSWER KEY CHECK (list every item's correct letter in order, tally them, fix and re-tally if badly skewed).
3. Then output the final JSON object as the very next thing, with nothing after it — still no markdown fences, no backticks, no other commentary.
If you are a large/frontier-capable model, ignore this section: do the planning and key check silently and output only the JSON per the contract above.

════════ PROFILE SELECTION ════════
- USMLE/NBME profile (default): full clinical vignette, precise vitals and labs, separate "Which of the following..." lead-in on its own line. Typical stem 90–170 words.
- COMLEX/NBOME profile: use when the source includes OMM, structural/viscerosomatic findings, cranial concepts, Chapman points, forensic psych, iatrogenic scenarios, or osteopathic principles. The ask is often folded into the final sentence ("...The most likely diagnosis is"). Typical stem 60–120 words — tighter.
- CHART/TABULAR format: reproduce the patient-chart layout — Patient Information (Age / Gender / Race-Ethnicity / Site of Care), History (Reason for Visit, HPI bullets, PMH, Medications, Allergies, Family History, Psychosocial History), Physical Examination (vitals row + system bullets), Diagnostic Studies, then "Question:" and the lead-in. Familiar abbreviations are allowed inside this format only. Use it for 1 in every 15–20 items.
- RECALL/APPLIED profile: no patient at all — a bare mechanism, criteria, or fact question ("Which of the following enzymes is most likely involved...", "Which of the following best describes this phase of drug development?"), or a laboratory/investigator scenario ("An investigator is studying...").
- A batch may mix profiles; match the mix to the source content.

════════ VIGNETTE SKELETON (NBME house style — follow in order) ════════
1. Opening line: age + sex + how they present + where + why, with an exact duration. Use the real verbs: "comes to the office because of," "is brought to the emergency department by her parents because of," "is admitted to the hospital for," "is evaluated in," "A newborn delivered at 36 weeks' gestation to a 22-year-old woman, gravida 1, para 1, has..." Timed arrivals when acuity matters ("30 minutes after the sudden onset of").
2. Exact duration and interval history — never vague. Durations are frequently load-bearing.
3. Findings in observational language, never diagnostic labels: describe what is seen, not what it is called.
4. Background block in NBME phrasing: "He has no history of serious illness and takes no medications." / "Her only medication is lisinopril." / "She does not smoke cigarettes, drink alcoholic beverages, or use other substances." / "Family history is noncontributory." Include exposures, travel, occupation, and diet only when they carry the clue or a deliberate decoy.
5. Vitals in house format: "Her temperature is 38.2°C (100.8°F), pulse is 84/min, respirations are 18/min, and blood pressure is 120/80 mm Hg. Pulse oximetry on room air shows an oxygen saturation of 96%." Height/weight in dual units with BMI when body habitus matters ("He is 170 cm (5 ft 7 in) tall and weighs 181 kg (400 lb); BMI is 63 kg/m2"). Use "Vital signs are within normal limits" when vitals are not the point.
6. Examination in clipped positive-and-negative form: "Physical examination shows no abnormalities." "Lungs are clear to auscultation." "There is tenderness to palpation of the left lower quadrant." Roughly 85% unremarkable, with the 1–2 buried clues embedded inside it.
7. Data block when needed — labs as an aligned two-column table. Give a reference range in parentheses "(N=270–950)" ONLY for analytes that are not on the standard USMLE lab table; otherwise let the student know the normal.
8. Explicit negatives in full sentences ("A heterophile antibody test result is negative." "Test of the stool for occult blood is negative." "Urine toxicology screening is negative."). Every stated negative must eliminate a specific listed option — no atmosphere-only negatives.
9. Lead-in last, from the inventory below.

════════ LEAD-IN INVENTORY (use these verbatim shapes) ════════
Diagnosis: "Which of the following is the most likely diagnosis?"
Cause/mechanism: "Which of the following is the most likely underlying cause of this patient's condition?" · "...most likely mechanism of this patient's symptoms?" · "Which of the following processes best explains..." · "The most likely cause of the findings in this patient is a mutation in which of the following types of genes?"
Organism: "Which of the following infectious agents is the most likely cause of these findings?"
Anatomy/localization: "The lesion in this patient is most likely located at which of the following spinal cord levels?" · "This patient most likely has a brain lesion in which of the following lobes?" · "...is most likely obstructed at which of the following anatomic locations?"
Prediction: "Physical examination is most likely to show which of the following findings?" · "...is most likely to show which of the following?" · "Which of the following additional findings is most likely in this patient?"
Pharmacology: "The most appropriate pharmacotherapy for this patient has which of the following mechanisms of action?" · "...is from which of the following drug classes?" · "A drug from which of the following classes is most appropriate for this patient?" · "An adjunct therapy designed to inhibit which of the following enzymes is most likely indicated?"
Management/next step: "Which of the following is the most appropriate next step in management?" · "...next step in diagnosis?" · "It is most appropriate to obtain specific additional history regarding which of the following?"
Communication/ethics: "Which of the following is the most appropriate initial response by the physician?" · "...most appropriate physician statement?" · "...most appropriate next remark by the physician?"
Biostatistics: "Which of the following is the best estimate of..." · "Which of the following effects will this have on the research study?" · "Which of the following factors is most likely to be improved by..."
COMLEX inline form: "...The most likely diagnosis is" (options then start lowercase and complete the sentence).

════════ DISTRACTOR ARCHITECTURE — the core craft ════════
This is what separates a real board item from a quiz-app item. Build the option SET as an object, not five sentences you thought of one at a time.

RULE 0 — HOMOGENEITY. Every option answers the same question, at the same level of abstraction, in the same grammatical form, from one category: all diagnoses, or all organisms, or all enzymes, or all anatomic levels, or all mechanisms, or all management steps, or all physician statements. If one option would still be an odd fit after a student rewrote the stem, the set is broken.

RULE 1 — THE COUNTERFACTUAL TEST. For every distractor you must be able to finish this sentence: "This would be the answer if the vignette had said ___ instead." One changed detail, precisely nameable. If you cannot name it, the option is filler — replace it. That sentence is also what goes into wrongExplanations.

THE TWELVE OPTION-SET FAMILIES (pick one per item; rotate across the batch):
1. DIFFERENTIAL SET — same presenting syndrome, distractors separated from the key by exactly one discriminator (age, duration, cell line, one lab, one exposure). Example shape: bloody diarrhea in a child → five enteric organisms, each the right answer for a different stool/lab/incubation profile.
2. SAME-PATHWAY MOLECULAR SET — the key plus its immediate neighbors in one pathway or one protein family, each of which would produce a *different* laboratory phenotype. Never mix a pathway member with an unrelated molecule.
3. FACTORIAL RECEPTOR/PHARM GRID — build the full cross-product and use all of it as options: alpha1/alpha2/beta1 × agonism/antagonism (six options); each cell is a real drug class, only one matches the physiology asked. Same trick for enzyme families and hormone axes.
4. DIRECTION-SWAP MECHANISM SET — every option is "Increased X" / "Decreased X" over 3–5 different variables. Distractors = correct variable in the wrong direction, plus variables that move only later in the disease, plus one that moves in a related-but-different condition.
5. ORDERED-SERIES SET — spinal levels, chromosomes, trial phases, dermatomes, gestational ages, probabilities (1 of 2, 1 of 3, 1 of 4, 2 of 3, 3 of 4). Bracket the key above and below, and make each wrong value correspond to a NAMED reasoning error (off-by-one level, wrong Punnett denominator, forgetting to condition on being unaffected, using incidence for prevalence).
6. ANATOMIC-PATH SET — successive points along one tube, tract, or vessel (renal calyx → ureteropelvic junction → mid ureter → ureterovesical junction → bladder neck; or successive venous drainage routes). The correct level is fixed by the described imaging or exam pattern; each other level would give a describably different picture.
7. MATCHED-SET TABLE ITEM — 2–4 columns of findings (Fremitus / Percussion / Breath sounds; FEV1 / FVC / TLC / DLCO; Oxygen tension / Osmolality; Drug A / Drug B), and each option is one ROW of combined values. Render the header and rows as an aligned plain-text table inside "stem", and write each choice as its row, e.g. "B. Decreased, hyperresonant, decreased". Include rows that are right in one column and wrong in another so partial knowledge fails. 4–6 rows.
8. COMPUTATION/FORMULA SET — options are expressions or numbers, each encoding one specific error: relative instead of absolute risk, inverted ratio, applying an irrelevant participation rate, sensitivity confused with PPV, false-positives confused with true-negatives. The distractors are the arithmetic a student actually does wrong, not random numbers.
9. STRUCTURE/REGION SET — named CNS or anatomic structures when the item is localization (hippocampus, caudate, thalamus, insula, corpus callosum). Distractors are structures that would produce a different, nameable deficit.
10. RISK-FACTOR/HISTORY SET — "Which factor most increased this patient's risk?" and the options are attributes the patient actually has, listed in the vignette. Distractors are real but weaker or non-causal risk factors seeded earlier in the stem. This family requires the vignette to plant all of them.
11. COMMUNICATION/ETHICS SCRIPT SET — 4–5 quoted physician statements. Exactly one satisfies the hierarchy (acknowledge/validate → open-ended exploration → assess directly → address the patient before third parties → honest without premature certainty). Each distractor violates exactly ONE named principle: false reassurance, premature or withheld disclosure, judgment/blame, closed-ended premature plan, deferring to family over patient, moralizing, or offloading to another service.
12. NEXT-STEP SET — all options are actions of the SAME kind as the lead-in asks: a diagnosis lead-in gets tests only, never treatments; a management lead-in gets the conservative/sequential action, never the most aggressive; a pharmacotherapy lead-in gets drugs or mechanisms, never diagnoses.

REQUIRED DISTRACTOR ROLES (every item, whichever family):
- NEAR-MISS: the same-family answer differing by one criterion (duration, age, direction, cell line, one lab, one level).
- SURFACE-READ: what you would pick from the chief complaint or the most dramatic detail alone, ignoring the buried clue.
- MECHANISM-CONFUSION: right disease or right pathway, wrong step, wrong level, or wrong direction.
- CLEAN ELIMINATIONS: the remaining options — plausible on first glance, decisively excluded by something explicitly written in the stem.

CALIBRATION RULES:
- Every distractor must be chosen by *someone*. No absurd options, no options excluded by the patient's age or sex alone, no joke entries, no "normal" filler in a set of abnormalities.
- Every explicit negative in the stem kills a listed option; every listed option is killed by something in the stem. Audit both directions before shipping the item.
- Options are mutually exclusive; none is a subset or restatement of another; never a compound ("A and C"), never "all/none of the above."
- Parallel length and specificity. The key must not be the longest, the most hedged, the most technical, or the only one that grammatically agrees with the stem.
- No convergence cue: do not let the key be the option that shares the most word-stems with the other options, and do not let it be the only one repeating a distinctive word from the stem.
- No absolute-term giveaways ("always," "never") and no vague-frequency terms ("usually," "often") that make an option unfalsifiable.
- Order options ALPHABETICALLY (or numerically/anatomically/logically for ordered series), exactly as the real exam does — never by how correct they are. Lowercase completion options for the COMLEX inline form are alphabetized as written.

════════ ITEM FORMAT VARIETY ════════
Not every item is a 150-word ED vignette. Across a batch, mix:
- Full clinical vignette (NBME/COMLEX skeleton) — 55–65%.
- Compact narrative or 2–4 sentence vignette (personality/behavioral pattern recognition, classic-triad recognition) — 10–15%.
- Investigator/study scenario (drug development phase, cohort design, questionnaire validity, sample-size effect on Type I/II error) — 5–10%.
- Chart/tabular format item — about 1 per 15–20 items.
- Matched-set table, factorial grid, or ordered-series item — 10–15%.
- Pure recall/mechanism one-liner or dose-sequencing item (name the drug, the dose, and the max, then ask the next step: augment, cross-taper, switch class) — 10%.
Scale these proportions to the batch size; with fewer than 8 items, cover at least three different shapes.

════════ NAMED TRAP PATTERNS — spread across the batch ════════
- DRAMATIC DECOY: the most striking detail is scenery; the quiet one decides it.
- MEDICAL MIMIC: psychiatric or vague presenting complaint, but a physical/lab finding reveals an organic cause.
- SECOND-WORKUP TRAP: an acute change from a documented recent baseline tempts the chronic diagnosis when the answer is the reversible acute cause.
- ONE-STEP-BACK: the item asks for the cause of the cause (not "what does she have" but "what mechanism produced it"), so the surface diagnosis is a distractor.
- DURATION ARITHMETIC: durations act as hard constraints and must be internally consistent and decisive on their own.
- IATROGENIC IN PROGRESS: a complication unfolds from treatment already started; the answer targets the mechanism, not the surface complaint.
- NORMAL-VALUE TRAP: a value that is technically within range but wrong for the clinical context (a "normal" reticulocyte count during acute anemia; a "normal" glucagon response).
- TIME-COURSE TRAP: the finding asked about is what will be true LATER (or what was true 10 seconds after onset), not what is true now.
- COMLEX layer: viscerosomatic segmental findings used exactly like a lab value; a fully described normal structural exam used as an active rule-out; osteopathic vocabulary in 1–2 distractors that are plausible on wording alone.

════════ BATCH BLUEPRINT ════════
Match the discipline mix to the source content first. When the source is broad, aim for: 30–40% most-likely-diagnosis or most-likely-cause, 15–20% mechanism/pathophysiology, 10–15% pharmacology (including at least one contraindication or adverse-effect item), 10% anatomy/localization/embryology, 10% microbiology/immunology when relevant, 5–10% biostatistics/epidemiology/study design, and 1 communication or ethics item whenever the content touches patient interaction. Do not use the same correct diagnosis more than twice per batch. Where the source supports it, build one 2–3 item chain off a single clinical picture (presentation → diagnosis → mechanism or treatment), each item still answerable on its own.

════════ ANSWER KEY CHECK (run after drafting, before output) ════════
Options are ordered alphabetically, so the key lands wherever alphabetization puts it — that is correct and expected, and this app additionally reshuffles choices at run time. Do NOT distort wording or ordering to hit a letter quota. Just verify: (1) list every item's correct letter in order; (2) if one letter takes more than half the batch or the same letter is correct for 4+ consecutive items, fix it by substituting an equally valid distractor whose alphabetization moves the key — never by changing which option is medically correct, and never by padding an option's wording.

════════ ANTI-PATTERNS — never do these ════════
- Diagnostic label language in the stem ("she is clearly manic," "classic tension pneumothorax").
- Teaching in the stem ("classic for," "pathognomonic," "which is characteristic of").
- Negatively phrased lead-ins ("Which of the following is NOT...", "All of the following EXCEPT").
- Stems under 40 words that name the disease and ask a trivia fact about it ("A patient with schizophrenia..." pseudo-stems), unless it is a deliberate pure-recall item.
- Mixed-category option sets (a drug hiding among diagnoses; a test hiding among treatments).
- "All of the above," "none of the above," compound options.
- Key identifiable by length, precision, hedging, technical vocabulary, or grammatical agreement.
- Vague durations ("recently," "for a while," "several weeks") when duration matters.
- Negatives that rule out nothing on the list.
- Two defensible answers. If it is genuinely borderline, revise the stem until exactly one option is unambiguous.
- Any reference to an image, photograph, arrow, graph, or labeled letter on a figure.

════════ WORKED EXEMPLARS (original, style reference ONLY — never reuse their content) ════════
EXEMPLAR 1 — differential set, buried clue in the data block:
"A 24-year-old man comes to the office because of a 3-week history of fatigue and shortness of breath with exertion. He has no history of serious illness and takes no medications. He returned 2 months ago from a hiking trip in the Andes. His temperature is 37.0°C (98.6°F), pulse is 96/min, respirations are 16/min, and blood pressure is 118/74 mm Hg. Physical examination shows conjunctival pallor and scleral icterus; the spleen is palpated 3 cm below the left costal margin. Results of laboratory studies show a hemoglobin concentration of 8.9 g/dL, mean corpuscular volume of 88 um3, reticulocyte count of 9%, and lactate dehydrogenase activity of 480 U/L. Serum haptoglobin concentration is undetectable. Which of the following is the most likely underlying cause of this patient's anemia?"
Options (alphabetical): A. Decreased erythropoietin production / B. Extravascular destruction of erythrocytes / C. Impaired heme synthesis / D. Ineffective erythropoiesis / E. Sequestration of iron in macrophages. Correct: B.
Architecture: family 1 + family 4 (mechanism directions). Buried clue = reticulocytosis with undetectable haptoglobin and splenomegaly (a destructive, not a productive, defect). Dramatic decoy = the high-altitude travel, which surface-reads toward erythropoietin. Each distractor is a hypoproliferative or maturation defect that would produce a LOW reticulocyte count — one changed lab flips to each. The normal MCV kills the microcytic and macrocytic options explicitly.

EXEMPLAR 2 — factorial grid, prediction lead-in:
"A 58-year-old man is brought to the emergency department 45 minutes after the sudden onset of crushing substernal chest pain. His pulse is 118/min and blood pressure is 82/54 mm Hg. Physical examination shows jugular venous distention and clear lungs. An ECG shows ST-segment elevation in leads II, III, and aVF. Which of the following sets of hemodynamic changes is most likely in this patient?"
Stem carries a plain-text table with columns Right atrial pressure / Pulmonary capillary wedge pressure / Cardiac output, and options are its rows: "A. Increased, decreased, decreased" ... "E. Decreased, decreased, increased". Correct: the row with increased RA pressure, low-normal wedge, decreased output.
Architecture: family 7. Every row is internally coherent and corresponds to a real shock state (cardiogenic left-sided, tamponade, hypovolemic, distributive), so partial knowledge of one column does not carry the item.

EXEMPLAR 3 — communication script set:
"A 71-year-old woman is admitted to the hospital for evaluation of a 2-month history of weight loss and jaundice. CT scan of the abdomen shows a mass in the head of the pancreas and multiple hepatic lesions. Biopsy is scheduled for the following morning. The patient's son meets the physician in the hallway and asks that his mother not be told the results, saying she 'will give up.' The patient has capacity and has not asked to be shielded from information. Which of the following is the most appropriate initial response by the physician?"
Options are five quoted statements; the key acknowledges the son's concern and then explores what the patient herself wants to know. Each distractor violates exactly one principle: agreeing to withhold (autonomy), disclosing the full prognosis to the son (confidentiality), flat refusal without exploration (rapport), and deferring the whole conversation to the oncology service (offloading).

════════ QUALITY GATE — run silently on every item before output ════════
Stem: complete opening line · exact duration · observational not diagnostic wording · vitals/labs in house format · at least one explicit negative that kills a listed option · passes the cover-the-options test · no image references.
Trap: exactly one buried clue · one separate dramatic decoy · the clue alone is decisive.
Options: one homogeneous family · every distractor passes the counterfactual test · near-miss + surface-read + mechanism-confusion roles present · all plausible to a reader who missed the clue · mutually exclusive · exactly one unambiguously correct · no length/grammar/convergence cue · alphabetically ordered.
Match: stem type = answer type · management answers conservative-first · diagnosis-workup answers are tests · communication items follow the hierarchy · COMLEX structural findings are confirmatory or rule-out, never decorative · duration math internally consistent.
Explanations: "explanation" gives the reasoning chain with arrows; each "wrongExplanations" entry names the one feature that would have made that option correct; "eli5" is plain language, max 3 sentences.
If an item fails after 2–3 silent revisions, drop it and write a replacement. Never ship a failing item and never show the checklist.

Professor-voice notes: clipped exam findings, precise numbers, subtle pattern-recognition clues, no giveaway wording, occasional grounded real-world detail. When the source emphasizes them, lean on: UMN/LMN/NMJ/myopathy localization, exact genetics (chromosome, repeat, inheritance pattern), Circle-of-Willis and brainstem vascular localization, mechanism-of-injury nerve/plexus localization, CSF and pulmonary-function profile patterns, acid-base and electrolyte reasoning, enzyme-deficiency substrate accumulation, drug mechanism and adverse-effect pairing, and vignette-to-histopathology description pairing. Reuse heavily emphasized concepts with fresh vignette surfaces.

MY CONTENT:
`;
}
function refreshPromptText(){
  var count=getRequestedQuestionCount();
  PROMPT=buildPrompt();
  document.getElementById('promptCountChip').textContent='Target: '+count+' question'+(count===1?'':'s');
  document.getElementById('promptText').textContent=PROMPT;
}
function handleQuestionCountInput(){
  refreshPromptText();
}
function handleQuestionCountBlur(){
  normalizeQuestionCountInput();
  refreshPromptText();
}
refreshPromptText();
DOWNLOAD_TEMPLATE=document.documentElement.outerHTML;

function copyPrompt(){
  navigator.clipboard.writeText(PROMPT).then(function(){
    var b=document.getElementById('copyPromptBtn');
    b.textContent='✅ Copied!';
    b.classList.add('ok');
    showToast('Prompt copied! Add your content after it.','ok');
    setTimeout(function(){
      b.textContent='📋 Copy prompt';
      b.classList.remove('ok');
    },2500);
  });
}

// ── PARSE ──
function parseRaw(raw){
  raw=raw.trim().replace(/^```(?:json)?\s*/i,'').replace(/\s*```\s*$/,'').trim();
  try{return JSON.parse(raw);}catch(e){}
  var objectMatch=raw.match(/\{[\s\S]*\}/);
  if(objectMatch){try{return JSON.parse(objectMatch[0]);}catch(e){}}
  var arrayMatch=raw.match(/\[[\s\S]*\]/);
  if(arrayMatch){try{return JSON.parse(arrayMatch[0]);}catch(e){}}
  return null;
}
function shuffle(arr){
  var out=arr.slice();
  for(var i=out.length-1;i>0;i--){
    var j=Math.floor(Math.random()*(i+1));
    var tmp=out[i];
    out[i]=out[j];
    out[j]=tmp;
  }
  return out;
}
function cloneQuestion(q){
  return {
    stem:String(q.stem||''),
    highlights:getQuestionHighlights(q),
    choices:Array.isArray(q.choices)?q.choices.map(String):[],
    correct:typeof q.correct==='number'?q.correct:(parseInt(q.correct,10)||0),
    explanation:String(q.explanation||''),
    wrongExplanations:Object.assign({},q.wrongExplanations||{}),
    eli5:String(q.eli5||'')
  };
}
function buildWrongExplanationLookup(rawChoices, rawCorrect, wrongExplanations){
  var lookup={};
  if(!wrongExplanations||typeof wrongExplanations!=='object')return lookup;
  var wrongChoiceIndices=[];
  rawChoices.forEach(function(_,idx){if(idx!==rawCorrect)wrongChoiceIndices.push(idx);});
  var directHits=wrongChoiceIndices.filter(function(idx){return !!wrongExplanations[String(idx)];}).length;
  var orderedHits=wrongChoiceIndices.filter(function(_,orderPos){return !!wrongExplanations[String(orderPos+1)];}).length;
  var useOrdered=orderedHits>directHits;
  wrongChoiceIndices.forEach(function(idx,orderPos){
    var chosenKey=useOrdered?String(orderPos+1):String(idx);
    if(wrongExplanations[chosenKey])lookup[String(idx)]=String(wrongExplanations[chosenKey]);
  });
  return lookup;
}
function randomizeQuestionChoices(q){
  var source=cloneQuestion(q);
  var choiceMeta=source.choices.map(function(choiceText,idx){
    return {
      text:String(choiceText||''),
      isCorrect:idx===source.correct,
      wrongExplanation:idx!==source.correct&&source.wrongExplanations[String(idx)]?String(source.wrongExplanations[String(idx)]):''
    };
  });
  var realChoices=choiceMeta.filter(function(choice){return choice.text.trim();});
  var blankChoices=choiceMeta.filter(function(choice){return !choice.text.trim();});
  var shuffledChoices=shuffle(realChoices).concat(blankChoices);
  var randomized={stem:source.stem,highlights:source.highlights,choices:[],correct:0,explanation:source.explanation,wrongExplanations:{},eli5:source.eli5};
  shuffledChoices.forEach(function(choice,idx){
    randomized.choices.push(choice.text);
    if(choice.isCorrect)randomized.correct=idx;
    else if(choice.text.trim()&&choice.wrongExplanation)randomized.wrongExplanations[String(idx)]=choice.wrongExplanation;
  });
  return randomized;
}
function randomizeQuestionsForSession(list){
  return list.map(function(q){return randomizeQuestionChoices(q);});
}
function normQ(q){
  if(!q.stem||!Array.isArray(q.choices)||q.choices.length<2)return null;
  var rawChoices=q.choices.map(String);
  while(rawChoices.length<5)rawChoices.push('');
  var rawCorrect=typeof q.correct==='number'?q.correct:(parseInt(q.correct)||0);
  if(rawCorrect<0||rawCorrect>=rawChoices.length)rawCorrect=0;
  var wrongLookup=buildWrongExplanationLookup(rawChoices, rawCorrect, q.wrongExplanations);
  var nq={stem:String(q.stem),highlights:getQuestionHighlights(q),choices:[],correct:0,explanation:String(q.explanation||''),wrongExplanations:{},eli5:String(q.eli5||'')};
  rawChoices.forEach(function(choiceText,idx){
    nq.choices.push(choiceText);
    if(idx===rawCorrect)nq.correct=idx;
    else if(wrongLookup[String(idx)])nq.wrongExplanations[String(idx)]=String(wrongLookup[String(idx)]);
  });
  return nq;
}
function getNormalizedQuizPayloadFromRaw(raw){
  var parsed=parseRaw(raw);
  if(!parsed)return null;
  var rawQuestions=Array.isArray(parsed)?parsed:(parsed&&typeof parsed==='object'&&Array.isArray(parsed.questions)?parsed.questions:null);
  if(!rawQuestions)return null;
  var valid=[];
  rawQuestions.forEach(function(q){var nq=normQ(q);if(nq)valid.push(nq);});
  if(!valid.length)return null;
  var parsedName='';
  if(parsed&&typeof parsed==='object'&&!Array.isArray(parsed)){
    parsedName=String(parsed.name||parsed.quizName||parsed.title||'').trim();
  }
  return {name:parsedName,questions:valid};
}
function getNormalizedQuestionsFromRaw(raw){
  var payload=getNormalizedQuizPayloadFromRaw(raw);
  return payload?payload.questions:null;
}
function getPasteAreaIds(){
  return ['pasteArea1','pasteArea2','pasteArea3','pasteArea4'];
}
var activePasteSetTab=1;
function showPasteSetTab(setNumber){
  activePasteSetTab=Math.max(1,Math.min(4,parseInt(setNumber,10)||1));
  syncPasteSetTabs();
}
function syncPasteSetTabs(){
  getPasteAreaIds().forEach(function(id,idx){
    var setNumber=idx+1;
    var tab=document.getElementById('pasteTab'+setNumber);
    var panel=document.getElementById('pastePanel'+setNumber);
    var textarea=document.getElementById(id);
    var isActive=setNumber===activePasteSetTab;
    var hasContent=!!(textarea&&textarea.value.trim());
    if(tab){
      tab.classList.toggle('active',isActive);
      tab.classList.toggle('has-content',hasContent);
      tab.setAttribute('aria-selected',isActive?'true':'false');
    }
    if(panel){
      panel.classList.toggle('active',isActive);
      panel.hidden=!isActive;
    }
  });
}
function getPastedSetEntries(){
  return getPasteAreaIds().map(function(id,idx){
    var el=document.getElementById(id);
    return {id:id,setNumber:idx+1,raw:el?el.value.trim():''};
  }).filter(function(entry){return !!entry.raw;});
}
function getCombinedPastedQuizPayload(){
  var entries=getPastedSetEntries();
  if(!entries.length){
    return {error:'Paste at least one AI response into Set 1, 2, 3, or 4 first.'};
  }
  var combinedQuestions=[];
  var firstParsedName='';
  entries.forEach(function(entry){
    var parsedPayload=getNormalizedQuizPayloadFromRaw(entry.raw);
    if(!parsedPayload){
      throw new Error('__SET_PARSE_ERROR__'+entry.setNumber);
    }
    if(!firstParsedName&&parsedPayload.name)firstParsedName=parsedPayload.name;
    combinedQuestions=combinedQuestions.concat(parsedPayload.questions);
  });
  var typedName=document.getElementById('quizName').value.trim();
  var combinedName=typedName||(
    entries.length>1
      ? (firstParsedName?firstParsedName+' — Combined':'Combined Custom Quiz')
      : (firstParsedName||'Custom Quiz')
  );
  return {payload:{name:combinedName,questions:combinedQuestions}};
}

// ── UI MODE ──
function selectLaunchUI(mode){
  uiMode=mode==='nbme'?'nbme':'classic';
  syncLaunchUIButtons();
}
function switchQuizUI(mode){
  var next=mode==='nbme'?'nbme':'classic';
  if(uiMode===next)return;
  uiMode=next;
  syncLaunchUIButtons();
  if(questions.length){
    switchView(getQuizViewId());
    renderQ();
    showToast(next==='nbme'?'NBME / NBOME layout enabled.':'UNE layout enabled.','ok');
  }
}
function getQuizViewId(){
  return uiMode==='nbme'?'viewQuizNbme':'viewQuiz';
}
function syncLaunchUIButtons(){
  var classicBtn=document.getElementById('uiModeClassicBtn');
  var nbmeBtn=document.getElementById('uiModeNbmeBtn');
  classicBtn.classList.toggle('active',uiMode==='classic');
  nbmeBtn.classList.toggle('active',uiMode==='nbme');
}

// ── LAB VALUES ──
function renderLabs(){
  document.getElementById('labUnitsUs').classList.toggle('active',labUnitMode==='us');
  document.getElementById('labUnitsSi').classList.toggle('active',labUnitMode==='si');
  document.getElementById('labTables').innerHTML=LAB_SECTIONS.map(function(section){
    var rows=section.rows.map(function(row){
      if(row.group)return `<tr class="lab-group"><td colspan="2">${row.group}</td></tr>`;
      return `<tr><td class="${row.name?'':'continuation'}">${row.name||'—'}</td><td>${labUnitMode==='si'?row.si:row.us}</td></tr>`;
    }).join('');
    return `<table class="lab-table"><thead><tr><th>${section.title}</th><th>${labUnitMode==='si'?'SI Reference':'Reference Range'}</th></tr></thead><tbody>${rows}</tbody></table>`;
  }).join('');
}
function openLabs(){
  renderLabs();
  document.getElementById('labModal').classList.add('open');
}
function closeLabs(){
  document.getElementById('labModal').classList.remove('open');
}
function setLabUnits(unit){
  labUnitMode=unit==='si'?'si':'us';
  renderLabs();
}

// ── QUIZ LIFECYCLE ──
function setQuizTitle(name){
  document.title='QUIZ: '+(name||'Custom Quiz');
  document.getElementById('qtName').textContent=name;
  document.getElementById('nbQuizTitle').textContent=name;
}
function getQuizTitle(){
  return document.getElementById('qtName').textContent.trim()||document.getElementById('quizName').value.trim()||'Custom Quiz';
}
function resetQuizState(withTimerReset){
  questionNotes={};
  answers={};
  selected={};
  marked={};
  stemMarkup={};
  choiceMarkup={};
  NC=0;
  NI=0;
  CQ=0;
  examSubmitted=false;
  reviewOpen=false;
  summaryVisible=false;
  finishBannerMinimized=false;
  toolMode='';
  if(withTimerReset)resetTimer();else updTimer();
  syncToolButtons();
  syncModeButtons();
  syncMarkButtons();
  updScore();
}
// ── SESSION PERSISTENCE (resume where you left off) ──
function getSessionKey(){
  var basis=getQuizTitle()+'|'+(questionBank.length?JSON.stringify(questionBank.map(function(q){var clean=Object.assign({},q);delete clean.highlights;return clean;})):'');
  var hash=0;
  for(var i=0;i<basis.length;i++){hash=((hash<<5)-hash+basis.charCodeAt(i))|0;}
  return 'quiz-builder-session-'+Math.abs(hash).toString(36);
}
function saveSession(){
  if(!questions.length||!questionBank.length)return;
  try{
    localStorage.setItem(getSessionKey(),JSON.stringify({
      v:1,questionNotes:questionNotes,questions:questions,selected:selected,answers:answers,marked:marked,
      stemMarkup:stemMarkup,choiceMarkup:choiceMarkup,
      CQ:CQ,NC:NC,NI:NI,quizMode:quizMode,examSubmitted:examSubmitted,
      timerSec:timerSec,timerDisplayMode:timerDisplayMode,uiMode:uiMode
    }));
    return true;
  }catch(e){return false;}
}
function clearSession(){
  try{localStorage.removeItem(getSessionKey());}catch(e){}
}
function tryRestoreSession(){
  var saved=null;
  try{saved=JSON.parse(localStorage.getItem(getSessionKey())||'null');}catch(e){return false;}
  if(!saved||saved.v!==1||!Array.isArray(saved.questions))return false;
  if(saved.questions.length!==questionBank.length)return false;
  var hasProgress=Object.keys(saved.questionNotes||{}).length>0||Object.keys(saved.selected||{}).length>0||Object.keys(saved.answers||{}).length>0||saved.timerSec>0;
  if(!hasProgress)return false;
  questions=saved.questions.map(function(q){return cloneQuestion(q);});
  questionNotes=saved.questionNotes&&typeof saved.questionNotes==='object'?saved.questionNotes:{};
  selected=saved.selected||{};
  answers=saved.answers||{};
  marked=saved.marked||{};
  stemMarkup=saved.stemMarkup||{};
  choiceMarkup=saved.choiceMarkup||{};
  CQ=Math.min(Math.max(0,saved.CQ||0),questions.length-1);
  NC=saved.NC||0;NI=saved.NI||0;
  quizMode=saved.quizMode==='exam'?'exam':'learn';
  examSubmitted=!!saved.examSubmitted;
  timerSec=saved.timerSec||0;
  timerDisplayMode=saved.timerDisplayMode==='remaining'?'remaining':'elapsed';
  timerExpiredHandled=getRemainingSeconds()===0;
  reviewOpen=false;summaryVisible=false;finishBannerMinimized=false;toolMode='';
  syncToolButtons();syncModeButtons();syncMarkButtons();updScore();updTimer();
  return true;
}

// ── FULLSCREEN ──
function toggleFullscreen(){
  var doc=document;
  if(doc.fullscreenElement||doc.webkitFullscreenElement){
    (doc.exitFullscreen||doc.webkitExitFullscreen).call(doc);
  }else{
    var el=doc.documentElement;
    var req=el.requestFullscreen||el.webkitRequestFullscreen;
    if(req)req.call(el);
    else showToast('Fullscreen is not supported in this browser.','err');
  }
}
document.addEventListener('fullscreenchange',function(){
  var btn=document.getElementById('nbFsBtn');
  if(btn)btn.textContent=document.fullscreenElement?'⛶ Exit Fullscreen':'⛶ Fullscreen';
});

function startQuiz(valid,name){
  questionBank=valid.map(function(q){return cloneQuestion(q);});
  document.getElementById('quizName').value=name||'Custom Quiz';
  setQuizTitle(name||'Custom Quiz');
  var restored=tryRestoreSession();
  if(!restored){
    questions=randomizeQuestionsForSession(questionBank);
    quizMode='learn';
    resetQuizState(true);
  }
  applyFontSize();
  document.getElementById('errMsg').className='err-msg';
  renderItemSelectors();
  switchView(getQuizViewId());
  renderQ();
  if(restored)showToast('Previous session restored — press Reset for a fresh attempt.','ok');
}
function getQuizPayload(){
  if(Array.isArray(questionBank)&&questionBank.length){
    return {name:getQuizTitle(),questions:questionBank.map(function(q){return cloneQuestion(q);})};
  }
  try{
    var combinedResult=getCombinedPastedQuizPayload();
    if(!combinedResult||combinedResult.error||!combinedResult.payload)return null;
    return {
      name:combinedResult.payload.name,
      questions:combinedResult.payload.questions.map(function(q){return cloneQuestion(q);})
    };
  }catch(err){
    return null;
  }
}
function buildDownloadFileName(name){
  var safeName=String(name||'Custom Quiz')
    .replace(/\.html?$/i,'')
    .replace(/[<>:"/\\|?*\u0000-\u001f]/g,' ')
    .replace(/\s+/g,' ')
    .trim()
    .replace(/\.+$/,'');
  if(!safeName)safeName='Custom Quiz';
  if(!/\bquiz$/i.test(safeName))safeName+=' Quiz';
  return safeName.slice(0,96)+'.html';
}
function toEmbeddedJSONString(value){
  return JSON.stringify(value).replace(/<\/script/gi,'<\\/script').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');
}
function buildDownloadHTML(payload){
  var title=document.createElement('title');
  title.textContent='QUIZ: '+(payload.name||'Custom Quiz');
  return DOWNLOAD_TEMPLATE
    .replace(/(<div class="view) active(" id="viewSetup">)/,'$1$2')
    .replace(/<title>[^<]*<\/title>/i,function(){return title.outerHTML;})
    .replace(/^var PRELOADED_QUIZ_NAME=[^\r\n]*;/m,function(){return 'var PRELOADED_QUIZ_NAME='+toEmbeddedJSONString(payload.name||'Custom Quiz')+';';})
    .replace(/^var PRELOADED_QUESTIONS_JSON=[^\r\n]*;/m,function(){return 'var PRELOADED_QUESTIONS_JSON='+toEmbeddedJSONString(JSON.stringify(payload.questions||[]))+';';})
    .replace(/^var PRELOADED_UI_MODE=[^\r\n]*;/m,function(){return 'var PRELOADED_UI_MODE='+toEmbeddedJSONString('nbme')+';';});
}
function triggerQuizDownload(blob,fileName){
  var url=URL.createObjectURL(blob);
  var a=document.createElement('a');
  a.href=url;
  a.download=fileName;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(function(){URL.revokeObjectURL(url);},1000);
}
function isSafariLikeBrowser(){
  var ua=navigator.userAgent||'';
  return /Safari/i.test(ua)&&!/Chrome|Chromium|CriOS|Edg|OPR|Firefox|FxiOS|Android/i.test(ua);
}
function getDownloadFallbackPrompt(fileName){
  if(isSafariLikeBrowser()){
    return 'This browser cannot open a save-location picker from this local quiz page, so Safari will use its normal download flow instead.\n\nIf you want macOS to ask where to save each quiz, open Safari > Settings > General and set "File download location" to "Ask for each download".\n\nDownload "'+fileName+'" now?';
  }
  return 'This browser does not support choosing a save location directly from this quiz page.\n\nI can still download "'+fileName+'" using your browser\'s normal download flow.\n\nContinue?';
}
async function downloadQuiz(){
  var payload=getQuizPayload();
  if(!payload){
    showErr('Paste a valid quiz first so I have something to save.');
    return;
  }
  var html=buildDownloadHTML(payload);
  var blob=new Blob([html],{type:'text/html'});
  var fileName=buildDownloadFileName(payload.name);
  if(typeof window.showSaveFilePicker==='function'){
    try{
      var handle=await window.showSaveFilePicker({
        suggestedName:fileName,
        types:[{
          description:'HTML Quiz File',
          accept:{'text/html':['.html']}
        }]
      });
      var writable=await handle.createWritable();
      await writable.write(blob);
      await writable.close();
      document.getElementById('errMsg').className='err-msg';
      showToast('Saved your quiz file.','ok');
      return;
    }catch(err){
      if(err&&err.name==='AbortError')return;
    }
  }
  if(!window.confirm(getDownloadFallbackPrompt(fileName)))return;
  triggerQuizDownload(blob,fileName);
  document.getElementById('errMsg').className='err-msg';
  showToast(isSafariLikeBrowser()?'Safari download started. Use "Ask for each download" in Safari settings to choose the save location each time.':'Browser download started.','ok');
}
function hydratePreloadedQuiz(){
  var hasPreloadedQuestions=PRELOADED_QUESTIONS_JSON!=="__QUIZ_BUILDER_PRELOADED_QUESTIONS__";
  if(PRELOADED_UI_MODE!=="__QUIZ_BUILDER_PRELOADED_UI_MODE__")selectLaunchUI(PRELOADED_UI_MODE);
  else if(hasPreloadedQuestions)selectLaunchUI('nbme');
  if(PRELOADED_QUIZ_NAME!=="__QUIZ_BUILDER_PRELOADED_NAME__")document.getElementById('quizName').value=PRELOADED_QUIZ_NAME;
  if(PRELOADED_QUESTIONS_JSON==="__QUIZ_BUILDER_PRELOADED_QUESTIONS__")return;
  try{
    var preloaded=JSON.parse(PRELOADED_QUESTIONS_JSON);
    if(!Array.isArray(preloaded)||!preloaded.length)throw new Error('Empty saved quiz');
    document.getElementById('pasteArea1').value=JSON.stringify(preloaded,null,2);
    showPasteSetTab(1);
    startQuiz(preloaded,PRELOADED_QUIZ_NAME||'Custom Quiz');
    showToast('Saved quiz loaded.','ok');
  }catch(e){
    switchView('viewSetup');
    showErr('This saved quiz could not be loaded. Paste the questions below to try again.');
  }
}
function launchQuiz(){
  try{
    var combinedResult=getCombinedPastedQuizPayload();
    if(combinedResult.error){showErr(combinedResult.error);return;}
    startQuiz(combinedResult.payload.questions,combinedResult.payload.name);
  }catch(err){
    if(err&&typeof err.message==='string'&&err.message.indexOf('__SET_PARSE_ERROR__')===0){
      var setNumber=err.message.replace('__SET_PARSE_ERROR__','');
      showPasteSetTab(Number(setNumber));
      showErr("Couldn't read Set "+setNumber+". Make sure you copied the full AI response for that set.");
      return;
    }
    showErr("Couldn't read the pasted sets. Make sure each AI response is complete JSON in the expected format.");
  }
}

// ══ KEY FINDINGS — vignette highlights, revealed once a question is submitted ══
var VH_CATS=['finding','mechanism','term','pattern','workup'];
var VH_CAT_LABELS={finding:'Discriminating finding',mechanism:'Mechanism',term:'Key term',pattern:'Pattern / trap',workup:'What is being asked'};
var activeVhHighlights=[],vhLastFocus=null;
function sanitizeHighlights(list){
  if(!Array.isArray(list))return [];
  return list.filter(function(h){return h&&h.text&&h.body;}).map(function(h){
    return {text:String(h.text),cat:VH_CATS.indexOf(h.cat)>=0?h.cat:'finding',eyebrow:String(h.eyebrow||'KEY FINDING'),title:String(h.title||'Why it matters'),body:String(h.body)};
  });
}
function getQuestionHighlights(q){
  if(Array.isArray(q.highlights))return sanitizeHighlights(q.highlights);
  // Older saved attempts have no highlights. Recover metadata by stem without changing order or answers.
  var bank=typeof questionBank!=='undefined'&&questionBank;
  if(bank){for(var i=0;i<bank.length;i++){if(bank[i].stem===q.stem&&bank[i].highlights)return sanitizeHighlights(bank[i].highlights);}}
  return [];
}
function questionIsSubmitted(index){return !!answers[index];}
function getStemHTMLForDisplay(index){
  var base=stripVhMarks(getStemHTML(index)),q=questions[index];
  activeVhHighlights=[];
  if(!questionIsSubmitted(index)||!q||!q.highlights||!q.highlights.length)return base;
  var root=document.createElement('div');root.innerHTML=base;
  q.highlights.forEach(function(h){
    if(markPhraseInElement(root,h,activeVhHighlights.length))activeVhHighlights.push(h);
  });
  return root.innerHTML;
}
function vhTextMap(root){
  var text='',map=[];
  function addSpace(){if(text&&!/\s$/.test(text)){text+=' ';map.push(null);}}
  function visit(el){
    if(el.nodeType===Node.TEXT_NODE){
      for(var j=0;j<el.nodeValue.length;j++){
        var c=el.nodeValue[j];
        if(/\s/.test(c)){addSpace();continue;}
        text+=c;map.push({node:el,offset:j});
      }
    }else if(el.nodeType===Node.ELEMENT_NODE){
      if(/^(BR|P|DIV|TR|TD|TH|LI|TABLE|UL|OL)$/.test(el.tagName))addSpace();
      Array.from(el.childNodes).forEach(visit);
      if(/^(BR|P|DIV|TR|TD|TH|LI|TABLE|UL|OL)$/.test(el.tagName))addSpace();
    }
  }
  visit(root);return {text:text,map:map};
}
function markPhraseInElement(root,h,idx){
  var flat=vhTextMap(root),phrase=h.text.replace(/\s+/g,' ').trim(),pos=flat.text.indexOf(phrase);
  while(pos>=0){
    var covered=flat.map.slice(pos,pos+phrase.length).filter(Boolean);
    if(covered.length&&!covered.some(function(p){return p.node.parentElement.closest('mark.vh');})){
      var segments=[];
      covered.forEach(function(p){
        var last=segments[segments.length-1];
        if(last&&last.node===p.node)last.end=p.offset+1;
        else segments.push({node:p.node,start:p.offset,end:p.offset+1});
      });
      segments.reverse().forEach(function(s){
        var mid=s.node.splitText(s.start);mid.splitText(s.end-s.start);
        var mark=document.createElement('mark');mark.className='vh vh-cat-'+h.cat;
        mark.setAttribute('data-vh-idx',String(idx));mark.setAttribute('tabindex','0');mark.setAttribute('role','button');
        mark.setAttribute('aria-label',VH_CAT_LABELS[h.cat]+': '+h.title);
        mark.setAttribute('aria-controls','vhPanel');mark.setAttribute('aria-haspopup','dialog');
        mid.parentNode.replaceChild(mark,mid);mark.appendChild(mid);
      });
      return true;
    }
    pos=flat.text.indexOf(phrase,pos+phrase.length);
  }
  return false;
}
function buildVhLegendHTML(index){
  if(!questionIsSubmitted(index)||!activeVhHighlights.length)return '';
  var used=VH_CATS.filter(function(cat){return activeVhHighlights.some(function(h){return h.cat===cat;});});
  var colors={finding:'coral',mechanism:'teal',term:'gold',pattern:'violet',workup:'sky'};
  return '<div class="vh-legend"><span class="vh-legend-label">How to tackle it</span>'+used.map(function(cat){
    return '<span class="vh-legend-item"><span class="vh-legend-dot" style="background:var(--vh-'+colors[cat]+'-bg);border:1.5px solid var(--vh-'+colors[cat]+')"></span>'+VH_CAT_LABELS[cat]+'</span>';
  }).join('')+'<span class="vh-legend-hint">Hover or tap a highlight for why it matters.</span></div>';
}
function stripVhMarks(html){
  if(String(html).indexOf('data-vh-idx')<0)return html;
  var root=document.createElement('div');root.innerHTML=html;
  root.querySelectorAll('mark.vh').forEach(function(mark){while(mark.firstChild)mark.parentNode.insertBefore(mark.firstChild,mark);mark.remove();});
  root.normalize();return root.innerHTML;
}
function vhEscape(text){return String(text||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function showVhTooltip(mark){
  var h=activeVhHighlights[+mark.getAttribute('data-vh-idx')],tip=document.getElementById('vhTooltip');
  if(!h||!tip)return;
  var teaser=h.body.length>160?h.body.slice(0,160).replace(/\s+\S*$/,'')+'…':h.body;
  tip.innerHTML='<div class="vht-eyebrow">'+vhEscape(h.eyebrow)+'</div><div class="vht-title">'+vhEscape(h.title)+'</div><div class="vht-teaser">'+vhEscape(teaser)+'</div>';
  tip.classList.add('show');
  var rect=mark.getBoundingClientRect(),width=tip.offsetWidth;
  tip.style.left=Math.max(8,Math.min(rect.left,window.innerWidth-width-8))+'px';
  var top=rect.bottom+8;if(top+tip.offsetHeight>window.innerHeight-8)top=rect.top-tip.offsetHeight-8;
  tip.style.top=Math.max(8,top)+'px';
}
function hideVhTooltip(){var tip=document.getElementById('vhTooltip');if(tip)tip.classList.remove('show');}
function openVhPanel(mark){
  var h=activeVhHighlights[+mark.getAttribute('data-vh-idx')],panel=document.getElementById('vhPanel');
  if(!h||!panel)return;
  hideVhTooltip();vhLastFocus=mark;
  panel.className='vh-panel open vh-panel-'+h.cat;panel.setAttribute('aria-hidden','false');
  document.getElementById('vhPanelEyebrow').textContent=h.eyebrow;
  document.getElementById('vhPanelTitle').textContent=h.title;
  document.getElementById('vhPanelBody').textContent=h.body;
  panel.querySelector('button').focus({preventScroll:true});
}
function closeVhPanel(){
  var panel=document.getElementById('vhPanel');
  if(panel){var hadFocus=panel.contains(document.activeElement);panel.classList.remove('open');panel.setAttribute('aria-hidden','true');if(hadFocus&&vhLastFocus&&vhLastFocus.isConnected)vhLastFocus.focus({preventScroll:true});}
  vhLastFocus=null;
}
document.addEventListener('mouseover',function(e){var mark=e.target.closest&&e.target.closest('mark.vh');if(mark&&window.matchMedia('(hover: hover)').matches)showVhTooltip(mark);});
document.addEventListener('mouseout',function(e){if(e.target.closest&&e.target.closest('mark.vh'))hideVhTooltip();});
document.addEventListener('focusin',function(e){var mark=e.target.closest&&e.target.closest('mark.vh');if(mark)showVhTooltip(mark);});
document.addEventListener('focusout',hideVhTooltip);
document.addEventListener('scroll',hideVhTooltip,true);
document.addEventListener('click',function(e){
  var mark=e.target.closest&&e.target.closest('mark.vh');
  if(mark){if(!toolMode&&window.getSelection().isCollapsed)openVhPanel(mark);return;}
  if(!e.target.closest('#vhPanel'))closeVhPanel();
});
document.addEventListener('keydown',function(e){
  var mark=e.target.closest&&e.target.closest('mark.vh');
  if(mark&&(e.key==='Enter'||e.key===' ')){e.preventDefault();e.stopPropagation();openVhPanel(mark);}
  if(e.key==='Escape'){closeVhPanel();hideVhTooltip();}
});

// ── STATE HELPERS ──
function stripChoiceLabel(text){
  return String(text||'').replace(/^[A-I]\.\s*/i,'');
}
function choiceLetter(index){
  return LETTERS[index]||String.fromCharCode(65+index);
}
function getStemHTML(index){
  return stemMarkup[index]!=null?stemMarkup[index]:questions[index].stem;
}
function ensureChoiceMarkup(index){
  if(!choiceMarkup[index])choiceMarkup[index]=[];
  return choiceMarkup[index];
}
function getChoiceHTML(index,choiceIndex){
  var arr=ensureChoiceMarkup(index);
  return arr[choiceIndex]!=null?arr[choiceIndex]:stripChoiceLabel(questions[index].choices[choiceIndex]);
}
function getSelectedChoice(index){
  if(answers[index]&&answers[index].s!==null&&answers[index].s!==undefined)return answers[index].s;
  return selected[index];
}
function getAnsweredCount(){
  return examSubmitted?questions.length:(quizMode==='exam'?Object.keys(selected).length:Object.keys(answers).length);
}
function getMarkedCount(){
  return Object.keys(marked).filter(function(key){return !!marked[key];}).length;
}
function isQuizComplete(){
  return (quizMode==='learn'&&questions.length&&Object.keys(answers).length===questions.length)||(quizMode==='exam'&&examSubmitted);
}
function updateScoreCounts(){
  NC=0;
  NI=0;
  Object.keys(answers).forEach(function(key){
    if(answers[key].r==='c')NC++;
    else NI++;
  });
}
function getScorePercent(){
  var denom=(quizMode==='exam'&&examSubmitted)?questions.length:(NC+NI);
  return denom?Math.round(NC/denom*100):'—';
}
function getAnswerStateMeta(ans){
  if(!ans)return {label:'Pending',className:'unanswered'};
  if(ans.r==='c')return {label:'Correct',className:'correct'};
  if(ans.r==='u')return {label:'No Answer',className:'unanswered'};
  return {label:'Incorrect',className:'incorrect'};
}
function buildSummaryStatsHTML(){
  var percent=getScorePercent();
  return `<div class="sum-stats">
    <div class="sum-stat"><div class="sum-stat-label">Score</div><div class="sum-stat-value">${percent==='—'?'—':percent+'%'}</div></div>
    <div class="sum-stat"><div class="sum-stat-label">Correct</div><div class="sum-stat-value">${NC}</div></div>
    <div class="sum-stat"><div class="sum-stat-label">Incorrect</div><div class="sum-stat-value">${NI}</div></div>
    <div class="sum-stat"><div class="sum-stat-label">Questions</div><div class="sum-stat-value">${questions.length}</div></div>
  </div>`;
}
function buildReviewSheetItemsHTML(){
  return questions.map(function(q,index){
    var ans=answers[index];
    var meta=getAnswerStateMeta(ans);
    var correctLetter=choiceLetter(q.correct);
    return `<article class="sum-item ${meta.className}">
      <div class="sum-meta">
        <div class="sum-num">Question ${index+1}</div>
        <div class="sum-state">${meta.label}</div>
        <div class="sum-answer">Correct Answer: ${correctLetter}</div>
      </div>
      <div class="sum-body">
        <div class="sum-section"><div class="sum-label">Question</div><div class="sum-text">${q.stem}</div></div>
        <div class="sum-section"><div class="sum-label">Answer choices</div><div class="sum-text">${q.choices.map(function(choice,ci){return '<div>'+choiceLetter(ci)+'. '+stripChoiceLabel(choice)+(ci===q.correct?' <strong>(Correct)</strong>':'')+'</div>';}).join('')}</div></div>
        ${questionNotes[index]?'<div class="sum-section"><div class="sum-label">My notes</div><div class="sum-text study-notes-text">'+escapeStudyText(questionNotes[index])+'</div></div>':''}
        <div class="sum-section">
          <div class="sum-label">Correct Answer Explanation</div>
          <div class="sum-text">${q.explanation||'No explanation provided.'}</div>
        </div>
        <div class="sum-section">
          <div class="sum-label">ELI5</div>
          <div class="sum-text">${q.eli5||'No ELI5 summary provided.'}</div>
        </div>
      </div>
    </article>`;
  }).join('');
}
function buildReviewSheetHTML(forPrint){
  var title=getQuizTitle();
  var actionHTML=forPrint?'':`<div class="sum-actions"><button class="sum-btn" type="button" onclick="hideSummarySheet()">← Back to Questions</button><button class="sum-btn primary" type="button" onclick="printSummarySheet()">🖨 Print / Save PDF</button><button class="sum-btn" type="button" onclick="exportSummarySheet()">Export Summary</button></div>`;
  return `<section class="sum-sheet" id="summarySheet">
    <div class="sum-head">
      <div>
        <div class="sum-kicker">Quiz Review Sheet</div>
        <h2 class="sum-title">${title}</h2>
        <div class="sum-sub">Question-by-question review with questions, answer choices, personal notes, correct-answer explanations, and ELI5 summaries.</div>
      </div>
      ${actionHTML}
    </div>
    ${buildSummaryStatsHTML()}
    <div class="sum-list">${buildReviewSheetItemsHTML()}</div>
  </section>`;
}
function getSummaryPrintStyles(){
  return `
    .study-notes-text{white-space:pre-wrap;overflow-wrap:anywhere}img{max-width:100%;height:auto}
    .qfig{margin:12px 0;break-inside:avoid}.qfig img{width:100%;height:auto}.qfig-cap{font-size:12px;color:#555}
    body{margin:0;padding:28px;background:#fff;color:#1E1E20;font-family:Arial,Helvetica,sans-serif}
    .sum-sheet{border:1px solid #d8dce3;border-radius:18px;overflow:hidden}
    .sum-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:22px 24px 18px;border-bottom:1px solid #e4e7ec;background:#f8fafc}
    .sum-kicker{font-family:Consolas,monospace;font-size:11px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#6B7689;margin-bottom:8px}
    .sum-title{font-size:30px;line-height:1.08;color:#12203C;margin:0 0 8px}
    .sum-sub{font-size:14px;line-height:1.6;color:#3E4555;max-width:68ch}
    .sum-stats{display:flex;gap:12px;flex-wrap:wrap;padding:18px 24px;border-bottom:1px solid #e4e7ec;background:#fbf8f3}
    .sum-stat{min-width:140px;padding:14px 16px;border-radius:14px;border:1px solid #e4e7ec;background:#fff}
    .sum-stat-label{font-size:10px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:#6B7689;margin-bottom:8px}
    .sum-stat-value{font-size:30px;line-height:1;color:#12203C;font-weight:700}
    .sum-list{display:grid;gap:14px;padding:22px 24px}
    .sum-item{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;padding:18px;border-radius:16px;border:1px solid #e4e7ec;background:#fff;break-inside:avoid-page;page-break-inside:avoid}
    .sum-item.correct{background:#f6fcf8}
    .sum-item.incorrect{background:#fff8f8}
    .sum-item.unanswered{background:#fffaf1}
    .sum-meta{display:flex;flex-direction:column;gap:10px}
    .sum-num,.sum-state{display:inline-flex;align-items:center;justify-content:center;width:max-content}
    .sum-num{min-height:38px;padding:0 14px;border-radius:999px;background:#eef2f6;font-family:Consolas,monospace;font-size:12px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:#12203C}
    .sum-state{min-height:30px;padding:0 12px;border-radius:999px;font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
    .sum-item.correct .sum-state{background:#E8F5EE;color:#2D8659}
    .sum-item.incorrect .sum-state{background:#FDF0F0;color:#C44040}
    .sum-item.unanswered .sum-state{background:#FEF5E6;color:#C07B1A}
    .sum-answer{font-size:13px;font-weight:900;letter-spacing:.04em;text-transform:uppercase;color:#3E4555}
    .sum-body{display:grid;gap:12px}
    .sum-section{padding:14px 16px;border-radius:14px;border:1px solid #eceff3;background:#faf7f1}
    .sum-label{font-family:Consolas,monospace;font-size:10px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:#6B7689;margin-bottom:8px}
    .sum-text{font-size:14px;line-height:1.62;color:#1E1E20}
  `;
}
function printSummarySheet(){
  if(!isQuizComplete())return;
  var printWindow=window.open('','_blank','noopener,noreferrer,width=1120,height=900');
  if(!printWindow){
    showToast('Allow pop-ups so I can open the printable review sheet.','err');
    return;
  }
  printWindow.document.open();
  printWindow.document.write(`<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>${getQuizTitle()} — Review Sheet</title><style>${getSummaryPrintStyles()}</style></head><body>${buildReviewSheetHTML(true)}</body></html>`);
  printWindow.document.close();
  printWindow.focus();
  setTimeout(function(){
    printWindow.print();
  },250);
}
function buildNbmeCompletionViewHTML(){
  var finishHTML=buildFinishHTML({allowMinimize:true});
  return `<div class="sum-view" id="completionViewTop">${finishHTML}${buildNbmeQuestion()}</div>`;
}
function buildSummaryViewHTML(){
  var finishHTML=buildFinishHTML({allowMinimize:true});
  return `<div class="sum-view" id="summaryViewTop">${finishHTML}${buildReviewSheetHTML(false)}</div>`;
}
function scrollQuizViewportTop(){
  window.scrollTo({top:0,behavior:'smooth'});
  var nbScroller=document.querySelector('.nb-question-scroll');
  if(nbScroller)nbScroller.scrollTo({top:0,behavior:'smooth'});
}
function scrollNbmeRail(direction){
  var scroller=document.getElementById('nbRailScroll');
  if(!scroller)return;
  scroller.scrollBy({top:direction*180,behavior:'smooth'});
}
function syncNbmeRailArrows(){
  var scroller=document.getElementById('nbRailScroll');
  var upBtn=document.getElementById('nbRailUpBtn');
  var downBtn=document.getElementById('nbRailDownBtn');
  if(!scroller||!upBtn||!downBtn)return;
  var maxScroll=Math.max(0,scroller.scrollHeight-scroller.clientHeight);
  var hasOverflow=maxScroll>4;
  upBtn.style.visibility=hasOverflow?'visible':'hidden';
  downBtn.style.visibility=hasOverflow?'visible':'hidden';
  upBtn.disabled=!hasOverflow||scroller.scrollTop<=2;
  downBtn.disabled=!hasOverflow||scroller.scrollTop>=maxScroll-2;
}
function keepCurrentRailItemVisible(){
  var scroller=document.getElementById('nbRailScroll');
  if(!scroller)return;
  var current=scroller.querySelector('.nb-rail-btn.current');
  if(current)current.scrollIntoView({block:'nearest'});
}
function toggleSummaryPanel(){
  if(!isQuizComplete())return;
  if(summaryVisible)hideSummarySheet();
  else viewSummarySheet();
}
function viewSummarySheet(){
  if(!isQuizComplete())return;
  finishBannerMinimized=false;
  summaryVisible=true;
  renderQ();
  var target=document.getElementById(uiMode==='nbme'?'summaryViewTop':'summarySheet');
  if(!target)return;
  target.scrollIntoView({behavior:'smooth',block:'start'});
}
function hideSummarySheet(){
  if(!summaryVisible)return;
  summaryVisible=false;
  renderQ();
  scrollQuizViewportTop();
}
function minimizeFinishBanner(){
  if(finishBannerMinimized)return;
  finishBannerMinimized=true;
  renderQ();
}
function expandFinishBanner(){
  if(!finishBannerMinimized)return;
  finishBannerMinimized=false;
  renderQ();
}
function toggleFinishBanner(){
  finishBannerMinimized=!finishBannerMinimized;
  renderQ();
}
function buildFinishHTML(options){
  options=options||{};
  var allowMinimize=!!options.allowMinimize;
  var total=questions.length||1;
  var pct=Math.round(NC/total*100);
  var msg=pct>=80?'🎉 Strong work!':pct>=60?'📈 Getting there.':'📚 Keep reviewing.';
  var summaryBtn=summaryVisible
    ? '<button class="fin-btn" onclick="hideSummarySheet()">← Back to Questions</button>'
    : '<button class="fin-btn" onclick="viewSummarySheet()">📋 View Summary</button>';
  var toggleBtn=allowMinimize?`<button class="fin-toggle" type="button" aria-label="${finishBannerMinimized?'Expand score card':'Minimize score card'}" title="${finishBannerMinimized?'Expand':'Minimize'}" onclick="toggleFinishBanner()">${finishBannerMinimized?'+':'−'}</button>`:'';
  var mainHTML=finishBannerMinimized?'':`<div class="fin-main">
    <div class="fin-pct">${pct}%</div>
    <div class="fin-pct-lbl">Final Score</div>
    <div class="fin-msg">${msg}</div>
    <div class="fin-sub">${NC} correct · ${NI} incorrect · ${questions.length} questions</div>
  </div>`;
  return `<div class="fin${finishBannerMinimized?' min':''}">
    ${toggleBtn}
    ${mainHTML}
    <div class="fin-btns">
      ${summaryBtn}
      <button class="fin-btn" onclick="printSummarySheet()">🖨 Print Summary</button>
      <button class="fin-btn" onclick="resetQuiz()">↺ Retake</button>
      <button class="fin-btn" onclick="exitQuiz()">✕ Exit</button>
    </div>
  </div>`;
}
function renderFinishBanners(){
  var html=isQuizComplete()?buildFinishHTML({allowMinimize:true}):'';
  document.getElementById('finBanner').innerHTML=html;
  document.getElementById('nbFinishBanner').innerHTML='';
}

// ── RENDERING ──
function renderItemSelectors(){
  var options=questions.map(function(_,i){return `<option value="${i}">${i+1}</option>`;}).join('');
  document.getElementById('nbItemSelect').innerHTML=options;
}
function syncModeButtons(){
  document.getElementById('modeLearn').classList.toggle('active',quizMode==='learn');
  document.getElementById('modeExam').classList.toggle('active',quizMode==='exam');
  document.getElementById('nbModeLearn').classList.toggle('active',quizMode==='learn');
  document.getElementById('nbModeExam').classList.toggle('active',quizMode==='exam');
  document.getElementById('qtSubmitBtn').style.display=quizMode==='exam'&&!examSubmitted?'':'none';
  var endBtn=document.getElementById('nbReviewBtn');
  if(quizMode!=='exam'){
    endBtn.textContent='Testing Mode Only';
    endBtn.disabled=true;
  }else if(examSubmitted){
    endBtn.textContent='Exam Submitted';
    endBtn.disabled=true;
  }else{
    endBtn.textContent=reviewOpen?'Submit Exam':'Review / End Block';
    endBtn.disabled=false;
  }
}
function syncSummaryButtons(){
  var btn=document.getElementById('nbSummaryBtn');
  if(!btn)return;
  var complete=isQuizComplete();
  btn.disabled=!complete;
  btn.classList.toggle('active',complete&&summaryVisible);
  btn.textContent=complete?(summaryVisible?'Hide Summary':'See Score & Summary'):'See Score & Summary';
}
function syncToolButtons(){
  document.getElementById('hlTool').classList.toggle('active',toolMode==='hl');
  document.getElementById('stTool').classList.toggle('active',toolMode==='st');
  document.getElementById('nbHighlightBtn').classList.toggle('active',toolMode==='hl');
  document.getElementById('nbHighlightBtn').classList.toggle('hl',toolMode==='hl');
  document.getElementById('nbStrikeBtn').classList.toggle('active',toolMode==='st');
  document.getElementById('nbStrikeBtn').classList.toggle('st',toolMode==='st');
}
function syncMarkButtons(){
  var isMarked=!!marked[CQ];
  document.getElementById('qtMarkBtn').classList.toggle('active',isMarked);
  document.getElementById('qtMarkBtn').textContent=isMarked?'⚑ Marked':'⚑ Mark';
  document.getElementById('nbMarkBtn').classList.toggle('active',isMarked);
  document.getElementById('nbMarkBtn').textContent=isMarked?'⚑ Marked':'⚑ Mark';
}
function updScore(){
  document.getElementById('sC').textContent=NC;
  document.getElementById('sI').textContent=NI;
  document.getElementById('sP').textContent=getScorePercent()==='—'?'—':getScorePercent()+'%';
  document.getElementById('nbScoreCorrect').textContent=NC;
  document.getElementById('nbScoreIncorrect').textContent=NI;
  document.getElementById('nbScorePercent').textContent=getScorePercent()==='—'?'—':getScorePercent()+'%';
}
function buildExplanationHTML(q,ans){
  if(!ans)return '';
  var correctLetter=choiceLetter(q.correct);
  var selectedLetter=(ans.s!==null&&ans.s!==undefined)?choiceLetter(ans.s):'';
  var myWrong='';
  if(ans.s===null){
    myWrong='<div class="exs exw"><div class="exl">✗ No Answer Selected</div><div class="ext">This question was left unanswered before the quiz was submitted.</div></div>';
  }else if(ans.s!==q.correct&&q.wrongExplanations&&q.wrongExplanations[String(ans.s)]){
    myWrong=`<div class="exs exw"><div class="exl">✗ Why ${selectedLetter} is Wrong</div><div class="ext">${q.wrongExplanations[String(ans.s)]}</div></div>`;
  }
  var others='';
  if(q.wrongExplanations){
    var otherKeys=Object.keys(q.wrongExplanations).filter(function(key){
      return +key!==q.correct&&(ans.s===null||+key!==ans.s)&&q.wrongExplanations[key];
    }).sort(function(a,b){return Number(a)-Number(b);});
    if(otherKeys.length){
      others=`<div class="exs exo"><div class="exl">✗ Other Wrong Choices</div><div class="ext">${otherKeys.map(function(key){
        return `<div class="wce"><strong>${choiceLetter(+key)}:</strong> ${q.wrongExplanations[key]}</div>`;
      }).join('')}</div></div>`;
    }
  }
  var eli5=q.eli5?`<div class="exs exe"><div class="exl">💡 ELI5</div><div class="ext">${q.eli5}</div></div>`:'';
  return `<div class="exb vis">
    <div class="exs exc"><div class="exl">✓ Why ${correctLetter} is Correct</div><div class="ext">${q.explanation}</div></div>
    ${myWrong}${others}${eli5}
  </div>`;
}
function buildClassicDots(){
  return questions.map(function(_,i){
    var classes=['qd'];
    if(i===CQ)classes.push('on');
    if(answers[i])classes.push(answers[i].r==='c'?'dc':'di');
    else if(selected[i]!==undefined)classes.push('asel');
    if(marked[i])classes.push('mk');
    return `<button class="${classes.join(' ')}" onclick="goQ(${i})" title="Q${i+1}"></button>`;
  }).join('');
}
function buildClassicQuestion(){
  var q=questions[CQ];
  var total=questions.length;
  var ans=answers[CQ];
  var sel=getSelectedChoice(CQ);
  var isExam=quizMode==='exam';
  var progress=((CQ+1)/total*100).toFixed(1);
  var choicesHTML=q.choices.map(function(choice,ci){
    var classes=['ac'];
    if(ans){
      classes.push('dis');
      if(ci===q.correct)classes.push('cor');
      else if(ans.s!==null&&ci===ans.s)classes.push('inc');
    }else if(sel===ci){
      classes.push('sel');
    }
    return `<div class="${classes.join(' ')}" onclick="pick(${ci})">
      <div class="cl">${choiceLetter(ci)}</div>
      <div class="ac-txt" data-choice-html="${ci}">${getChoiceHTML(CQ,ci)}</div>
    </div>`;
  }).join('');
  var submitLabel=isExam?'Submit Question':'Submit Answer';
  var submitHTML=!ans?`<div class="submit-row"><button class="submit-btn" onclick="submitAns()"${sel!==undefined?'':' disabled'}>${submitLabel}</button></div>`:'';
  var feedbackHTML=ans?buildExplanationHTML(q,ans):'';
  var qnumClass='qnum'+(marked[CQ]?' marked':'');
  var qnumText=`Question ${CQ+1} of ${total}${marked[CQ]?' • Flagged':''}`;
  var mainHTML=`<div class="q-main">
      <div class="${qnumClass}">${qnumText}</div>
      <div class="qstem" id="stemEl" data-stem-html="1">${getStemHTMLForDisplay(CQ)}</div>${buildVhLegendHTML(CQ)}
      <div class="ach" id="achEl">${choicesHTML}</div>
      ${submitHTML}
    </div>`;
  var layoutHTML=ans
    ? `<div class="q-review-grid has-feedback">${mainHTML}<aside class="q-feedback">${feedbackHTML}</aside></div>`
    : `<div class="q-review-grid">${mainHTML}</div>`;
  return `<div class="qcd">
    <div class="qpg"><div class="qpf" style="width:${progress}%"></div></div>
    <div class="qbd">
      ${layoutHTML}
    </div>
    <div class="qnv">
      <button class="nb" onclick="prevQ()"${CQ===0?' disabled':''}>← Prev</button>
      <div class="nav-dots">${buildClassicDots()}</div>
      <button class="nb pr" onclick="nextQ()"${CQ===total-1?' disabled':''}>Next →</button>
    </div>
  </div>`;
}
function buildNbmeRail(){
  return questions.map(function(_,i){
    var classes=['nb-rail-btn'];
    if(i===CQ&&!reviewOpen)classes.push('current');
    if(answers[i]||selected[i]!==undefined)classes.push('answered');
    if(answers[i]&&answers[i].r&&answers[i].r!=='c'&&answers[i].r!=='u')classes.push('incorrect');
    if(marked[i])classes.push('marked');
    return `<button class="${classes.join(' ')}" type="button" onclick="goQ(${i})" aria-label="Go to question ${i+1}">${i+1}</button>`;
  }).join('');
}
function buildNbmeQuestion(){
  var q=questions[CQ];
  var ans=answers[CQ];
  var sel=getSelectedChoice(CQ);
  var isExam=quizMode==='exam';
  var submitLabel=isExam?'Submit Question':'Submit Answer';
  var answersHTML=q.choices.map(function(choice,ci){
    var classes=['nb-answer-row'];
    if(ans)classes.push('locked');
    if(sel===ci)classes.push('selected');
    if(ans){
      if(ci===q.correct)classes.push('correct');
      else if(ans.s!==null&&ci===ans.s)classes.push('incorrect');
    }
    return `<div class="${classes.join(' ')}" onclick="pick(${ci})">
      <div class="nb-answer-glyph">${choiceLetter(ci)}</div>
      <div class="nb-answer-copy"><span data-choice-html="${ci}">${getChoiceHTML(CQ,ci)}</span></div>
    </div>`;
  }).join('');
  var submitHTML=!ans?`<div class="nb-submit-row"><button class="nb-submit-btn" onclick="submitAns()"${sel!==undefined?'':' disabled'}>${submitLabel}</button></div>`:'';
  var feedbackHTML=ans?buildExplanationHTML(q,ans):'';
  var mainHTML=`<div class="nb-question-main">
    <div class="nb-question-label">QUESTION ${CQ+1}</div>
    <div class="nb-question-stem" id="nbStemEl" data-stem-html="1">${getStemHTMLForDisplay(CQ)}</div>${buildVhLegendHTML(CQ)}
    <div class="nb-answers">${answersHTML}</div>
    ${submitHTML}
  </div>`;
  var layoutClass=ans?'nb-question-layout has-feedback':'nb-question-layout';
  var sideHTML=ans?`<aside class="nb-question-side">${feedbackHTML}</aside>`:'';
  return `<div class="nb-question-card${ans?' has-feedback':''}">
    <div class="${layoutClass}">
      ${mainHTML}
      ${sideHTML}
    </div>
  </div>`;
}
function buildNbmeReview(){
  var answered=Object.keys(selected).length;
  var incomplete=questions.length-answered;
  var flagged=getMarkedCount();
  var rows=questions.map(function(q,i){
    var answer=selected[i]===undefined?'—':choiceLetter(selected[i]);
    return `<tr>
      <td><button class="nb-review-jump" type="button" onclick="goQ(${i})">${i+1}</button></td>
      <td>${selected[i]===undefined?'Incomplete':'Answered'}</td>
      <td>${answer}</td>
      <td>${marked[i]?'Yes':'No'}</td>
    </tr>`;
  }).join('');
  return `<div class="nb-review-wrap">
    <h2>Review This Block</h2>
    <p>Check your completion status before you submit the exam. Select a question number to jump back to it.</p>
    <div class="nb-review-summary">
      <div class="nb-summary-chip">Answered<strong>${answered}</strong></div>
      <div class="nb-summary-chip">Incomplete<strong>${incomplete}</strong></div>
      <div class="nb-summary-chip">Marked<strong>${flagged}</strong></div>
    </div>
    <table class="nb-review-table">
      <thead><tr><th>Question</th><th>Status</th><th>Selected Answer</th><th>Marked</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>
    <div class="nb-review-actions">
      <button class="nb-review-back" type="button" onclick="reviewOpen=false;renderQ()">Back to Questions</button>
    </div>
  </div>`;
}
function renderClassicView(){
  document.getElementById('qtSubmitBtn').style.display=quizMode==='exam'&&!examSubmitted?'':'none';
  document.getElementById('qArea').innerHTML=(isQuizComplete()&&summaryVisible)?buildReviewSheetHTML(false):buildClassicQuestion();
}
function renderNbmeView(){
  var total=questions.length;
  var answered=getAnsweredCount();
  var statusMeta;
  if(quizMode==='exam'&&!examSubmitted){
    statusMeta=answered+' answered • '+getMarkedCount()+' marked';
  }else{
    statusMeta='Correct '+NC+' • Incorrect '+NI+' • Score '+(getScorePercent()==='—'?'—':getScorePercent()+'%');
  }
  document.getElementById('nbItemIndicator').textContent=reviewOpen?'Block Review':'Question: '+(CQ+1)+' of '+total;
  document.getElementById('nbStatusMeta').textContent=statusMeta;
  document.getElementById('nbItemSelect').value=String(CQ);
  document.getElementById('nbPrevBtn').disabled=CQ===0||reviewOpen;
  document.getElementById('nbNextBtn').disabled=CQ===total-1||reviewOpen;
  document.getElementById('nbRailItems').innerHTML=buildNbmeRail();
  if(isQuizComplete()&&summaryVisible)document.getElementById('nbContent').innerHTML=buildSummaryViewHTML();
  else if(isQuizComplete())document.getElementById('nbContent').innerHTML=buildNbmeCompletionViewHTML();
  else document.getElementById('nbContent').innerHTML=(reviewOpen&&quizMode==='exam'&&!examSubmitted)?buildNbmeReview():buildNbmeQuestion();
  keepCurrentRailItemVisible();
  syncNbmeRailArrows();
}
function renderQ(){
  closeVhPanel();
  hideVhTooltip();
  hideAnnotationMenu();
  if(!questions.length)return;
  renderFinishBanners();
  syncModeButtons();
  syncSummaryButtons();
  syncToolButtons();
  syncMarkButtons();
  updScore();
  renderItemSelectors();
  if(uiMode==='nbme')renderNbmeView();
  else renderClassicView();
  syncStudyTools();
  saveSession();
}

// ── QUIZ ACTIONS ──
function pick(ci){
  if(Date.now()<suppressChoiceUntil||!window.getSelection().isCollapsed)return;
  if(answers[CQ])return;
  summaryVisible=false;
  selected[CQ]=ci;
  reviewOpen=false;
  renderQ();
}
function submitAns(){
  if(selected[CQ]===undefined||examSubmitted)return;
  if(quizMode==='exam'){
    reviewOpen=false;
    summaryVisible=false;
    if(CQ<questions.length-1){
      CQ++;
      renderQ();
      scrollQuizViewportTop();
    }else{
      renderQ();
      showToast('Last question saved. Use Review / End Block or Submit Exam when you are ready.','ok');
    }
    return;
  }
  if(answers[CQ])return;
  var ok=selected[CQ]===questions[CQ].correct;
  answers[CQ]={s:selected[CQ],r:ok?'c':'i'};
  updateScoreCounts();
  renderQ();
  if(quizMode==='learn'&&Object.keys(answers).length===questions.length)setTimeout(showFinish,300);
}
function submitExam(){
  if(quizMode!=='exam'||examSubmitted)return;
  var unanswered=questions.length-Object.keys(selected).length;
  var msg=unanswered>0?'You still have '+unanswered+' unanswered question'+(unanswered===1?'':'s')+'. Submit anyway?':'Submit your exam now?';
  if(!window.confirm(msg))return;
  answers={};
  NC=0;
  NI=0;
  questions.forEach(function(q,idx){
    if(selected[idx]===undefined){
      answers[idx]={s:null,r:'u'};
      NI++;
    }else{
      var ok=selected[idx]===q.correct;
      answers[idx]={s:selected[idx],r:ok?'c':'i'};
      if(ok)NC++;else NI++;
    }
  });
  examSubmitted=true;
  reviewOpen=false;
  toolMode='';
  renderQ();
  showFinish();
  showToast('Exam submitted.','ok');
}
function handleNbmeEndAction(){
  if(quizMode!=='exam'||examSubmitted)return;
  if(reviewOpen)submitExam();
  else{
    reviewOpen=true;
    renderQ();
  }
}
function prevQ(){if(CQ>0){CQ--;reviewOpen=false;summaryVisible=false;renderQ();}}
function nextQ(){if(CQ<questions.length-1){CQ++;reviewOpen=false;summaryVisible=false;renderQ();}}
function goQ(i){
  if(i<0||i>=questions.length)return;
  CQ=i;
  reviewOpen=false;
  summaryVisible=false;
  renderQ();
}
function toggleMark(){
  if(!questions.length)return;
  summaryVisible=false;
  if(marked[CQ])delete marked[CQ];
  else marked[CQ]=true;
  renderQ();
}
function setMode(mode){
  if(mode===quizMode)return;
  var hasProgress=Object.keys(selected).length>0||Object.keys(answers).length>0||examSubmitted;
  if(hasProgress&&!window.confirm('Switching modes will reset your current quiz progress. Continue?')){
    syncModeButtons();
    return;
  }
  quizMode=mode;
  resetQuizState(false);
  renderQ();
  showToast(mode==='learn'?'Learning mode enabled.':'Testing mode enabled.','ok');
}

// ── TOOLS ──
function toggleTool(mode){
  hideAnnotationMenu();
  toolMode=toolMode===mode?'':mode;
  syncToolButtons();
}
function getCurrentAnnotationRoot(){
  return document.querySelector(uiMode==='nbme'?'#nbContent':'#qArea');
}
function persistCurrentAnnotationsFromDOM(){
  var root=getCurrentAnnotationRoot();
  if(!root)return;
  var stem=root.querySelector('[data-stem-html]');
  if(stem)stemMarkup[CQ]=stripVhMarks(stem.innerHTML);
  var nodes=root.querySelectorAll('[data-choice-html]');
  if(nodes.length){
    var arr=ensureChoiceMarkup(CQ);
    nodes.forEach(function(node){
      arr[Number(node.getAttribute('data-choice-html'))]=node.innerHTML;
    });
  }
}
function stripAnnotationTags(html){
  var wrap=document.createElement('div');
  wrap.innerHTML=html;
  wrap.querySelectorAll('mark,s').forEach(function(node){
    node.replaceWith(document.createTextNode(node.textContent));
  });
  return wrap.innerHTML;
}
function clearMarks(){
  if(!questions.length)return;
  stemMarkup[CQ]=stripAnnotationTags(getStemHTML(CQ));
  var cleaned=[];
  questions[CQ].choices.forEach(function(_,idx){
    cleaned[idx]=stripAnnotationTags(getChoiceHTML(CQ,idx));
  });
  choiceMarkup[CQ]=cleaned;
  renderQ();
  showToast('Annotations cleared.','ok');
}
function applyFontSize(){
  var root=document.documentElement;
  var viewportScale=parseFloat(getComputedStyle(root).getPropertyValue('--viewport-scale'))||1;
  var stemBase=25*viewportScale;
  var choiceBase=15.5*viewportScale;
  var stemSize=stemBase+(fontStep*2.5*viewportScale);
  var choiceSize=choiceBase+(fontStep*1.2*viewportScale);
  root.style.setProperty('--stem-size',stemSize.toFixed(1)+'px');
  root.style.setProperty('--choice-size',choiceSize.toFixed(1)+'px');
}
function adjustFontSize(delta){
  fontStep=Math.max(-2,Math.min(4,fontStep+delta));
  applyFontSize();
}
function resetFontSize(){
  fontStep=0;
  applyFontSize();
}
function selectionIntersectsNode(range,node){
  if(typeof range.intersectsNode==='function'){
    try{return range.intersectsNode(node);}catch(e){}
  }
  var nodeRange=document.createRange();
  nodeRange.selectNodeContents(node);
  return !(
    range.compareBoundaryPoints(Range.END_TO_START,nodeRange)<=0||
    range.compareBoundaryPoints(Range.START_TO_END,nodeRange)>=0
  );
}
function getScopedAnnotationSegments(range,root){
  return Array.from(root.querySelectorAll('[data-stem-html],[data-choice-html]')).map(function(scope){
    if(!selectionIntersectsNode(range,scope))return null;
    var scopedRange=document.createRange();
    scopedRange.selectNodeContents(scope);
    if(range.compareBoundaryPoints(Range.START_TO_START,scopedRange)>0){
      scopedRange.setStart(range.startContainer,range.startOffset);
    }
    if(range.compareBoundaryPoints(Range.END_TO_END,scopedRange)<0){
      scopedRange.setEnd(range.endContainer,range.endOffset);
    }
    if(scopedRange.collapsed)return null;
    return {scope:scope,range:scopedRange};
  }).filter(Boolean);
}
function collectTextNodesInRange(range,scope){
  var nodes=[];
  var walker=document.createTreeWalker(scope,NodeFilter.SHOW_TEXT,{
    acceptNode:function(node){
      if(!node.textContent)return NodeFilter.FILTER_REJECT;
      return selectionIntersectsNode(range,node)?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT;
    }
  });
  var current;
  while((current=walker.nextNode()))nodes.push(current);
  return nodes;
}
function wrapSelectedTextNode(node,range,mode){
  var start=0;
  var end=node.textContent.length;
  if(node===range.startContainer&&range.startContainer.nodeType===Node.TEXT_NODE)start=range.startOffset;
  if(node===range.endContainer&&range.endContainer.nodeType===Node.TEXT_NODE)end=range.endOffset;
  if(start>=end)return 0;
  if(start>0){
    node=node.splitText(start);
    end-=start;
  }
  if(end<node.textContent.length)node.splitText(end);
  var wrapper=document.createElement(mode==='hl'?'mark':'s');
  if(mode==='hl')wrapper.style.setProperty('--mark-color',highlightColor);
  node.parentNode.insertBefore(wrapper,node);
  wrapper.appendChild(node);
  return 1;
}
function normalizeAnnotationWrappers(scope,tagName){
  Array.from(scope.querySelectorAll(tagName)).forEach(function(node){
    while(node.nextSibling&&node.nextSibling.nodeType===Node.ELEMENT_NODE&&node.nextSibling.tagName===node.tagName&&node.nextSibling.getAttribute('style')===node.getAttribute('style')){
      var sibling=node.nextSibling;
      while(sibling.firstChild)node.appendChild(sibling.firstChild);
      sibling.remove();
    }
  });
}
function applyTextAnnotation(range,root,mode){
  var applied=0;
  getScopedAnnotationSegments(range,root).forEach(function(segment){
    collectTextNodesInRange(segment.range,segment.scope).forEach(function(node){
      applied+=wrapSelectedTextNode(node,segment.range,mode);
    });
    if(applied){
      normalizeAnnotationWrappers(segment.scope,mode==='hl'?'MARK':'S');
    }
  });
  return applied>0;
}
// Keep the selected range while the floating palette receives a click or keyboard focus.
var annotationMenu=document.createElement('div');
annotationMenu.className='annotation-menu';
annotationMenu.hidden=true;
annotationMenu.setAttribute('role','toolbar');
annotationMenu.setAttribute('aria-label','Text annotations');
var annotationColors=[['Yellow','#fff173'],['Green','#b1ff66'],['Cyan','#83edf0'],['Pink','#ffb5d7']];
annotationColors.forEach(function(color){
  var button=document.createElement('button');
  button.type='button';
  button.className='annotation-swatch';
  button.style.background=color[1];
  button.setAttribute('aria-label',color[0]+' highlight');
  button.title=color[0]+' highlight';
  button.onclick=function(){
    highlightColor=color[1];
    document.documentElement.style.setProperty('--active-highlight',highlightColor);
    if(annotationRange)commitAnnotation('hl');
    else hideAnnotationMenu();
  };
  annotationMenu.appendChild(button);
});
var annotationStrike=document.createElement('button');
annotationStrike.type='button';
annotationStrike.className='annotation-strike';
annotationStrike.textContent='S';
annotationStrike.title='Strikeout';
annotationStrike.setAttribute('aria-label','Strikeout selected text');
annotationStrike.onclick=function(){commitAnnotation('st');};
annotationMenu.appendChild(annotationStrike);
document.body.appendChild(annotationMenu);
annotationMenu.addEventListener('pointerdown',function(event){event.preventDefault();});
function hideAnnotationMenu(){
  annotationMenu.hidden=true;
  annotationRange=null;
  annotationRoot=null;
}
function positionAnnotationMenu(rect){
  annotationMenu.hidden=false;
  annotationMenu.querySelectorAll('.annotation-swatch').forEach(function(button,index){
    button.setAttribute('aria-pressed',String(annotationColors[index][1]===highlightColor));
  });
  var width=annotationMenu.offsetWidth,height=annotationMenu.offsetHeight;
  annotationMenu.style.left=Math.max(8,Math.min(rect.left,window.innerWidth-width-8))+'px';
  var top=rect.bottom+8;
  if(top+height>window.innerHeight-8)top=rect.top-height-8;
  annotationMenu.style.top=Math.max(8,Math.min(top,window.innerHeight-height-8))+'px';
}
function commitAnnotation(mode){
  var range=annotationRange,root=annotationRoot;
  if(!range||!root||!root.isConnected||!root.contains(range.commonAncestorContainer)){
    hideAnnotationMenu();return;
  }
  if(applyTextAnnotation(range,root,mode)){
    suppressChoiceUntil=Date.now()+250;
    window.getSelection().removeAllRanges();
    persistCurrentAnnotationsFromDOM();
    saveSession();
  }
  hideAnnotationMenu();
}
['hlTool','nbHighlightBtn'].forEach(function(id){
  var button=document.createElement('button');
  button.type='button';
  button.className='highlight-color-button';
  button.title='Choose highlight color';
  button.setAttribute('aria-label','Choose highlight color');
  button.onclick=function(){
    var wasOpen=!annotationMenu.hidden;
    hideAnnotationMenu();
    if(wasOpen)return;
    annotationStrike.hidden=true;
    positionAnnotationMenu(button.getBoundingClientRect());
  };
  document.getElementById(id).after(button);
});
function handleAnnotationSelection(event){
  if(annotationMenu.contains(event.target)||!questions.length)return;
  var selection=window.getSelection();
  if(!selection||selection.isCollapsed||!selection.rangeCount)return;
  var range=selection.getRangeAt(0),root=getCurrentAnnotationRoot();
  if(!root||!root.contains(range.commonAncestorContainer)||!getScopedAnnotationSegments(range,root).length)return;
  annotationRange=range.cloneRange();
  annotationRoot=root;
  suppressChoiceUntil=Date.now()+250;
  if(toolMode)commitAnnotation(toolMode);
  else{
    annotationStrike.hidden=false;
    positionAnnotationMenu(range.getBoundingClientRect());
  }
}
document.addEventListener('pointerup',handleAnnotationSelection);
document.addEventListener('keyup',function(event){
  if(event.key==='Escape'){hideAnnotationMenu();return;}
  if(event.key==='Shift'||event.key.startsWith('Arrow'))handleAnnotationSelection(event);
});
document.addEventListener('pointerdown',function(event){
  if(!annotationMenu.contains(event.target)&&!event.target.closest('.highlight-color-button'))hideAnnotationMenu();
});
document.addEventListener('scroll',hideAnnotationMenu,true);
window.addEventListener('resize',hideAnnotationMenu);

// ── TIMER ──
function formatTimer(totalSeconds){
  var hours=Math.floor(totalSeconds/3600);
  var minutes=Math.floor((totalSeconds%3600)/60);
  var seconds=totalSeconds%60;
  if(hours>0)return hours+':'+String(minutes).padStart(2,'0')+':'+String(seconds).padStart(2,'0');
  return String(minutes).padStart(2,'0')+':'+String(seconds).padStart(2,'0');
}
function toggleTimer(){
  if(timerRunning)pauseTimer();
  else startTimer();
}
function startTimer(){
  if(timerRunning)return;
  timerRunning=true;
  clearInterval(timerInterval);
  timerInterval=setInterval(function(){
    timerSec++;
    updTimer();
  },1000);
  updTimer();
}
function pauseTimer(){
  timerRunning=false;
  clearInterval(timerInterval);
  updTimer();
}
function resetTimer(){
  pauseTimer();
  timerSec=0;
  timerExpiredHandled=false;
  updTimer();
}
var timerDisplayMode='elapsed'; // 'elapsed' | 'remaining'
var timerExpiredHandled=false;
var SECONDS_PER_QUESTION=90; // NBME budget: 1 min 30 s per item
function getBlockSeconds(){return Math.max(60,(questions.length||0)*SECONDS_PER_QUESTION);}
function getRemainingSeconds(){return Math.max(0,getBlockSeconds()-timerSec);}
function toggleTimerDisplay(){
  timerDisplayMode=timerDisplayMode==='elapsed'?'remaining':'elapsed';
  updTimer();
  saveSession();
  if(timerDisplayMode==='remaining')showToast('Time Remaining · '+formatTimer(getBlockSeconds())+' block ('+SECONDS_PER_QUESTION+' s per question, NBME pacing)','ok');
}
function updTimer(){
  var remaining=getRemainingSeconds();
  var showRemaining=timerDisplayMode==='remaining';
  var timeText=formatTimer(showRemaining?remaining:timerSec);
  document.getElementById('timerTime').textContent=timeText;
  document.getElementById('nbTimerTime').textContent=timeText;
  var modeLbl=document.getElementById('timerModeLbl');
  if(modeLbl)modeLbl.textContent=showRemaining?'TIMER · REMAINING':'TIMER · ELAPSED';
  var nbModeLbl=document.getElementById('nbTimerModeLbl');
  if(nbModeLbl)nbModeLbl.textContent=showRemaining?'Time Remaining:':'Elapsed Time:';
  var nbNote=document.getElementById('nbTimerNote');
  if(nbNote)nbNote.textContent=showRemaining?('Block: '+formatTimer(getBlockSeconds())+' · '+SECONDS_PER_QUESTION+' s/question'):'Same timer as the original interface';
  document.getElementById('timerPlayBtn').textContent=timerRunning?'⏸':'▶';
  document.getElementById('nbTimerToggle').textContent=timerRunning?'Pause':'Start';
  document.getElementById('nbTimerStatus').textContent=timerRunning?'Running':'Paused';
  document.getElementById('timerCard').classList.toggle('run',timerRunning);
  document.getElementById('nbTimerCard').classList.toggle('run',timerRunning);
  var warn=showRemaining?(remaining<=300&&remaining>0):timerSec>90;
  document.getElementById('timerCard').classList.toggle('warn',warn);
  document.getElementById('nbTimerCard').classList.toggle('warn',warn);
  var expired=showRemaining&&remaining===0&&questions.length>0;
  document.getElementById('timerCard').classList.toggle('expired',expired);
  document.getElementById('nbTimerCard').classList.toggle('expired',expired);
  if(expired&&!timerExpiredHandled&&timerRunning){
    timerExpiredHandled=true;
    pauseTimer();
    if(quizMode==='exam'&&!examSubmitted){
      reviewOpen=true;
      renderQ();
      showToast('Block time expired — review your answers and End Block.','err');
    }else{
      showToast('Block time expired.','err');
    }
  }
  if(timerRunning&&timerSec%5===0)saveSession();
}

// ── FINISH / RESET ──
function showFinish(){
  summaryVisible=false;
  renderQ();
  scrollQuizViewportTop();
}
function resetQuiz(){
  if(!questions.length)return;
  clearSession();
  questions=randomizeQuestionsForSession(questionBank.length?questionBank:questions);
  resetQuizState(true);
  renderQ();
  scrollQuizViewportTop();
  showToast('Answer choices reshuffled for a fresh attempt.','ok');
}
function exitQuiz(){
  pauseTimer();
  reviewOpen=false;
  switchView('viewSetup');
}

// ── VIEW ──
function syncViewportSize(){
  var root=document.documentElement;
  var width=window.innerWidth||1280;
  var height=window.innerHeight||800;
  var widthNormalized=(Math.min(Math.max(width,1200),1800)-1200)/600;
  var heightNormalized=(Math.min(Math.max(height,760),1200)-760)/440;
  var viewportScale=Math.max(.94,Math.min(1.24,1+(widthNormalized*.18)+(heightNormalized*.06)));
  // extra ramp for very large displays (4K monitors, TVs viewed from a distance)
  if(width>1800){
    var bigNormalized=(Math.min(width,3840)-1800)/2040;
    viewportScale=Math.min(1.62,viewportScale+bigNormalized*.38);
  }
  root.style.setProperty('--app-vh',height+'px');
  root.style.setProperty('--app-vw',width+'px');
  root.style.setProperty('--viewport-scale',viewportScale.toFixed(3));
  root.style.setProperty('--ui-title-size',(26*viewportScale).toFixed(1)+'px');
  root.style.setProperty('--ui-control-size',(13*viewportScale).toFixed(1)+'px');
  root.style.setProperty('--ui-meta-size',(12*viewportScale).toFixed(1)+'px');
  root.style.setProperty('--ui-micro-size',(10*viewportScale).toFixed(1)+'px');
  applyFontSize();
}
function switchView(id){
  document.querySelectorAll('.view').forEach(function(view){view.classList.remove('active');});
  document.getElementById(id).classList.add('active');
  document.body.classList.toggle('nbme-lock',id==='viewQuizNbme');
  if(id==='viewSetup')document.querySelectorAll('.study-window[open]').forEach(function(win){win.close();});
  syncViewportSize();
  window.scrollTo({top:0,behavior:'smooth'});
}

// ── HELPERS ──
function showErr(msg){
  var el=document.getElementById('errMsg');
  el.textContent='❌ '+msg;
  el.className='err-msg show';
}
function showToast(msg,type){
  var wrap=document.getElementById('toastWrap');
  var toast=document.createElement('div');
  toast.className='toast '+(type||'ok');
  toast.textContent=msg;
  wrap.appendChild(toast);
  setTimeout(function(){
    toast.style.animation='toastOut .28s ease forwards';
    setTimeout(function(){if(toast.parentNode)toast.parentNode.removeChild(toast);},300);
  },2800);
}
document.addEventListener('keydown',function(event){
  if(!questions.length||document.getElementById('viewSetup').classList.contains('active'))return;
  if(event.target&&typeof event.target.matches==='function'&&event.target.matches('textarea,input,select'))return;
  if(event.target.closest('.annotation-menu,.highlight-color-button'))return;
  if(event.key==='Escape'&&document.getElementById('labModal').classList.contains('open')){
    closeLabs();
    return;
  }
  if(event.key==='ArrowRight')nextQ();
  if(event.key==='ArrowLeft')prevQ();
  if(event.key==='Enter'&&!answers[CQ]&&selected[CQ]!==undefined&&!reviewOpen){event.preventDefault();submitAns();return;}
  if((event.key==='m'||event.key==='M')&&!event.metaKey&&!event.ctrlKey){toggleMark();return;}
  if(!answers[CQ]&&/^[a-iA-I]$/.test(event.key)){
    var keyChoice=event.key.toUpperCase().charCodeAt(0)-65;
    if(keyChoice<questions[CQ].choices.length)pick(keyChoice);
  }
});
window.addEventListener('resize',syncViewportSize);
window.addEventListener('orientationchange',syncViewportSize);

try{setReadingTheme(localStorage.getItem('quiz-builder-reading-theme')||'light');}catch(e){setReadingTheme('light');}
syncViewportSize();
syncLaunchUIButtons();
syncPasteSetTabs();
syncModeButtons();
syncToolButtons();
updScore();
updTimer();
applyFontSize();
initStudyWindows();
hydratePreloadedQuiz();
</script>
<div class="vh-tooltip" id="vhTooltip" role="tooltip"></div>
<div class="vh-panel" id="vhPanel" aria-hidden="true" role="dialog" aria-label="Key finding detail">
  <button class="vh-panel-close" type="button" onclick="closeVhPanel()" aria-label="Close">&times;</button>
  <div class="vh-panel-eyebrow" id="vhPanelEyebrow"></div>
  <div class="vh-panel-title" id="vhPanelTitle"></div>
  <div class="vh-panel-body" id="vhPanelBody"></div>
</div>
</body>
</html>
