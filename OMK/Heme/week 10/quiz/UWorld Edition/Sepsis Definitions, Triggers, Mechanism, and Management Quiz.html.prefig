      <label class="lbl">Paste AI responses here</label>
      <div class="field-note">Paste the AI's full copied response into Set 1. If you ask the AI to make questions in smaller groups, paste each extra group into Set 2, Set 3, or Set 4. Launch Quiz will put all filled sets together.</div>
      <div class="paste-tabs" role="tablist" aria-label="AI response sets">
        <button class="paste-tab active" id="pasteTab1" type="button" role="tab" aria-selected="true" aria-controls="pastePanel1" onclick="showPasteSetTab(1)">Set 1</button>
        <button class="paste-tab" id="pasteTab2" type="button" role="tab" aria-selected="false" aria-controls="pastePanel2" onclick="showPasteSetTab(2)">Set 2</button>
        <button class="paste-tab" id="pasteTab3" type="button" role="tab" aria-selected="false" aria-controls="pastePanel3" onclick="showPasteSetTab(3)">Set 3</button>
        <button class="paste-tab" id="pasteTab4" type="button" role="tab" aria-selected="false" aria-controls="pastePanel4" onclick="showPasteSetTab(4)">Set 4</button>
      </div>
      <div class="paste-panels">
        <div class="paste-panel active" id="pastePanel1" role="tabpanel" aria-labelledby="pasteTab1">
          <label class="lbl" for="pasteArea1">Set 1</label>
          <div class="field-note">Use this for your first AI batch.</div>
          <textarea class="ta" id="pasteArea1" placeholder="Paste AI response for Set 1…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel2" role="tabpanel" aria-labelledby="pasteTab2" hidden="">
          <label class="lbl" for="pasteArea2">Set 2</label>
          <div class="field-note">Use this for your second AI batch.</div>
          <textarea class="ta" id="pasteArea2" placeholder="Paste AI response for Set 2…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel3" role="tabpanel" aria-labelledby="pasteTab3" hidden="">
          <label class="lbl" for="pasteArea3">Set 3</label>
          <div class="field-note">Use this for your third AI batch.</div>
          <textarea class="ta" id="pasteArea3" placeholder="Paste AI response for Set 3…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel4" role="tabpanel" aria-labelledby="pasteTab4" hidden="">
          <label class="lbl" for="pasteArea4">Set 4</label>
          <div class="field-note">Use this for your fourth AI batch.</div>
          <textarea class="ta" id="pasteArea4" placeholder="Paste AI response for Set 4…" oninput="syncPasteSetTabs()"></textarea>
        </div>
      </div>
    </div>
    <div class="setup-actions">
      <button class="launch-btn" onclick="launchQuiz()">🚀 Launch Quiz</button>
      <button class="ghost-btn" onclick="downloadQuiz()">⬇ Download My Quiz</button>
    </div>
    <div class="err-msg" id="errMsg"></div>
  </div>

</div>
</div>
</div>

<!-- ══════════ QUIZ VIEW ══════════ -->
<div class="view" id="viewQuiz">
<div class="quiz-page">

  <!-- top bar -->
  <div class="qt-bar">
    <div class="qt-name" id="qtName">Quiz</div>
    <button class="qt-btn" id="qtClassicUiBtn" onclick="switchQuizUI('nbme')">⇄ NBME UI</button>
    <button class="qt-btn" id="qtMarkBtn" onclick="toggleMark()">⚑ Mark</button>
    <button class="qt-btn" id="qtSubmitBtn" onclick="submitExam()">🧾 Submit Exam</button>
    <button class="qt-btn" onclick="downloadQuiz()">⬇ Download Quiz</button>
    <button class="qt-btn" onclick="resetQuiz()">↺ Reset</button>
    <button class="qt-btn" onclick="exitQuiz()">✕ Close</button>
  </div>

  <!-- grid -->
  <div class="qin">

    <!-- LEFT SIDEBAR -->
    <div class="sidebar">

      <!-- score boxes -->
      <div class="score-panel">
        <div class="score-box correct"><div class="sv" id="sC">0</div><div class="sl">Correct</div></div>
        <div class="score-box incorrect"><div class="sv" id="sI">0</div><div class="sl">Incorrect</div></div>
        <div class="score-box"><div class="sv" id="sP">—</div><div class="sl">Score</div></div>
      </div>

      <!-- mode toggle -->
      <div class="mode-toggle">
        <button class="mode-btn active" id="modeLearn" onclick="setMode('learn')"><span class="mode-icon">📚</span>Learn Mode</button>
        <button class="mode-btn" id="modeExam" onclick="setMode('exam')"><span class="mode-icon">📝</span>Exam Mode</button>
      </div>

      <!-- timer -->
      <div class="timer-card" id="timerCard">
        <div class="timer-lbl" id="timerModeLbl" onclick="toggleTimerDisplay()" title="Click to switch between elapsed and remaining time">TIMER · ELAPSED</div>
        <div class="timer-time" id="timerTime">00:00</div>
        <button class="tbtn" id="timerPlayBtn" onclick="toggleTimer()">▶</button>
        <button class="tbtn" onclick="resetTimer()">↺</button>
      </div>

      <!-- tools -->
      <div class="tool-panel">
        <button class="q-tool hl-tool" id="hlTool" onclick="toggleTool('hl')">🖊 Highlight</button>
        <button class="q-tool st-tool" id="stTool" onclick="toggleTool('st')">✂ Strikethrough</button>
        <button class="q-tool" onclick="clearMarks()">✖ Clear Marks</button>
        <button class="q-tool lab-tool" onclick="openLabs()">🧪 Lab Values</button>
        <div class="font-tools">
          <span class="font-tools-label">Text Size</span>
          <div class="font-tools-group">
            <button class="font-btn" onclick="adjustFontSize(-1)" aria-label="Decrease question and answer text size">A-</button>
            <button class="font-btn reset" onclick="resetFontSize()" aria-label="Reset question and answer text size">A</button>
            <button class="font-btn" onclick="adjustFontSize(1)" aria-label="Increase question and answer text size">A+</button>
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT: QUESTION -->
    <div>
      <div id="finBanner"></div>
      <div id="qArea"></div>
    </div>

  </div>
</div>
</div>

<!-- ══════════ NBME / NBOME VIEW ══════════ -->
<div class="view" id="viewQuizNbme">
<div class="nb-wrap">
  <div class="nb-util">
    <div class="nb-util-name" id="nbQuizTitle">Quiz</div>
    <div class="nb-util-actions">
      <button class="nb-util-btn" onclick="toggleFullscreen()" id="nbFsBtn">⛶ Fullscreen</button>
      <button class="nb-util-btn" onclick="switchQuizUI('classic')">UNE UI</button>
      <button class="nb-util-btn" onclick="downloadQuiz()">Download</button>
      <button class="nb-util-btn" onclick="resetQuiz()">Reset</button>
      <button class="nb-util-btn" onclick="exitQuiz()">Close</button>
    </div>
  </div>

  <div class="nb-app">
    <header class="nb-header">
      <div class="nb-status-box">
        <strong id="nbItemIndicator">Question: 1 of 1</strong>
        <span id="nbStatusMeta">Answered 0 of 1</span>
      </div>

      <div class="nb-header-center">
        <button class="nb-action-btn" id="nbMarkBtn" type="button" onclick="toggleMark()">⚑ Mark</button>
        <button class="nb-action-btn" id="nbHighlightBtn" type="button" onclick="toggleTool('hl')">Highlight</button>
        <button class="nb-action-btn" id="nbStrikeBtn" type="button" onclick="toggleTool('st')">Strikeout</button>
        <button class="nb-action-btn" type="button" onclick="clearMarks()">Clear</button>
        <button class="nb-mode-pill active" id="nbModeLearn" type="button" onclick="setMode('learn')">Learn</button>
        <button class="nb-mode-pill" id="nbModeExam" type="button" onclick="setMode('exam')">Testing</button>
        <button class="nb-action-btn" id="nbSummaryBtn" type="button" onclick="toggleSummaryPanel()" disabled="">See Score &amp; Summary</button>
        <div class="nb-item-picker">
          <label for="nbItemSelect">Question</label>
          <select id="nbItemSelect" aria-label="Jump to a question" onchange="goQ(parseInt(this.value,10))"></select>
        </div>
      </div>

      <div class="nb-nav-controls">
        <button class="nb-nav-btn" id="nbPrevBtn" type="button" onclick="prevQ()">
          <span class="icon">◀</span><span>Previous</span>
        </button>
        <button class="nb-nav-btn" id="nbNextBtn" type="button" onclick="nextQ()">
          <span class="icon">▶</span><span>Next</span>
        </button>
      </div>
    </header>

    <main class="nb-body">
      <aside class="nb-rail" aria-label="Question navigator">
        <div class="nb-rail-title">Questions</div>
        <button class="nb-rail-arrow" id="nbRailUpBtn" type="button" aria-label="Scroll question list up" onclick="scrollNbmeRail(-1)">▲</button>
        <div class="nb-rail-scroll" id="nbRailScroll" onscroll="syncNbmeRailArrows()">
          <div id="nbRailItems"></div>
        </div>
        <button class="nb-rail-arrow" id="nbRailDownBtn" type="button" aria-label="Scroll question list down" onclick="scrollNbmeRail(1)">▼</button>
      </aside>

      <section class="nb-stage">
        <div id="nbFinishBanner"></div>
        <div class="nb-question-scroll">
          <div id="nbContent"></div>
        </div>
      </section>
    </main>

    <footer class="nb-footer">
      <div class="nb-timer-box" id="nbTimerCard">
        <button class="nb-timer-mode" id="nbTimerModeLbl" type="button" onclick="toggleTimerDisplay()" title="Click to switch between elapsed and remaining time">Elapsed Time:</button><strong id="nbTimerTime">00:00</strong>
        <span>Status:</span><strong id="nbTimerStatus">Paused</strong>
        <small id="nbTimerNote">Same timer as the original interface</small>
        <div class="nb-timer-actions">
          <button class="nb-timer-mini" id="nbTimerToggle" type="button" onclick="toggleTimer()">Start</button>
          <button class="nb-timer-mini" type="button" onclick="resetTimer()">Reset</button>
        </div>
      </div>

      <div class="nb-footer-center">
        <div class="nb-score-chip">
          <span>Correct <strong id="nbScoreCorrect">0</strong></span>
          <span>Incorrect <strong id="nbScoreIncorrect">0</strong></span>
          <span>Score <strong id="nbScorePercent">—</strong></span>
        </div>
        <button class="nb-footer-tool" type="button" onclick="openLabs()">▤ Lab Values</button>
        <div class="nb-font-cluster">
          <label>Text</label>
          <button class="nb-font-btn" type="button" onclick="adjustFontSize(-1)">A-</button>
          <button class="nb-font-btn" type="button" onclick="resetFontSize()">A</button>
          <button class="nb-font-btn" type="button" onclick="adjustFontSize(1)">A+</button>
        </div>
      </div>

      <div class="nb-end-wrap">
        <button class="nb-end-btn" id="nbReviewBtn" type="button" onclick="handleNbmeEndAction()">Testing Mode Only</button>
      </div>
    </footer>
  </div>
</div>
</div>

<div class="lab-modal" id="labModal" onclick="if(event.target===this)closeLabs()">
  <div class="lab-shell">
    <div class="lab-card">
      <div class="lab-header">
        <div>
          <div class="lab-kicker">Reference Table</div>
          <h2 class="lab-title">Laboratory Values</h2>
          <div class="lab-sub">Shared lab reference for both quiz interfaces, imported from the NBME-style simulator so the values stay consistent.</div>
        </div>
        <button class="lab-close" type="button" onclick="closeLabs()">Close</button>
      </div>
      <div class="lab-controls">
        <div class="lab-toggle">
          <button class="lab-toggle-btn active" id="labUnitsUs" type="button" onclick="setLabUnits('us')">U.S. Units</button>
          <button class="lab-toggle-btn" id="labUnitsSi" type="button" onclick="setLabUnits('si')">SI Units</button>
        </div>
        <div class="lab-note">Switch units without leaving the question.</div>
      </div>
      <div class="lab-body">
        <div id="labTables"></div>
      </div>
    </div>
  </div>
</div>

<script>
// ── STATE ──
var questions=[],questionBank=[],answers={},selected={},marked={},stemMarkup={},choiceMarkup={},NC=0,NI=0,CQ=0;
var quizMode='learn';
var uiMode='classic';
var examSubmitted=false;
var reviewOpen=false;
var summaryVisible=false;
var finishBannerMinimized=false;
var toolMode='';
var highlightColor='#fff173', annotationRange=null, annotationRoot=null, suppressChoiceUntil=0;
var labUnitMode='us';
var timerSec=0,timerRunning=false,timerInterval=null;
var fontStep=0;
var LETTERS=['A','B','C','D','E','F','G','H'];
var MAX_ANSWER_CHOICES=8;
var PRELOADED_QUIZ_NAME="Sepsis: Definitions, Triggers, Mechanism, and Management";
var PRELOADED_QUESTIONS_JSON="[{\"stem\":\"A 71-year-old man is admitted to the intensive care unit due to fever and confusion for the past 12 hours. Blood cultures grow Escherichia coli from a urinary source. Despite 30 mL/kg of intravenous crystalloid, his mean arterial pressure remains 58 mm Hg and norepinephrine is started. Serum lactate is 4.8 mmol/L (normal: 0.5-2.2) and has not fallen after fluid resuscitation. Creatinine has risen from 0.9 to 2.4 mg/dL, and urine output is 0.2 mL/kg/hr. Physical examination shows warm extremities with bounding pulses and mottled knees. Which of the following features distinguishes this patient's condition from sepsis without shock?\",\"choices\":[\"A. Documented bacteremia from an identified organism\",\"B. Isolation of a gram-negative rather than gram-positive organism\",\"C. Presence of acute kidney injury with rising creatinine\",\"D. Profound circulatory and cellular metabolic derangement\",\"E. Requirement for admission to an intensive care unit\"],\"correct\":3,\"explanation\":\"The three terms form strict subsets. Infection and bacteremia are risk factors, not diagnoses. Sepsis is life-threatening, time-dependent organ dysfunction caused by a dysregulated host response to infection. Septic shock is the subset of sepsis in which circulatory and cellular or metabolic abnormalities are profound enough to substantially increase mortality -> vasopressor requirement to maintain perfusion pressure despite adequate fluid resuscitation, together with a persistently elevated lactate reflecting failure of cellular oxygen utilization. Both halves matter: hypotension alone is insufficient, which is precisely why lactate sits in the definition and in the treatment bundle.\\nEducational objective: Septic shock is the subset of sepsis with circulatory and cellular metabolic abnormalities profound enough to substantially raise mortality, operationally a vasopressor requirement plus persistent lactate elevation after fluid resuscitation. Bacteremia and infection are risk factors, not diagnostic of sepsis.\",\"wrongExplanations\":{\"0\":\"Documented bacteremia is a risk factor for sepsis rather than a defining feature, and blood cultures are negative in 30%-50% of septic patients. A patient can have bacteremia without organ dysfunction and therefore without sepsis.\",\"1\":\"Gram-negative organisms are important causes, but gram-positive organisms are the most commonly identified overall and no organism defines sepsis. The Gram stain result does not determine whether shock is present.\",\"2\":\"Acute kidney injury is one form of organ dysfunction and therefore establishes sepsis, but organ dysfunction alone does not distinguish shock. Many patients with sepsis have renal injury without meeting shock criteria.\",\"4\":\"Intensive care admission reflects illness severity and is itself a listed risk factor for developing sepsis, but it is an administrative location rather than a physiologic criterion. Patients may be managed in the unit without meeting the definition of shock.\"},\"eli5\":\"Having germs in the blood is not the same as sepsis, and sepsis is not the same as septic shock. Shock means the circulation has failed badly enough that fluids alone cannot hold the blood pressure up, and the cells themselves cannot use oxygen properly. The lactate level is the clue to that second part.\"},{\"stem\":\"A 78-year-old woman is brought to the emergency department from a nursing home due to decreased responsiveness for the past 18 hours. She has type 2 diabetes mellitus and chronic kidney disease. Temperature is 35.4 C (95.7 F), blood pressure is 96/54 mm Hg, pulse is 104/min, and respirations are 24/min. Physical examination shows dry mucous membranes, a soft abdomen, and suprapubic tenderness; she opens her eyes only to voice. Laboratory studies show leukocyte count 3,200/mm3 with 14% band forms, creatinine 2.8 mg/dL, and lactate 3.4 mmol/L (normal: 0.5-2.2). Urinalysis shows pyuria with bacteriuria. A resident states that infection is unlikely because she is neither febrile nor leukocytotic. Which of the following best explains the error in that reasoning?\",\"choices\":[\"A. Bandemia alone cannot substitute for an abnormal leukocyte count\",\"B. Body temperature is unreliable in patients with renal impairment\",\"C. Hypothermia and leukopenia both satisfy systemic response criteria\",\"D. Lactate elevation is required before infection can be considered\",\"E. Nursing home residents rarely mount any inflammatory response\"],\"correct\":2,\"explanation\":\"Three of the four systemic inflammatory response categories are bidirectional. Temperature qualifies when it is either above 38 C or below 36 C, and the leukocyte criterion is met by a count above 12,000/mm3, below 4,000/mm3, or a normal count with more than 10% immature band forms -> a hypothermic, leukopenic patient with bandemia satisfies the criteria as fully as a febrile, leukocytotic one. Hypothermia in particular carries a worse prognosis, and older adults frequently present this way. Reading a low temperature and low white count as evidence against infection is a common and dangerous error.\\nEducational objective: The systemic inflammatory response criteria are bidirectional: hypothermia below 36 C and leukopenia below 4,000/mm3 qualify just as hyperthermia and leukocytosis do, and more than 10% band forms qualifies with a normal total count. Absence of fever and leukocytosis does not argue against sepsis.\",\"wrongExplanations\":{\"0\":\"More than 10% immature band forms explicitly satisfies the leukocyte criterion even when the total count is normal, so bandemia does substitute. This patient meets that criterion in addition to being frankly leukopenic.\",\"1\":\"Renal impairment does not render thermometry unreliable. The relevant point is that hypothermia is itself an abnormal response, not a measurement problem.\",\"3\":\"Lactate reflects tissue hypoperfusion and cellular metabolic failure and is part of the septic shock definition and the treatment bundle. It is not a prerequisite for recognizing infection, and this patient's lactate is in fact elevated.\",\"4\":\"Older and institutionalized patients often present atypically, with hypothermia, delirium, or falls rather than fever, but this represents a differently directed response rather than no response. Framing it as absence of response perpetuates the same error.\"},\"eli5\":\"Doctors expect a fever and a high white cell count with infection, but the criteria count abnormalities in either direction. A dangerously low temperature and a low white count are just as abnormal, and in older patients they are common. Reading them as reassuring is a serious mistake.\"},{\"stem\":\"A hospital quality improvement team is selecting a tool to identify patients with suspected infection who are at increased risk of death. They review a cohort of 4,000 admitted patients with suspected infection in whom a score was calculated at presentation. Among patients whose score was 2 or greater, in-hospital mortality was approximately 10%, compared with under 1% in those scoring below 2. The score assesses performance across neurologic, hepatic, renal, coagulation, respiratory, and cardiovascular domains, with the cardiovascular domain graded by vasopressor dose once the mean arterial pressure falls below 70 mm Hg. Which of the following scoring systems was most likely evaluated?\",\"choices\":[\"A. Modified Early Warning Score\",\"B. National Early Warning Score 2\",\"C. Quick Sequential Organ Failure Assessment\",\"D. Sequential Organ Failure Assessment\",\"E. Systemic Inflammatory Response Syndrome criteria\"],\"correct\":3,\"explanation\":\"The Sequential Organ Failure Assessment grades six organ systems, neurologic, hepatic, renal, coagulation, respiratory, and cardiovascular, each from 0 to 4, and the cardiovascular domain is scored by vasopressor requirement and dose rather than by blood pressure alone once the mean arterial pressure falls below 70 mm Hg. It is more specific and has better predictive validity than the systemic inflammatory response criteria, and a score of 2 or more corresponds to a mortality risk of approximately 10%. The word sequential is not incidental: organ failure in sepsis proceeds sequentially rather than simultaneously, which is what the instrument was built to track.\\nEducational objective: The Sequential Organ Failure Assessment scores six organ systems from 0 to 4, with the cardiovascular domain graded by vasopressor dose, and a score of 2 or more indicates roughly 10% mortality. It is more specific and has better predictive validity than the systemic inflammatory response criteria.\",\"wrongExplanations\":{\"0\":\"The Modified Early Warning Score uses five vital sign parameters, systolic blood pressure, heart rate, respiratory rate, temperature, and mental status by the AVPU scale. It is a bedside deterioration screen and does not grade organ systems.\",\"1\":\"The National Early Warning Score 2 aggregates six vital sign parameters, adding oxygen saturation to the five used by the Modified Early Warning Score. Like that score it assesses risk of deterioration from vital signs rather than organ function.\",\"2\":\"The quick Sequential Organ Failure Assessment uses only three bedside criteria, respiratory rate of 22/min or more, systolic blood pressure of 100 mm Hg or less, and altered mentation. It requires no laboratory data and grades no organ systems.\",\"4\":\"The systemic inflammatory response criteria comprise temperature, heart rate, respiratory rate, and leukocyte abnormalities. They are sensitive but non-specific, are no longer a defining criterion for sepsis, and do not assess organ function.\"},\"eli5\":\"Some sepsis scores just look at vital signs at the bedside. This one goes further and grades how well six different organs are working, including how much blood-pressure medicine is needed. Scoring two or more means roughly a one in ten chance of dying.\"},{\"stem\":\"An epidemiologic study analyzes approximately 1.7 million cases of sepsis occurring annually in the United States and classifies each by the anatomic site of the initiating infection. Cases are ascertained from administrative and microbiologic data across several hundred hospitals, and the site of origin is adjudicated by chart review. The investigators note that the ranking of sources has remained stable across the study period and correlates with the risk factor profile of the affected population, particularly the prominence of community-acquired pneumonia. Which of the following most likely represents the ranking of infection sources from most to least common in this analysis?\",\"choices\":[\"A. Abdominal, respiratory, urinary, skin and soft tissue\",\"B. Respiratory, abdominal, urinary, skin and soft tissue\",\"C. Respiratory, urinary, abdominal, skin and soft tissue\",\"D. Urinary, abdominal, respiratory, skin and soft tissue\",\"E. Urinary, respiratory, skin and soft tissue, abdominal\"],\"correct\":2,\"explanation\":\"Sepsis most commonly follows respiratory infection, then urinary, then abdominal, then head and neck and other sources including skin and gastrointestinal infection and meningitis. The primacy of the respiratory tract is the single most useful fact in this list and explains why community-acquired pneumonia appears among the named risk factors for sepsis alongside intensive care admission, age extremes, pregnancy, immunosuppressive comorbidity, and prior hospitalization. Knowing the ranking shapes empiric antimicrobial choice and the search for a source when the primary site is not immediately apparent.\\nEducational objective: Sepsis arises most often from a respiratory source, followed by urinary, abdominal, and then other sites including skin and central nervous system. This ranking explains why community-acquired pneumonia is itself a listed risk factor for sepsis.\",\"wrongExplanations\":{\"0\":\"Abdominal sources are important, are frequently polymicrobial, and often require surgical source control, but they rank third rather than first. Placing them first would misdirect the empiric search for a source.\",\"1\":\"This ordering correctly places the respiratory tract first but transposes the abdominal and urinary sites. The urinary tract is the second most common source overall.\",\"3\":\"The urinary tract is a very common source, particularly in older adults and those with instrumentation, but it is second rather than first. Respiratory infection accounts for the largest share.\",\"4\":\"This ordering both places the urinary tract first and moves skin and soft tissue above abdominal sources. Neither reflects the observed distribution.\"},\"eli5\":\"If you had to guess where a septic patient's infection started, the lungs are the best first guess, then the urinary tract, then the belly. That ranking holds steady, which is why pneumonia is itself listed as something that puts people at risk of sepsis.\"},{\"stem\":\"A 63-year-old man is admitted to the intensive care unit due to fever, hypotension, and confusion for the past 8 hours. He meets criteria for septic shock and is receiving broad-spectrum antimicrobials, fluids, and norepinephrine. Two sets of blood cultures obtained before antimicrobials, along with urine and sputum cultures, remain without growth at 72 hours, and a comprehensive viral respiratory panel is negative. He is improving clinically with a falling lactate and decreasing vasopressor requirement. The team asks whether the absence of an isolated organism should prompt reconsideration of the diagnosis. Which of the following best describes the significance of the negative cultures?\",\"choices\":[\"A. Cultures are negative in 30%-50% of sepsis cases\",\"B. Negative cultures effectively exclude bacterial sepsis\",\"C. Negative cultures indicate a viral rather than bacterial cause\",\"D. Negative cultures reflect inadequate specimen volume\",\"E. Negative cultures reflect prior antimicrobial exposure alone\",\"F. Negative cultures require immediate antimicrobial withdrawal\"],\"correct\":0,\"explanation\":\"Sepsis is defined by the host response rather than by the organism, and no organism is identified in 30%-50% of cases. Cultures may be negative because the inoculum is low, because antimicrobials were given before sampling, because the pathogen is fastidious or non-cultivable, or because the driving process is a dysregulated inflammatory response to a source that has already been partly controlled. A negative culture therefore does not refute the diagnosis and does not by itself justify stopping therapy in a patient who is responding -> antimicrobials are narrowed or de-escalated on clinical grounds and duration, guided by the trajectory and any identified source.\\nEducational objective: No organism is identified in 30%-50% of sepsis cases, because sepsis is defined by a dysregulated host response rather than by a specific pathogen. Negative cultures neither exclude the diagnosis nor justify stopping therapy in a patient who is responding clinically.\",\"wrongExplanations\":{\"1\":\"Excluding bacterial sepsis on the basis of sterile cultures would misclassify a third to half of all cases. Culture sensitivity is limited by prior antimicrobials, low-level bacteremia, and fastidious organisms.\",\"2\":\"Viral causes of sepsis are real and probably underdiagnosed, acting through damage-associated molecular patterns released from injured tissue. A negative bacterial culture provides no positive evidence of a viral cause, and this patient's respiratory viral panel was negative.\",\"3\":\"Inadequate blood volume genuinely reduces culture yield and is a real preanalytic problem. Two sets drawn before antimicrobials represent appropriate sampling, and inadequate technique cannot be inferred from a negative result alone.\",\"4\":\"Prior antimicrobial administration genuinely lowers culture yield and is one reason cultures should be drawn before the first dose. It is only one of several explanations, and cultures are negative in 30%-50% of cases even when drawn appropriately.\",\"5\":\"Stopping antimicrobials in a patient with septic shock who is improving risks relapse of an incompletely treated infection. De-escalation is guided by clinical response, source control, and a defined treatment duration rather than by culture negativity alone.\"},\"eli5\":\"Sepsis is a problem with how the body reacts, not just with the germ itself. In up to half of cases no germ is ever grown from the samples. That does not mean the diagnosis was wrong or that the antibiotics should stop.\"},{\"stem\":\"A 58-year-old man with alcohol use disorder is admitted due to fever, productive cough, and pleuritic chest pain for the past 4 days. He drinks approximately one liter of vodka daily and has had two prior admissions for alcohol withdrawal. Temperature is 39.1 C (102.4 F), blood pressure is 92/56 mm Hg, and respirations are 28/min. Physical examination shows poor dentition and dullness to percussion with bronchial breath sounds over the right upper lobe. Chest radiography shows a dense right upper lobe consolidation with a bulging horizontal fissure and early cavitation. Sputum Gram stain shows abundant neutrophils and plump gram-negative rods with a prominent clear capsule, and the sputum is thick and blood-tinged. Which of the following organisms is most likely responsible?\",\"choices\":[\"A. Haemophilus influenzae\",\"B. Klebsiella pneumoniae\",\"C. Legionella pneumophila\",\"D. Pseudomonas aeruginosa\",\"E. Streptococcus pneumoniae\"],\"correct\":1,\"explanation\":\"Klebsiella pneumoniae is the aerobic gram-negative bacillus specifically associated with pneumonia and subsequent sepsis in patients with alcohol use disorder, along with those with diabetes and aspiration risk. Its thick polysaccharide capsule produces the characteristic findings: plump encapsulated gram-negative rods on Gram stain, thick blood-tinged (currant jelly) sputum, a dense lobar consolidation that expands the lobe and bulges the fissure, and a propensity to necrosis and cavitation -> abscess formation. Because sepsis most often arises from a respiratory source, recognizing the site-specific organisms matters for empiric therapy.\\nEducational objective: Klebsiella pneumoniae causes a necrotizing lobar pneumonia in patients with alcohol use disorder and diabetes, with thick blood-tinged sputum, a bulging fissure, cavitation, and plump encapsulated gram-negative rods on Gram stain. Respiratory infection is the most common source of sepsis overall.\",\"wrongExplanations\":{\"0\":\"Haemophilus influenzae is a small pleomorphic gram-negative coccobacillus causing pneumonia and exacerbations in patients with chronic obstructive pulmonary disease. It does not produce a bulging fissure or cavitation, and its morphology differs from the plump encapsulated rods described.\",\"2\":\"Legionella pneumophila causes pneumonia with high fever, relative bradycardia, hyponatremia, and diarrhea, often after water-system exposure. It stains poorly on routine Gram stain and requires urinary antigen or specialized culture.\",\"3\":\"Pseudomonas aeruginosa causes pneumonia in patients with structural lung disease, neutropenia, ventilator exposure, or cystic fibrosis, typically with a nosocomial course. It is a slender gram-negative rod without the prominent capsule described.\",\"4\":\"Streptococcus pneumoniae is the most common cause of community-acquired pneumonia and appears as gram-positive lancet-shaped diplococci. It rarely cavitates and would not produce gram-negative rods on Gram stain.\"},\"eli5\":\"The bacteria described are fat, gram-negative, and wrapped in a thick slime coat, which makes the infected lung tissue swell so much that the dividing line in the lung bulges. This particular bug loves to attack people with heavy alcohol use, and it destroys lung tissue enough to leave holes.\"},{\"stem\":\"A 54-year-old man is admitted due to fever and lower abdominal pain for the past 3 days. He underwent sigmoid colectomy 8 days ago for diverticular disease. Temperature is 38.9 C (102 F), blood pressure is 88/52 mm Hg, and pulse is 122/min. Physical examination shows diffuse abdominal tenderness with guarding and absent bowel sounds. CT of the abdomen shows a 7-cm rim-enhancing pelvic fluid collection with locules of gas and surrounding fat stranding. Blood cultures grow Escherichia coli, and cultures from percutaneous drainage of the collection grow Escherichia coli, Bacteroides fragilis, and Enterococcus faecalis. Broad-spectrum antimicrobials with anaerobic coverage were started on admission, but he remains febrile and hypotensive 36 hours later with an unchanged lactate. Which of the following is the most important additional intervention?\",\"choices\":[\"A. Addition of an antifungal agent to the regimen\",\"B. Adequate drainage of the infected collection\",\"C. Administration of activated protein C\",\"D. Escalation to a broader antibacterial regimen\",\"E. Initiation of systemic corticosteroid therapy\"],\"correct\":1,\"explanation\":\"Antimicrobials cannot sterilize an undrained collection, in which poor penetration, low pH, and a large bacterial inoculum all reduce drug efficacy. Source control, meaning surgical removal or drainage of the infected focus when one is identified, is an explicit component of sepsis management alongside the early bundle -> without it, persistent fever, hypotension, and a non-clearing lactate are expected despite appropriate therapy. Abdominal sources are characteristically polymicrobial, and roughly 20% of sepsis cases overall involve more than one organism, with Escherichia coli, Bacteroides fragilis, enterococci, and Candida the typical abdominal isolates.\\nEducational objective: Source control by drainage or surgical removal of an infected focus is essential in sepsis and cannot be replaced by antimicrobials, which penetrate collections poorly. Abdominal sepsis is characteristically polymicrobial, and about 20% of all sepsis cases involve more than one organism.\",\"wrongExplanations\":{\"0\":\"Candida is a recognized abdominal isolate, particularly after bowel perforation or repeated operations, and empiric antifungal therapy is sometimes appropriate. It would not address the mechanical problem of an undrained collection, and no yeast has been recovered.\",\"2\":\"Activated protein C was withdrawn from the market after subsequent trials showed no mortality benefit and increased bleeding. It has no role in current sepsis management.\",\"3\":\"Broadening antibacterial coverage is reasonable when resistant organisms are suspected, but the recovered organisms are already covered by a regimen with anaerobic activity. Failure here reflects an undrained focus rather than an inadequate spectrum.\",\"4\":\"Corticosteroids are considered in septic shock refractory to fluids and vasopressors, where relative adrenal insufficiency may contribute. They are adjunctive and do not substitute for removing the infected material.\"},\"eli5\":\"Antibiotics travel through the blood, but a walled-off pocket of pus has almost no blood supply reaching inside it. So the drugs never get where they need to go. Someone has to physically drain it or the patient will not get better.\"},{\"stem\":\"An investigator studies the initial molecular event that triggers the systemic inflammatory cascade in gram-negative sepsis. Purified cell wall material from Escherichia coli is added to cultured human monocytes, and within minutes there is dimerization of a surface pattern recognition receptor, recruitment of the adaptor MyD88, activation of nuclear factor kappa B, and secretion of tumor necrosis factor alpha and interleukin-6. Monocytes from animals lacking that receptor do not respond to the same material, but they respond normally to lipoteichoic acid derived from Staphylococcus aureus. Which of the following bacterial components is most likely responsible for the observed activation?\",\"choices\":[\"A. Capsular polysaccharide\",\"B. Flagellin\",\"C. Lipopolysaccharide\",\"D. Peptidoglycan\",\"E. Unmethylated CpG DNA\"],\"correct\":2,\"explanation\":\"Pathogen-associated molecular patterns are conserved molecular signatures carried by the organism, and lipopolysaccharide is the most prominent trigger in sepsis overall. Its lipid A moiety is recognized by Toll-like receptor 4 in complex with MD-2 and CD14 -> receptor dimerization, MyD88 recruitment, nuclear factor kappa B activation, and transcription of pro-inflammatory cytokines including tumor necrosis factor alpha, interleukin-1, and interleukin-6 -> the cascade that produces endothelial dysfunction and ischemic tissue injury. Gram-positive organisms trigger the same pathways through different ligands, principally lipoteichoic acid and peptidoglycan, which is why the knockout cells in this experiment still respond to staphylococcal material.\\nEducational objective: Lipopolysaccharide is the most prominent pathogen-associated molecular pattern in sepsis and signals through Toll-like receptor 4 to activate nuclear factor kappa B and pro-inflammatory cytokine release. Gram-positive organisms act mainly through lipoteichoic acid and peptidoglycan.\",\"wrongExplanations\":{\"0\":\"Capsular polysaccharide is a major virulence factor that impairs opsonization and phagocytosis in organisms such as Streptococcus pneumoniae and Klebsiella. It promotes immune evasion rather than acting as the dominant inflammatory trigger.\",\"1\":\"Flagellin is recognized by Toll-like receptor 5 and does contribute to innate activation in motile organisms. It is not the dominant trigger in gram-negative sepsis and would not be abolished by loss of the lipopolysaccharide receptor.\",\"3\":\"Peptidoglycan is a component of both gram-positive and gram-negative walls and is sensed by NOD-like receptors and Toll-like receptor 2. In gram-positive sepsis it acts alongside lipoteichoic acid, and the experiment shows those responses remain intact.\",\"4\":\"Unmethylated CpG motifs in bacterial DNA are recognized by intracellular Toll-like receptor 9 and contribute to innate activation. Bacterial DNA is a secondary trigger rather than the principal one in gram-negative sepsis.\"},\"eli5\":\"The outer coat of certain bacteria carries a molecule that human immune cells are hardwired to recognize as danger. Detecting it flips a master switch that pours out inflammatory signals. In sepsis, that alarm is so loud and so widespread that it damages the body's own blood vessels.\"},{\"stem\":\"A 22-year-old woman is brought to the emergency department due to fever, vomiting, and a diffuse rash for the past 12 hours. She has been using high-absorbency tampons during a prolonged menstrual period. Temperature is 39.6 C (103.3 F), blood pressure is 76/40 mm Hg, and pulse is 132/min. Physical examination shows a diffuse blanching macular erythroderma resembling sunburn involving the palms and soles, conjunctival injection, and a hyperemic oropharynx. Laboratory studies show creatinine 2.6 mg/dL, alanine aminotransferase 180 U/L, platelet count 78,000/mm3, and creatine kinase 1,200 U/L. Blood cultures are negative, and vaginal culture grows Staphylococcus aureus. Which of the following best explains the mechanism of this patient's profound shock?\",\"choices\":[\"A. Complement-mediated lysis of erythrocytes and platelets\",\"B. Direct cytolysis of endothelial cells by a pore-forming toxin\",\"C. Immune complex deposition within small vessel walls\",\"D. Nonspecific bridging of class II MHC to T-cell receptors\",\"E. Proteolytic cleavage of von Willebrand factor multimers\",\"F. Teichoic acid anchoring within a thick peptidoglycan wall\"],\"correct\":3,\"explanation\":\"Toxic shock syndrome toxin 1 and the streptococcal pyrogenic exotoxins are superantigens. Rather than being processed and presented within the peptide groove, they bind the outside of class II MHC on antigen-presenting cells and simultaneously to the variable beta region of the T-cell receptor -> nonspecific activation of up to 20% of the T-cell repertoire, compared with roughly 0.01% in a conventional response -> a massive burst of interleukin-2, interferon gamma, tumor necrosis factor, and interleukin-1 -> capillary leak, vasodilation, and multiorgan dysfunction. The negative blood cultures fit: the illness is toxin mediated, not a bacteremia, which is a further illustration that sepsis reflects the host response rather than organism burden.\\nEducational objective: Superantigens such as toxic shock syndrome toxin 1 and streptococcal pyrogenic exotoxins crosslink class II MHC to the T-cell receptor beta variable region outside the antigen groove, activating a large fraction of T cells and producing a massive cytokine release with shock and multiorgan failure. Blood cultures are typically negative.\",\"wrongExplanations\":{\"0\":\"Complement-mediated lysis of blood cells occurs in paroxysmal nocturnal hemoglobinuria and in acute hemolytic transfusion reactions, producing hemoglobinemia and hemoglobinuria. This patient has no evidence of hemolysis.\",\"1\":\"Pore-forming cytolysins such as alpha-toxin and streptolysin O do damage host membranes directly and contribute to tissue necrosis. They cause local destruction rather than the systemic T-cell activation and diffuse erythroderma described here.\",\"2\":\"Immune complex deposition produces small vessel vasculitis with palpable purpura, arthralgia, and glomerulonephritis over days to weeks. The eruption here is a blanching macular erythroderma with desquamation to follow, and the tempo is hours.\",\"4\":\"Cleavage of von Willebrand factor multimers is the normal function of ADAMTS13, whose deficiency causes thrombotic thrombocytopenic purpura with schistocytes and neurologic findings. This patient's thrombocytopenia reflects consumption during a cytokine storm rather than a microangiopathy.\",\"5\":\"Lipoteichoic acid with peptidoglycan is the principal gram-positive trigger, signaling largely through Toll-like receptor 2. The experiment shows those responses remain intact in the knockout cells, so this is not the ligand being tested.\"},\"eli5\":\"Normally a T cell only wakes up if it sees the one specific germ fragment it was built to recognize, so only a tiny fraction respond. This toxin acts like a clamp that jams huge numbers of T cells on at once. The resulting flood of inflammatory signals drops the blood pressure and shuts down organs.\"},{\"stem\":\"A 61-year-old woman in the intensive care unit develops a new fever and hypotension on hospital day 18. She was admitted for necrotizing pancreatitis, has received four courses of broad-spectrum antibacterial therapy, and has had a central venous catheter and total parenteral nutrition throughout. Temperature is 38.8 C (101.8 F) and blood pressure is 84/48 mm Hg despite fluids. Physical examination shows erythema at the catheter exit site and scattered non-tender erythematous papules on the trunk. Blood cultures drawn from the catheter and peripherally grow budding yeast with pseudohyphae. Serum 1,3-beta-D-glucan is markedly elevated. Which of the following classes of molecule most likely triggered the inflammatory cascade in this patient?\",\"choices\":[\"A. Cell wall polysaccharides\",\"B. Host-derived nuclear proteins\",\"C. Lipid A-containing endotoxin\",\"D. Membrane lipoteichoic acid\",\"E. Secreted superantigen exotoxins\"],\"correct\":0,\"explanation\":\"Fungal pathogen-associated molecular patterns are polysaccharides: beta-glucans, mannans, and chitin, recognized by dectin-1 and by Toll-like receptors and the mannose receptor -> innate activation and cytokine release. Candida species account for roughly 80% of fungal sepsis and Aspergillus about 10%, with incidence rising among immunocompromised and critically ill patients; the risk profile here is classic, comprising prolonged intensive care stay, broad-spectrum antibacterial exposure, a central catheter, and parenteral nutrition. The elevated 1,3-beta-D-glucan is a direct measurement of that same cell wall polysaccharide, which is why the assay works as a fungal marker.\\nEducational objective: Fungal triggers of sepsis are cell wall polysaccharides, namely beta-glucans, mannans, and chitin, and the serum 1,3-beta-D-glucan assay measures one of them directly. Candida accounts for about 80% of fungal sepsis, with risk from prolonged intensive care stay, broad-spectrum antibacterials, catheters, and parenteral nutrition.\",\"wrongExplanations\":{\"1\":\"Host-derived molecules such as high-mobility group box 1 protein are damage-associated molecular patterns released from injured tissue, and they are the principal mechanism by which viral infection triggers sepsis. They contribute here secondarily but are not the pathogen-derived trigger.\",\"2\":\"Lipid A-containing endotoxin is the lipopolysaccharide of gram-negative bacteria and the most prominent bacterial trigger overall. Fungi have no lipopolysaccharide, and the cultures grew yeast rather than gram-negative rods.\",\"3\":\"Lipoteichoic acid, with peptidoglycan, is the principal gram-positive trigger, relevant to Staphylococcus, Enterococcus, and streptococcal sepsis. It is a bacterial cell wall component absent from fungi.\",\"4\":\"Superantigen exotoxins such as toxic shock syndrome toxin 1 and streptococcal pyrogenic exotoxin drive toxin-mediated shock through nonspecific T-cell activation. They are staphylococcal and streptococcal products, and Candida does not produce them.\"},\"eli5\":\"Fungi are wrapped in sugars rather than the fatty coats bacteria use, and the immune system has separate sensors for those sugars. A blood test can even measure one of those sugars directly. Long ICU stays, lots of antibiotics, and a central line are what let this yeast get into the bloodstream.\"},{\"stem\":\"A 34-year-old woman is admitted to the intensive care unit due to fever, myalgia, and cough that progressed to severe dyspnea over 5 days. Nasopharyngeal testing is positive for influenza A, and bacterial blood, sputum, and urine cultures are repeatedly negative with a normal procalcitonin. Temperature is 38.7 C (101.7 F), blood pressure is 86/50 mm Hg on norepinephrine, and the ratio of arterial oxygen tension to inspired oxygen fraction is 140. Chest imaging shows diffuse bilateral infiltrates. Laboratory studies show lactate 4.1 mmol/L (normal: 0.5-2.2), creatinine 2.2 mg/dL, platelet count 68,000/mm3, and markedly elevated interleukin-6. She meets criteria for septic shock. Which of the following best describes the molecular trigger of her inflammatory cascade?\",\"choices\":[\"A. Damage-associated molecular patterns from injured host tissue\",\"B. Fungal cell wall beta-glucans from an occult coinfection\",\"C. Lipopolysaccharide translocated across an ischemic gut\",\"D. Pathogen-associated molecular patterns from bacterial walls\",\"E. Superantigen-mediated polyclonal T lymphocyte activation\"],\"correct\":0,\"explanation\":\"Sepsis is defined by a dysregulated host response and is not restricted to bacterial infection. Viruses trigger it through damage-associated molecular patterns, endogenous molecules such as high-mobility group box 1 protein, mitochondrial DNA, and ATP released from cells the virus has killed -> ligation of the same innate receptors that sense microbial products -> a cascade of pro-inflammatory cytokines including interleukin-1 and interleukin-6 -> endothelial dysfunction, capillary leak, and organ failure. This is the conceptual exception in the trigger list: bacterial and fungal sepsis is driven by pathogen-derived patterns, whereas viral sepsis is driven by host-derived ones. The negative bacterial cultures with a normal procalcitonin support a non-bacterial process.\\nEducational objective: Viral sepsis is triggered by damage-associated molecular patterns released from virus-injured host tissue rather than by pathogen-associated molecular patterns, driving an interleukin-1 and interleukin-6 cascade. Bacterial and fungal sepsis is instead driven by pathogen-derived molecules such as lipopolysaccharide, lipoteichoic acid, and beta-glucans.\",\"wrongExplanations\":{\"1\":\"Fungal beta-glucans trigger sepsis in candidemia and invasive aspergillosis, typically after prolonged intensive care stay and broad-spectrum antibacterial exposure. There is no evidence of fungal infection, and the serum beta-D-glucan assay would detect it.\",\"2\":\"Gut translocation of endotoxin does occur in shock states and can amplify inflammation, but it is a secondary phenomenon rather than the initiating trigger. The primary insult here is a documented viral pneumonia.\",\"3\":\"Bacterial wall components including lipopolysaccharide, lipoteichoic acid, and peptidoglycan drive bacterial sepsis, which remains the most common form. Repeatedly negative cultures with a normal procalcitonin argue against a bacterial etiology.\",\"4\":\"Superantigens produce toxic shock syndrome through nonspecific activation of a large fraction of T cells, classically with staphylococcal or streptococcal infection and an erythrodermic rash. Influenza does not produce superantigens.\"},\"eli5\":\"Bacteria set off the alarm with molecules found on the germ itself. Viruses do it differently: they kill your cells, and the wreckage from those dead cells is what sets off the same alarm. Either way the immune system overreacts and damages organs.\"},{\"stem\":\"An investigator studies macrophage responses to intracellular bacterial products in a model of sepsis. Exposure of primed macrophages to cytoplasmic lipopolysaccharide leads to assembly of a multiprotein complex containing NLRP3 and ASC, activation of caspase-1, and cleavage of gasdermin D. The cleaved gasdermin D amino-terminal fragment inserts into the plasma membrane and oligomerizes to form pores, producing cell swelling, membrane rupture, and release of mature interleukin-1 beta and interleukin-18 into the extracellular space. Neighboring cells then upregulate adhesion molecules and cytokine transcription. Which of the following cell death pathways is being described?\",\"choices\":[\"A. Apoptosis\",\"B. Autophagy\",\"C. Ferroptosis\",\"D. Necroptosis\",\"E. Pyroptosis\"],\"correct\":4,\"explanation\":\"Persistent inflammation in sepsis produces endothelial dysfunction and ischemic tissue injury, which in turn activate several cell death pathways including necrosis, necroptosis, pyroptosis, and autophagy. Pyroptosis is the inflammasome-dependent form: caspase-1 activation within the NLRP3 inflammasome cleaves gasdermin D, whose amino-terminal fragment forms membrane pores -> osmotic swelling and lytic rupture with release of mature interleukin-1 beta and interleukin-18 -> amplification of inflammation in surrounding tissue. It is therefore intensely pro-inflammatory, in deliberate contrast to apoptosis, which is designed to avoid provoking inflammation.\\nEducational objective: Pyroptosis is inflammasome- and caspase-1-dependent lytic cell death mediated by gasdermin D pore formation, releasing interleukin-1 beta and interleukin-18 and amplifying inflammation. Sepsis activates necrosis, necroptosis, pyroptosis, and autophagy downstream of endothelial dysfunction and ischemic injury.\",\"wrongExplanations\":{\"0\":\"Apoptosis is caspase-3 and caspase-9 dependent, produces cell shrinkage, chromatin condensation, and membrane-bound apoptotic bodies cleared by phagocytes, and is characteristically non-inflammatory. Membrane rupture with cytokine release is the opposite of that pattern.\",\"1\":\"Autophagy sequesters damaged organelles and proteins within double-membrane autophagosomes for lysosomal degradation and is generally a survival mechanism under stress. It is activated in sepsis but does not involve gasdermin pores.\",\"2\":\"Ferroptosis is iron-dependent death driven by lipid peroxidation and inhibition of glutathione peroxidase 4, with no caspase involvement. It has no inflammasome or gasdermin component.\",\"3\":\"Necroptosis is a lytic, inflammatory death mediated by RIPK1, RIPK3, and MLKL, engaged when caspase-8 is inhibited. It is a genuine sibling pathway in sepsis but uses MLKL rather than gasdermin D and is caspase independent.\"},\"eli5\":\"One way cells die is quiet and tidy, and the body cleans it up without fuss. This way is the opposite: the cell punches holes in its own membrane, bursts, and sprays inflammatory signals everywhere. In sepsis that turns a local problem into a body-wide one.\"},{\"stem\":\"A 47-year-old man is in the intensive care unit on the third day of treatment for sepsis from a perforated appendix. He remains on norepinephrine with a mean arterial pressure of 66 mm Hg. Over the past 24 hours his creatinine has risen from 1.1 to 2.9 mg/dL with a urine output of 0.3 mL/kg/hr, the ratio of arterial oxygen tension to inspired oxygen fraction has fallen from 340 to 180, platelet count has fallen from 210,000 to 74,000/mm3, and total bilirubin has risen to 4.6 mg/dL. Echocardiography shows a hyperdynamic left ventricle, and skin examination shows mottling over the knees with warm peripheries. Which of the following best describes the mechanism producing this pattern of organ dysfunction?\",\"choices\":[\"A. Direct cytotoxic invasion of each organ by bacteria\",\"B. Endothelial dysfunction with ischemic tissue injury\",\"C. Immune complex deposition within organ vasculature\",\"D. Left ventricular pump failure with forward hypoperfusion\",\"E. Widespread thrombotic occlusion of large named arteries\"],\"correct\":1,\"explanation\":\"In sepsis the damage arises from the host response rather than from the organism directly. Persistent inflammation -> endothelial dysfunction with loss of barrier integrity, glycocalyx shedding, vasodilation, capillary leak, and microvascular thrombosis -> ischemic tissue injury despite a normal or elevated cardiac output -> sequential organ damage and failure, then activation of cell death pathways. The clinical signature is exactly this combination: a hyperdynamic circulation with warm peripheries and mottled skin, indicating that the problem is distribution and extraction of oxygen at the microvascular level rather than pump failure. Organ failure proceeds sequentially rather than simultaneously, which is what the Sequential Organ Failure Assessment was designed to track.\\nEducational objective: Organ failure in sepsis results from inflammation-driven endothelial dysfunction and microvascular ischemic injury rather than direct microbial invasion, and it progresses sequentially. A hyperdynamic circulation with warm peripheries and mottling reflects impaired oxygen distribution and extraction rather than pump failure.\",\"wrongExplanations\":{\"0\":\"Direct microbial invasion of multiple organs occurs in disseminated infection such as miliary tuberculosis or fungal dissemination, with organisms demonstrable in tissue. In sepsis the organism is often not even recoverable, and no organism defines the syndrome.\",\"2\":\"Immune complex deposition damages vessels in serum sickness, post-infectious glomerulonephritis, and small vessel vasculitis, with characteristic complement consumption and a subacute course. It is not the mechanism of acute septic organ failure.\",\"3\":\"Septic cardiomyopathy is a real phenomenon and can reduce ejection fraction in a subset of patients, producing a cold, vasoconstricted picture. This patient is hyperdynamic with warm peripheries, which is the distributive rather than cardiogenic pattern.\",\"4\":\"Occlusion of large named arteries produces discrete infarcts in defined vascular territories, as in embolic disease. Sepsis injures the microcirculation diffusely, which is why multiple organs fail simultaneously without any territorial pattern.\"},\"eli5\":\"In sepsis the organs fail even though the heart is pumping hard and the blood pressure may be supported. The problem is in the smallest vessels, whose walls become leaky and clogged so oxygen never reaches the tissue. That is why the skin can feel warm while the kidneys are dying.\"},{\"stem\":\"A 66-year-old woman is admitted with community-acquired pneumonia and hypotension. Temperature is 38.9 C (102 F), blood pressure is 86/48 mm Hg, pulse is 124/min, and respirations are 32/min. Physical examination shows accessory muscle use and right basal crackles. Arterial blood gas on room air shows pH 7.34, PaCO2 26 mm Hg, PaO2 62 mm Hg, and bicarbonate 14 mEq/L. Serum sodium is 138 mEq/L, chloride is 102 mEq/L, and lactate is 5.2 mmol/L (normal: 0.5-2.2). Which of the following best characterizes this patient's acid-base disturbance?\",\"choices\":[\"A. Anion gap metabolic acidosis with respiratory alkalosis\",\"B. Anion gap metabolic acidosis with respiratory compensation only\",\"C. Non-anion gap metabolic acidosis with respiratory alkalosis\",\"D. Primary respiratory alkalosis with metabolic compensation\",\"E. Respiratory acidosis with metabolic compensation\"],\"correct\":0,\"explanation\":\"The anion gap is 138 minus (102 plus 14), which equals 22, establishing an anion gap metabolic acidosis driven by lactate from tissue hypoperfusion. Winter formula predicts an expected PaCO2 of 1.5 times 14 plus 8, approximately 29 mm Hg with a range of 27-31; the measured PaCO2 of 26 mm Hg is below that, indicating an additional primary respiratory alkalosis from sepsis-driven tachypnea rather than compensation alone. This pairing of metabolic acidosis with respiratory alkalosis is characteristic of sepsis, and seeing both together is more suggestive than either alone.\\nEducational objective: Sepsis classically produces an anion gap metabolic acidosis from lactate together with a primary respiratory alkalosis from tachypnea. Compare the measured PaCO2 with the Winter formula prediction: a value below the expected range indicates a superimposed primary respiratory alkalosis rather than compensation.\",\"wrongExplanations\":{\"1\":\"Pure respiratory compensation would produce a PaCO2 within the range predicted by the Winter formula, approximately 27-31 mm Hg here. The measured value of 26 mm Hg falls below that, revealing an additional primary process.\",\"2\":\"A non-anion gap acidosis occurs with diarrhea, renal tubular acidosis, or saline loading, and the calculated gap would be normal. This patient's anion gap of 22 is clearly elevated by lactate.\",\"3\":\"A primary respiratory alkalosis with metabolic compensation would show a raised pH with a low PaCO2 and a secondarily lowered bicarbonate, and no anion gap. The pH here is acidemic and the gap is wide.\",\"4\":\"Respiratory acidosis requires an elevated PaCO2 from hypoventilation, as in central nervous system depression or severe airflow obstruction. This patient is hyperventilating with a PaCO2 of 26 mm Hg.\"},\"eli5\":\"Two things are happening to the blood chemistry at once. Poor blood flow makes acid build up in the tissues, and rapid breathing blows off too much carbon dioxide. Seeing both together is a strong hint that you are looking at sepsis.\"},{\"stem\":\"A 59-year-old man is admitted with fever, cough, and confusion. He is hypotensive and meets criteria for sepsis. The team is uncertain whether the illness reflects a bacterial process warranting continued broad-spectrum antimicrobials or a viral syndrome, since bacterial cultures are pending and viral testing is positive for rhinovirus. A panel of laboratory studies is reviewed: leukocyte count 16,400/mm3, platelet count 92,000/mm3, creatinine 2.1 mg/dL, total bilirubin 3.8 mg/dL, lactate 3.6 mmol/L (normal: 0.5-2.2), C-reactive protein 210 mg/L, and procalcitonin 14 ng/mL (normal: below 0.1). Which of the following laboratory findings is most useful in identifying the likely class of causative organism?\",\"choices\":[\"A. C-reactive protein concentration\",\"B. Leukocyte count with differential\",\"C. Procalcitonin concentration\",\"D. Serum lactate concentration\",\"E. Total bilirubin concentration\"],\"correct\":2,\"explanation\":\"Nearly every laboratory abnormality in sepsis measures severity rather than cause: the leukocyte count, platelet count, creatinine, bilirubin, lactate, and C-reactive protein all quantify how sick the patient is and which organs are failing. Procalcitonin is the exception -> it is released from parenchymal tissues in response to bacterial products and interleukin-1 beta, while interferon gamma released during viral infection suppresses it -> an elevated value points specifically toward a bacterial etiology. It is therefore used to support the decision to continue or de-escalate antibacterial therapy, always alongside the clinical picture rather than in place of it.\\nEducational objective: Most laboratory abnormalities in sepsis measure severity of illness, whereas procalcitonin points toward etiology: it rises with bacterial infection and is suppressed by the interferon response to viral infection. It supports antimicrobial de-escalation decisions but does not replace clinical judgment.\",\"wrongExplanations\":{\"0\":\"C-reactive protein is an acute phase reactant produced by the liver under interleukin-6 stimulation and rises in bacterial infection, viral infection, trauma, surgery, and autoimmune disease alike. Its lack of specificity is precisely why it cannot identify a class of organism.\",\"1\":\"Leukocytosis, leukopenia, and bandemia all satisfy the systemic inflammatory response criteria and reflect the magnitude of the host response. Viral infections commonly produce leukocytosis or leukopenia as well.\",\"3\":\"Lactate reflects tissue hypoperfusion and impaired cellular oxygen utilization, and it is central to defining and monitoring septic shock. It rises with any cause of shock, including hemorrhage and cardiogenic failure.\",\"4\":\"Hyperbilirubinemia above 4 mg/dL is one of the organ dysfunction criteria and contributes to the hepatic domain of the Sequential Organ Failure Assessment. It grades liver injury and says nothing about the responsible organism.\"},\"eli5\":\"Almost every blood test in sepsis tells you how sick someone is, not what caused it. One marker is different: it climbs with bacterial infections and stays low with viral ones. That makes it useful for deciding whether to keep going with antibiotics.\"},{\"stem\":\"A 55-year-old woman is brought to the emergency department due to fever and rigors for the past 8 hours. Temperature is 39.2 C (102.6 F), blood pressure is 94/58 mm Hg, pulse is 118/min, and respirations are 26/min. Physical examination shows right costovertebral angle tenderness. Initial serum lactate is 4.6 mmol/L (normal: 0.5-2.2). She receives blood cultures, broad-spectrum antimicrobials, and 30 mL/kg of crystalloid within the first hour. Three hours later her blood pressure is 108/64 mm Hg without vasopressors, urine output has improved, and capillary refill is 2 seconds. Which of the following best describes the purpose of repeating the serum lactate measurement at this point?\",\"choices\":[\"A. C-reactive protein concentration\",\"B. Leukocyte count with differential\",\"C. Procalcitonin concentration\",\"D. Serum lactate concentration\",\"E. Total serum bilirubin concentration\"],\"correct\":4,\"explanation\":\"Lactate is the laboratory marker of the cellular and metabolic abnormality in the definition of septic shock, reflecting anaerobic metabolism during tissue hypoperfusion and impaired cellular oxygen utilization. Within the early bundle it serves two purposes: the initial value identifies occult hypoperfusion even when blood pressure is preserved, and the repeat value assesses whether resuscitation has restored perfusion -> a falling lactate supports adequate resuscitation, while a persistently elevated lactate indicates ongoing hypoperfusion and prompts further fluids, vasopressors, or a search for uncontrolled source. Normalizing blood pressure alone is not sufficient evidence that tissue perfusion has been restored.\\nEducational objective: Serum lactate marks tissue hypoperfusion and cellular metabolic failure in sepsis, and serial measurement assesses adequacy of resuscitation. A persistently elevated lactate despite a normalized blood pressure indicates ongoing hypoperfusion and warrants further intervention.\",\"wrongExplanations\":{\"0\":\"Organism identification requires cultures, molecular testing, or antigen detection. Lactate is a metabolic marker produced by host tissue and carries no information about the pathogen.\",\"1\":\"Adequacy of antimicrobial coverage is judged by susceptibility testing and by the overall clinical trajectory. Lactate can fall with fluid resuscitation alone and can remain elevated for non-infectious reasons, so it is not a coverage test.\",\"2\":\"Corticosteroids are considered in septic shock that remains refractory to adequate fluids and vasopressors, a decision based on hemodynamics rather than a lactate threshold. This patient has responded to fluids without vasopressors.\",\"3\":\"Locating a drainable source requires imaging and examination. An unclearing lactate may prompt that search, but the measurement itself localizes nothing.\"},\"eli5\":\"Lactate builds up when tissues are not getting enough oxygen, so it is a way of asking whether the fluids actually reached the cells. A normal blood pressure can be misleading. If the lactate is still high, the tissues are still starving even though the monitor looks better.\"},{\"stem\":\"A 68-year-old man is admitted with septic shock from a urinary source. Blood cultures grow Enterococcus faecalis susceptible to ampicillin, vancomycin, and linezolid. He remains on norepinephrine with a lactate of 3.8 mmol/L (normal: 0.5-2.2) and has an obstructing ureteral stone with hydronephrosis, which is decompressed with a percutaneous nephrostomy. The pharmacist is asked to recommend definitive therapy, noting that the patient's absolute neutrophil count is normal and that source control has been achieved. The intensivist emphasizes that the early sepsis bundle specifies a particular property of the antimicrobial chosen. Which of the following properties is most important in selecting therapy for this patient?\",\"choices\":[\"A. Bactericidal rather than bacteriostatic activity\",\"B. Broad anaerobic coverage in addition to aerobic\",\"C. Extended half-life permitting once-daily dosing\",\"D. High oral bioavailability allowing early conversion\",\"E. Minimal hepatic cytochrome P450 interaction\"],\"correct\":0,\"explanation\":\"The early sepsis bundle specifies bactericidal antimicrobial therapy, alongside intravenous fluids, lactate measurement, assessment of tissue perfusion, and vasopressors when needed. Bacteriostatic agents only halt replication and rely on host phagocytes to clear the existing organism burden -> in overwhelming infection with a high inoculum and a dysregulated immune response, that reliance is unsafe. Ampicillin is bactericidal against susceptible Enterococcus faecalis, whereas linezolid is bacteriostatic against enterococci. The bundle is delivered together and early precisely because sepsis is defined as time-dependent organ dysfunction, and source control, achieved here by nephrostomy, remains an essential parallel step.\\nEducational objective: The early sepsis bundle specifies bactericidal antimicrobial therapy along with intravenous fluids, lactate measurement, perfusion assessment, and vasopressors as needed. Bacteriostatic agents depend on host clearance and are less suitable in overwhelming infection, and source control is a parallel requirement.\",\"wrongExplanations\":{\"1\":\"Anaerobic coverage matters for abdominal, pelvic, and necrotizing soft tissue sources where Bacteroides fragilis and mixed anaerobes are expected. This is a urinary source with a documented enterococcal isolate.\",\"2\":\"Convenient dosing intervals matter for outpatient therapy and adherence but are irrelevant to an intravenous regimen in an intensive care unit. Pharmacokinetic convenience does not influence survival in septic shock.\",\"3\":\"Oral bioavailability supports early intravenous-to-oral conversion and shorter hospital stays once a patient has stabilized. It is not a consideration during vasopressor-dependent shock with uncertain gut absorption.\",\"4\":\"Avoiding cytochrome P450 interactions is important with agents such as azoles and rifampin in patients on complex regimens. It is a secondary consideration compared with achieving rapid killing of the organism.\"},\"eli5\":\"Some antibiotics kill bacteria outright, and others only stop them multiplying so the immune system can finish the job. In sepsis the immune system is already misfiring, so you do not want to depend on it. The sepsis checklist specifically calls for the killing kind.\"},{\"stem\":\"A 62-year-old man is brought to the emergency department 6 hours after the onset of fever, left flank pain, and vomiting. He has type 2 diabetes mellitus. Temperature is 39.0 C (102.2 F), blood pressure is 82/44 mm Hg, pulse is 128/min, and respirations are 28/min. Physical examination shows left costovertebral angle tenderness and cool, mottled extremities. He receives blood cultures, intravenous ceftriaxone, and 30 mL/kg of balanced crystalloid over the first hour. Repeat assessment shows a blood pressure of 84/46 mm Hg, a mean arterial pressure of 59 mm Hg, capillary refill of 4 seconds, urine output of 10 mL over the hour, and a lactate that has risen from 4.2 to 5.0 mmol/L (normal: 0.5-2.2). Which of the following is the most appropriate next step in management of this patient?\",\"choices\":[\"A. Add a second antimicrobial for gram-positive coverage\",\"B. Administer a second 30 mL/kg crystalloid bolus\",\"C. Begin norepinephrine to restore perfusion pressure\",\"D. Obtain CT of the abdomen before further intervention\",\"E. Transfuse packed red blood cells to raise oxygen delivery\"],\"correct\":2,\"explanation\":\"The early bundle sequences fluids first, then reassessment of tissue perfusion, then vasopressors when fluids alone cannot maintain perfusion pressure. This patient has received an adequate initial fluid challenge yet has a mean arterial pressure of 59 mm Hg with a rising lactate, prolonged capillary refill, and oliguria -> ongoing hypoperfusion despite volume resuscitation -> vasopressor support is indicated, with norepinephrine as the first-line agent, targeting a mean arterial pressure of at least 65 mm Hg. Delaying vasopressors prolongs the ischemic insult that drives sequential organ failure, and this decision defines septic shock, in which the cardiovascular domain of the Sequential Organ Failure Assessment is scored by vasopressor dose.\\nEducational objective: When hypoperfusion persists after an adequate crystalloid challenge in sepsis, norepinephrine is started to restore a mean arterial pressure of at least 65 mm Hg. Persisting hypotension and a rising lactate despite fluids define septic shock and should not be met with indefinite additional fluid alone.\",\"wrongExplanations\":{\"0\":\"Broadening coverage is appropriate when a resistant or unusual organism is suspected, and gram-positive organisms are the most commonly identified overall. The immediate problem is hemodynamic, and a urinary source in this setting is most often gram negative.\",\"1\":\"Additional fluid may be given guided by dynamic measures of fluid responsiveness, but repeating a full weight-based bolus in a patient who has not responded risks pulmonary edema and worsening oxygenation. Vasopressor support should not be delayed while further volume is trialed.\",\"3\":\"Imaging to identify an obstructing stone or abscess requiring source control is important and should follow promptly. Transporting a patient with a mean arterial pressure of 59 mm Hg to the scanner before stabilizing perfusion is unsafe.\",\"4\":\"Transfusion raises oxygen-carrying capacity and is indicated for significant anemia, generally at a hemoglobin below 7 g/dL in critical illness. No anemia is described, and transfusion does not correct vasodilatory hypotension.\"},\"eli5\":\"You start with fluids, then check whether they worked. Here the blood pressure stayed low, the urine stopped, and the acid level went up, so the fluids alone are not enough. The next step is a medicine that tightens the blood vessels, not simply pouring in more fluid.\"},{\"stem\":\"A hospital patient safety committee reviews sepsis screening performance. Over one year, an automated alert based on the systemic inflammatory response criteria fired on 8,400 of 42,000 admitted patients. Of those flagged, 620 were ultimately adjudicated to have sepsis. Among the 33,600 patients not flagged, 40 were later found to have had sepsis. The committee notes that clinicians have begun to ignore the alert. Which of the following best characterizes the performance of this screening tool in this population?\",\"choices\":[\"A. High negative predictive value with low positive predictive value\",\"B. High positive predictive value with low negative predictive value\",\"C. High specificity with a low rate of false positive alerts\",\"D. Low sensitivity offset by high positive predictive value\",\"E. Low sensitivity with correspondingly low negative predictive value\"],\"correct\":0,\"explanation\":\"Sensitivity is 620 divided by 660, approximately 94%, and the negative predictive value is 33,560 divided by 33,600, above 99.8% -> a patient who does not trigger the alert is very unlikely to have sepsis. However, only 620 of 8,400 flagged patients had sepsis, a positive predictive value of about 7%, because the systemic inflammatory response criteria are sensitive but non-specific and the condition is uncommon relative to the number screened. This is the structural reason those criteria were removed as a defining criterion for sepsis and the reason alert fatigue develops: in a low-prevalence population, even a good test generates overwhelmingly more false alarms than true cases.\\nEducational objective: Sensitive but non-specific screening criteria such as the systemic inflammatory response criteria yield a high negative predictive value and a low positive predictive value when the target condition is uncommon. The resulting false-positive burden drives alert fatigue, which is why more specific instruments such as the Sequential Organ Failure Assessment were adopted.\",\"wrongExplanations\":{\"1\":\"A high positive predictive value would mean most alerts identified true sepsis, which occurs only when the criteria are specific or the prevalence is high. Here 93% of alerts were false positives.\",\"2\":\"High specificity would produce few false positives, whereas 7,780 of 8,400 alerts here were false. Non-specificity is the defining weakness of these criteria.\",\"3\":\"Low sensitivity would mean many septic patients were missed, defeating the purpose of screening. Only 40 of 660 cases went unflagged, so sensitivity is high.\",\"4\":\"Low sensitivity and low negative predictive value together would describe a test that misses most cases and cannot reassure when negative. Both values are in fact high in this dataset.\"},\"eli5\":\"This alert almost never misses a truly septic patient, which is exactly what a screening tool should do. But because sepsis is rare compared with how many patients get flagged, more than nine out of ten alarms are false. That is why staff start tuning it out.\"},{\"stem\":\"A 74-year-old woman is evaluated on the second hospital day. She was admitted for intravenous antibiotic treatment of cellulitis of the right leg and has a history of heart failure with preserved ejection fraction and chronic kidney disease. She now appears drowsy but is oriented to person only. Temperature is 37.2 C (99 F), blood pressure is 98/58 mm Hg, pulse is 96/min, respirations are 24/min, and oxygen saturation is 93% on room air. Physical examination shows improving erythema of the right calf without crepitus or bullae. The covering physician wants a rapid bedside assessment, without laboratory studies, to decide whether she is at increased risk of death and requires escalation of care. Which of the following sets of parameters would this assessment use?\",\"choices\":[\"A. Bilirubin, creatinine, platelet count, and oxygenation ratio\",\"B. Blood pressure, heart rate, respiratory rate, and temperature\",\"C. Respiratory rate, systolic blood pressure, and mentation\",\"D. Temperature, heart rate, respiratory rate, and leukocyte count\",\"E. Temperature, lactate, urine output, and capillary refill time\"],\"correct\":2,\"explanation\":\"The quick Sequential Organ Failure Assessment was designed for rapid bedside use outside the emergency department and intensive care unit, requiring no laboratory results. Its three criteria are a respiratory rate of 22/min or more, a systolic blood pressure of 100 mm Hg or less, and altered mentation -> this patient meets all three, identifying her as at increased risk of death and prompting escalation. Note that the blood pressure threshold is 100 mm Hg rather than 90, so the tool flags patients before frank hypotension develops, and that a normal temperature does not exclude a septic process.\\nEducational objective: The quick Sequential Organ Failure Assessment uses three bedside criteria requiring no laboratory data: respiratory rate 22/min or more, systolic blood pressure 100 mm Hg or less, and altered mentation. The blood pressure threshold of 100 mm Hg identifies patients before frank hypotension develops.\",\"wrongExplanations\":{\"0\":\"Bilirubin, creatinine, platelet count, and the oxygenation ratio are components of the full Sequential Organ Failure Assessment, which grades six organ systems. It requires laboratory results and cannot be completed at the bedside.\",\"1\":\"Blood pressure, heart rate, respiratory rate, and temperature, with mental status, comprise the Modified Early Warning Score, a general deterioration screen. It is a valid bedside tool but uses five weighted parameters rather than the three described.\",\"3\":\"Temperature, heart rate, respiratory rate, and leukocyte count are the systemic inflammatory response criteria, which require a complete blood count and are therefore not purely bedside. They are also no longer a defining criterion for sepsis.\",\"4\":\"Lactate, urine output, and capillary refill are used to assess adequacy of resuscitation within the treatment bundle. Lactate requires a blood draw, and these are monitoring rather than risk-stratification parameters.\"},\"eli5\":\"There is a three-item check a doctor can do at the bedside with no blood tests at all: is the patient breathing fast, is the top blood pressure number low, and is their thinking off. Two or more of those means they are in real danger. It deliberately catches people before the blood pressure crashes.\"},{\"stem\":\"A 29-year-old woman at 32 weeks gestation is admitted due to fever, chills, and dysuria for the past 2 days. She has no chronic medical conditions. Temperature is 39.4 C (102.9 F), blood pressure is 92/50 mm Hg, pulse is 126/min, and respirations are 26/min. Physical examination shows right costovertebral angle tenderness and a gravid uterus consistent with dates; fetal heart tracing is category I. Laboratory studies show leukocyte count 19,800/mm3 with 12% band forms, creatinine 1.4 mg/dL, and lactate 3.2 mmol/L (normal: 0.5-2.2). Urinalysis shows pyuria and bacteriuria, and blood cultures are drawn. Which of the following features of this patient most substantially increases her risk of developing sepsis?\",\"choices\":[\"A. Absence of chronic comorbid disease\",\"B. Age under 30 years\",\"C. Category I fetal heart tracing\",\"D. Female sex with a urinary source\",\"E. Pregnancy at 32 weeks gestation\"],\"correct\":4,\"explanation\":\"The recognized risk factors for sepsis are intensive care admission, bacteremia, age 65 or older or under 1 year (with additional risk if premature), pregnancy, immunosuppressive comorbidity such as diabetes, chemotherapy, or recent transplantation, community-acquired pneumonia, prior hospitalization, and genetic factors reducing pathogen recognition. Pregnancy is on that list: physiologic immune modulation that permits tolerance of the fetus, urinary stasis from ureteral compression and progesterone-mediated smooth muscle relaxation, and increased susceptibility to pyelonephritis together raise risk -> maternal sepsis is a leading cause of maternal morbidity and mortality. Her young age and absence of comorbidity are favorable, and survival in young healthy patients approaches 90%, but they do not offset the pregnancy-associated risk.\\nEducational objective: Pregnancy is an independent risk factor for sepsis, together with age 65 or older or under 1 year, intensive care admission, bacteremia, immunosuppressive comorbidity, community-acquired pneumonia, and prior hospitalization. Pyelonephritis in pregnancy is a common precipitant of maternal sepsis.\",\"wrongExplanations\":{\"0\":\"Absence of chronic comorbid disease is favorable, since immunosuppressive comorbidities such as diabetes, chemotherapy, and recent transplantation are among the listed risk factors. It lowers rather than raises her risk.\",\"1\":\"Young age is protective rather than a risk factor; survival in young, otherwise healthy patients with sepsis approaches 90%. The age extremes that carry increased risk are 65 years and older and under 1 year.\",\"2\":\"A category I fetal heart tracing is reassuring and indicates normal fetal acid-base status at the time of observation. It provides no information about maternal sepsis risk.\",\"3\":\"Female sex with a urinary source explains why she developed pyelonephritis, since the shorter urethra predisposes to ascending infection. Urinary tract infection is the second most common source of sepsis, but sex itself is not a listed risk factor for progression to sepsis.\"},\"eli5\":\"Pregnancy changes the immune system so the body does not reject the baby, and it also squeezes the tubes that drain the kidneys. Both make a urine infection more likely to spread and become dangerous. That is why pregnancy is on the list of things that raise sepsis risk.\"},{\"stem\":\"A 70-year-old man is admitted with sepsis from a respiratory source. On hospital day 2 the intensive care team documents the following: he opens his eyes to voice and follows no commands; the ratio of arterial oxygen tension to inspired oxygen fraction is 210 on supplemental oxygen; platelet count is 88,000/mm3; total bilirubin is 3.4 mg/dL; creatinine is 2.6 mg/dL with urine output of 0.4 mL/kg/hr; and a mean arterial pressure of 68 mm Hg is being maintained on norepinephrine at 0.12 mcg/kg/min. These findings are entered into an organ dysfunction score. Which of the following statements best describes how the cardiovascular component of that score is determined in this patient?\",\"choices\":[\"A. By cardiac index measured with a pulmonary artery catheter\",\"B. By central venous oxygen saturation from a central catheter\",\"C. By heart rate and its deviation from the age-adjusted normal\",\"D. By the dose of vasopressor required to sustain perfusion\",\"E. By the systolic blood pressure recorded at the time of scoring\"],\"correct\":3,\"explanation\":\"The Sequential Organ Failure Assessment grades six organ systems from 0 to 4, and the cardiovascular domain is unusual in that, once the mean arterial pressure falls below 70 mm Hg, the score is determined by vasopressor requirement and dose rather than by the pressure itself. A patient supported to a normal-appearing blood pressure on escalating vasopressor doses is more, not less, unwell -> scoring by drug dose captures the severity that the displayed pressure conceals. This is also why septic shock is operationally defined by vasopressor dependence plus a persistently raised lactate rather than by a blood pressure threshold alone.\\nEducational objective: In the Sequential Organ Failure Assessment, the cardiovascular domain is scored by vasopressor requirement and dose once the mean arterial pressure falls below 70 mm Hg, because supported blood pressure conceals severity. Septic shock is likewise defined by vasopressor dependence with persistent lactate elevation.\",\"wrongExplanations\":{\"0\":\"Cardiac index from a pulmonary artery catheter characterizes hemodynamic profiles and distinguishes cardiogenic from distributive shock. Routine pulmonary artery catheterization is not used in sepsis and is not part of the score.\",\"1\":\"Central venous oxygen saturation was a target in early goal-directed therapy protocols and reflects the balance of oxygen delivery and consumption. Subsequent trials did not support protocolized targeting, and it is not a scoring component.\",\"2\":\"Heart rate is a component of the systemic inflammatory response criteria and of the early warning scores, where tachycardia above 90/min qualifies. The organ failure score does not use heart rate in its cardiovascular domain.\",\"4\":\"Systolic blood pressure of 100 mm Hg or less is a criterion of the quick Sequential Organ Failure Assessment, the bedside screening tool. The full score moves beyond the displayed pressure precisely because vasopressors mask it.\"},\"eli5\":\"A blood pressure that looks fine can be entirely propped up by drugs. So this score does not ask what the number is; it asks how much medicine it took to get there. Needing more drug means the patient is sicker, even if the monitor looks reassuring.\"},{\"stem\":\"A 47-year-old woman is admitted with septic shock from a soft tissue source and requires 6 days of vasopressor support and mechanical ventilation. She is extubated on day 9 and discharged on day 16, having cleared her infection with no residual organ failure. She returns to the office 10 weeks after discharge. She reports profound fatigue that limits her to a few hours of activity daily, difficulty concentrating and finding words, poor sleep with vivid nightmares about the intensive care unit, and intrusive daytime recollections of being restrained and intubated. She has lost 6 kg and has not returned to work. Vital signs are within normal limits and physical examination is unremarkable; complete blood count, metabolic panel, and inflammatory markers are normal. Which of the following best explains this patient's current presentation?\",\"choices\":[\"A. Adrenal insufficiency following critical illness\",\"B. Occult recurrent infection at the original site\",\"C. Post-sepsis syndrome affecting survivors\",\"D. Somatic symptom disorder with health anxiety\",\"E. Undiagnosed pulmonary embolism causing fatigue\"],\"correct\":2,\"explanation\":\"Roughly half of sepsis survivors develop post-sepsis syndrome, and surviving the admission is not the end of the disease. The syndrome combines physical deconditioning and fatigue with a striking neuropsychiatric burden: cognitive decline with impaired attention and word finding, post-traumatic stress with flashbacks and nightmares, panic symptoms, and depression -> prolonged failure to return to work and a high rate of rehospitalization, which together drive much of the roughly 62 billion dollar annual cost of sepsis in the United States. Recognition matters because these patients are frequently investigated repeatedly for occult disease when what they require is rehabilitation, cognitive and psychological support, and anticipatory counseling.\\nEducational objective: Post-sepsis syndrome affects about 50% of sepsis survivors and combines fatigue and deconditioning with cognitive impairment, post-traumatic stress, and depression. It contributes to the high rehospitalization rate after sepsis and requires rehabilitation and psychological support rather than repeated investigation.\",\"wrongExplanations\":{\"0\":\"Critical illness-related corticosteroid insufficiency causes fatigue, hypotension, hyponatremia, and eosinophilia, and would be supported by a low random or stimulated cortisol. This patient's vital signs and metabolic panel are normal.\",\"1\":\"Recurrent or persistent infection would be expected to produce fever, local findings at the original site, and elevated inflammatory markers. Her examination is unremarkable and inflammatory markers are normal.\",\"3\":\"Somatic symptom disorder involves disproportionate thoughts and behaviors about physical symptoms without an explanatory illness, and it is a diagnosis of exclusion. Here there is a well-characterized syndrome directly attributable to a severe illness that occurred 10 weeks ago.\",\"4\":\"Pulmonary embolism causes dyspnea, pleuritic chest pain, and hypoxemia, and critical illness is a risk factor. It would not explain nightmares, intrusive recollections, or word-finding difficulty, and her oxygenation is normal.\"},\"eli5\":\"Getting out of the hospital is not the end of sepsis. About half of survivors are left exhausted, foggy, and haunted by memories of the intensive care unit for months. It is a recognized syndrome, not a sign that something was missed.\"},{\"stem\":\"A 76-year-old man with metastatic pancreatic adenocarcinoma is admitted with septic shock from a biliary source. He has had progressive functional decline over 4 months and now requires assistance with all activities of daily living; his oncologist recently discontinued chemotherapy. On hospital day 3 he remains on two vasopressors and continuous renal replacement therapy, with a rising lactate and worsening oxygenation despite maximal therapy and adequate source control. He lacks decision-making capacity. His daughter, who is his health care agent, says, \\\"I know he was getting weaker before all this. But if we stop the machines, aren't we just giving up on him? I do not want to be the one who ends his life.\\\" Which of the following is the most appropriate initial response by the physician?\",\"choices\":[\"A. \\\"His organs are failing despite everything, so continuing treatment would be futile at this point.\\\"\",\"B. \\\"I hear how much this weighs on you; what would your father say if he could speak now?\\\"\",\"C. \\\"Legally this is entirely your decision as his agent, so we will follow whatever you decide.\\\"\",\"D. \\\"Most families in your situation choose comfort care, and that is usually the kinder path.\\\"\",\"E. \\\"Nothing that we stop would cause his death; the cancer and the infection are what cause it.\\\"\"],\"correct\":1,\"explanation\":\"The daughter has voiced a specific moral fear, that withdrawing support would make her the cause of her father's death, and that fear is the barrier to the conversation. The response that fits the communication hierarchy names and validates the emotion and then redirects the decision to its proper standard: substituted judgment, meaning what the patient himself would choose, rather than what the surrogate wants or feels responsible for. Framing it this way relieves the surrogate of the sense that she is choosing to end a life and grounds the decision in the patient's own values. Reassurance about causation, prognostic information, and discussion of comfort-focused care all follow, but offered first they answer a question she has not yet been helped to ask.\\nEducational objective: A surrogate decision maker should decide using substituted judgment, based on what the patient would have chosen. When a surrogate expresses guilt about withdrawing support, validate the emotion and reframe the question toward the patient's own values before providing prognostic information or recommendations.\",\"wrongExplanations\":{\"0\":\"Declaring treatment futile is a conclusion delivered before the surrogate's concern has been acknowledged, and the word itself is often heard as abandonment. Prognostic candor is essential but belongs after the emotional content has been addressed.\",\"2\":\"Telling the surrogate that the decision is entirely hers abandons her at the moment she has asked for help and misstates the physician's role, which includes making a recommendation grounded in the patient's values. It also reinforces her fear of personal responsibility for the death.\",\"3\":\"Citing what most families choose applies social pressure rather than eliciting this patient's values, and it substitutes a population norm for substituted judgment. It may also be heard as steering her toward a predetermined answer.\",\"4\":\"Explaining that the underlying disease rather than the withdrawal causes death is accurate and is often genuinely comforting later in the conversation. Delivered as the opening response it corrects her framing before acknowledging the distress behind it.\"},\"eli5\":\"She is not really asking a medical question; she is afraid that stopping treatment would make her responsible for her father's death. The most helpful first move is to say you understand that fear and then ask what he himself would have wanted. That shifts the weight off her shoulders and onto his own wishes.\"},{\"stem\":\"A 58-year-old man with alcohol-associated cirrhosis is admitted with fever and abdominal distension. Temperature is 38.6 C (101.5 F), blood pressure is 88/50 mm Hg, and pulse is 116/min. Physical examination shows tense ascites and diffuse abdominal tenderness. Diagnostic paracentesis shows an ascitic fluid absolute neutrophil count of 640/mm3, and culture subsequently grows Escherichia coli. Laboratory studies show leukocyte count 15,200/mm3, platelet count 62,000/mm3, creatinine 2.4 mg/dL (baseline 1.0), total bilirubin 6.2 mg/dL, international normalized ratio 2.1, and lactate 4.4 mmol/L (normal: 0.5-2.2); urine output over 6 hours is 0.3 mL/kg/hr. Which of the following findings in this patient is most specifically attributable to sepsis-related organ dysfunction rather than to his underlying liver disease?\",\"choices\":[\"A. Coagulopathy with an international normalized ratio of 2.1\",\"B. Hyperbilirubinemia with a total bilirubin of 6.2 mg/dL\",\"C. Leukocytosis with a count of 15,200/mm3\",\"D. Oliguria with a creatinine rise from 1.0 to 2.4 mg/dL\",\"E. Thrombocytopenia with a platelet count of 62,000/mm3\"],\"correct\":3,\"explanation\":\"Cirrhosis independently produces coagulopathy from impaired synthesis of clotting factors, hyperbilirubinemia from hepatocellular dysfunction, and thrombocytopenia from splenic sequestration and reduced thrombopoietin -> each of those values could be explained by liver disease alone and cannot be attributed to sepsis without a baseline. The acute rise in creatinine from a documented baseline of 1.0 to 2.4 mg/dL with oliguria below 0.5 mL/kg/hr is a new, quantifiable organ dysfunction meeting the renal criteria and represents genuine sepsis-associated acute kidney injury. This illustrates a general principle: organ dysfunction scores are most informative when interpreted against the patient's own baseline, since chronic disease can satisfy the same thresholds.\\nEducational objective: Organ dysfunction criteria in sepsis must be interpreted against the patient's baseline, since chronic disease such as cirrhosis independently causes coagulopathy, hyperbilirubinemia, and thrombocytopenia. An acute creatinine rise with oliguria below 0.5 mL/kg/hr represents new sepsis-associated organ dysfunction.\",\"wrongExplanations\":{\"0\":\"A prolonged international normalized ratio in cirrhosis reflects reduced hepatic synthesis of coagulation factors and is a component of the Child-Pugh and MELD scores. Without a baseline value it cannot be attributed to sepsis.\",\"1\":\"Hyperbilirubinemia is a cardinal feature of decompensated cirrhosis and, like the international normalized ratio, is a component of standard prognostic scores for liver disease. It is expected in this patient irrespective of infection.\",\"2\":\"Leukocytosis satisfies a systemic inflammatory response criterion and supports the presence of infection, but it measures the inflammatory response rather than organ dysfunction. Organ dysfunction is what converts infection into sepsis.\",\"4\":\"Thrombocytopenia in cirrhosis results from splenic sequestration due to portal hypertension and reduced hepatic thrombopoietin production, and is typically chronic. Sepsis can lower platelets further, but the isolated value does not establish that.\"},\"eli5\":\"This man's liver disease already causes abnormal clotting, high bilirubin, and low platelets, so those numbers prove nothing new. What is new is that his kidneys have suddenly stopped working compared with his own previous value. Judging these scores requires knowing where the patient started.\"}]";
var PRELOADED_UI_MODE="nbme";
var DEFAULT_QUESTION_COUNT=15;
var MAX_AI_QUESTION_COUNT=25;
var DOWNLOAD_TEMPLATE='';
