      <label class="lbl">Paste AI responses here</label>
      <div class="field-note">Paste the AI's full copied response into Set 1. If you ask the AI to make questions in smaller groups, paste each extra group into Set 2, Set 3, or Set 4. Launch Quiz will put all filled sets together.</div>
      <div class="paste-tabs" role="tablist" aria-label="AI response sets">
        <button class="paste-tab active" id="pasteTab1" type="button" role="tab" aria-selected="true" aria-controls="pastePanel1" onclick="showPasteSetTab(1)">Set 1</button>
        <button class="paste-tab" id="pasteTab2" type="button" role="tab" aria-selected="false" aria-controls="pastePanel2" onclick="showPasteSetTab(2)">Set 2</button>
        <button class="paste-tab" id="pasteTab3" type="button" role="tab" aria-selected="false" aria-controls="pastePanel3" onclick="showPasteSetTab(3)">Set 3</button>
        <button class="paste-tab" id="pasteTab4" type="button" role="tab" aria-selected="false" aria-controls="pastePanel4" onclick="showPasteSetTab(4)">Set 4</button>
      </div>
      <div class="paste-panels">
        <div class="paste-panel active" id="pastePanel1" role="tabpanel" aria-labelledby="pasteTab1">
          <label class="lbl" for="pasteArea1">Set 1</label>
          <div class="field-note">Use this for your first AI batch.</div>
          <textarea class="ta" id="pasteArea1" placeholder="Paste AI response for Set 1…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel2" role="tabpanel" aria-labelledby="pasteTab2" hidden="">
          <label class="lbl" for="pasteArea2">Set 2</label>
          <div class="field-note">Use this for your second AI batch.</div>
          <textarea class="ta" id="pasteArea2" placeholder="Paste AI response for Set 2…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel3" role="tabpanel" aria-labelledby="pasteTab3" hidden="">
          <label class="lbl" for="pasteArea3">Set 3</label>
          <div class="field-note">Use this for your third AI batch.</div>
          <textarea class="ta" id="pasteArea3" placeholder="Paste AI response for Set 3…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel4" role="tabpanel" aria-labelledby="pasteTab4" hidden="">
          <label class="lbl" for="pasteArea4">Set 4</label>
          <div class="field-note">Use this for your fourth AI batch.</div>
          <textarea class="ta" id="pasteArea4" placeholder="Paste AI response for Set 4…" oninput="syncPasteSetTabs()"></textarea>
        </div>
      </div>
    </div>
    <div class="setup-actions">
      <button class="launch-btn" onclick="launchQuiz()">🚀 Launch Quiz</button>
      <button class="ghost-btn" onclick="downloadQuiz()">⬇ Download My Quiz</button>
    </div>
    <div class="err-msg" id="errMsg"></div>
  </div>

</div>
</div>
</div>

<!-- ══════════ QUIZ VIEW ══════════ -->
<div class="view" id="viewQuiz">
<div class="quiz-page">

  <!-- top bar -->
  <div class="qt-bar">
    <div class="qt-name" id="qtName">Quiz</div>
    <button class="qt-btn" id="qtClassicUiBtn" onclick="switchQuizUI('nbme')">⇄ NBME UI</button>
    <button class="qt-btn" id="qtMarkBtn" onclick="toggleMark()">⚑ Mark</button>
    <button class="qt-btn" id="qtSubmitBtn" onclick="submitExam()">🧾 Submit Exam</button>
    <button class="qt-btn" onclick="downloadQuiz()">⬇ Download Quiz</button>
    <button class="qt-btn" onclick="resetQuiz()">↺ Reset</button>
    <button class="qt-btn" onclick="exitQuiz()">✕ Close</button>
  </div>

  <!-- grid -->
  <div class="qin">

    <!-- LEFT SIDEBAR -->
    <div class="sidebar">

      <!-- score boxes -->
      <div class="score-panel">
        <div class="score-box correct"><div class="sv" id="sC">0</div><div class="sl">Correct</div></div>
        <div class="score-box incorrect"><div class="sv" id="sI">0</div><div class="sl">Incorrect</div></div>
        <div class="score-box"><div class="sv" id="sP">—</div><div class="sl">Score</div></div>
      </div>

      <!-- mode toggle -->
      <div class="mode-toggle">
        <button class="mode-btn active" id="modeLearn" onclick="setMode('learn')"><span class="mode-icon">📚</span>Learn Mode</button>
        <button class="mode-btn" id="modeExam" onclick="setMode('exam')"><span class="mode-icon">📝</span>Exam Mode</button>
      </div>

      <!-- timer -->
      <div class="timer-card" id="timerCard">
        <div class="timer-lbl" id="timerModeLbl" onclick="toggleTimerDisplay()" title="Click to switch between elapsed and remaining time">TIMER · ELAPSED</div>
        <div class="timer-time" id="timerTime">00:00</div>
        <button class="tbtn" id="timerPlayBtn" onclick="toggleTimer()">▶</button>
        <button class="tbtn" onclick="resetTimer()">↺</button>
      </div>

      <!-- tools -->
      <div class="tool-panel">
        <button class="q-tool hl-tool" id="hlTool" onclick="toggleTool('hl')">🖊 Highlight</button>
        <button class="q-tool st-tool" id="stTool" onclick="toggleTool('st')">✂ Strikethrough</button>
        <button class="q-tool" onclick="clearMarks()">✖ Clear Marks</button>
        <button class="q-tool lab-tool" onclick="openLabs()">🧪 Lab Values</button>
        <div class="font-tools">
          <span class="font-tools-label">Text Size</span>
          <div class="font-tools-group">
            <button class="font-btn" onclick="adjustFontSize(-1)" aria-label="Decrease question and answer text size">A-</button>
            <button class="font-btn reset" onclick="resetFontSize()" aria-label="Reset question and answer text size">A</button>
            <button class="font-btn" onclick="adjustFontSize(1)" aria-label="Increase question and answer text size">A+</button>
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT: QUESTION -->
    <div>
      <div id="finBanner"></div>
      <div id="qArea"></div>
    </div>

  </div>
</div>
</div>

<!-- ══════════ NBME / NBOME VIEW ══════════ -->
<div class="view" id="viewQuizNbme">
<div class="nb-wrap">
  <div class="nb-util">
    <div class="nb-util-name" id="nbQuizTitle">Quiz</div>
    <div class="nb-util-actions">
      <button class="nb-util-btn" onclick="toggleFullscreen()" id="nbFsBtn">⛶ Fullscreen</button>
      <button class="nb-util-btn" onclick="switchQuizUI('classic')">UNE UI</button>
      <button class="nb-util-btn" onclick="downloadQuiz()">Download</button>
      <button class="nb-util-btn" onclick="resetQuiz()">Reset</button>
      <button class="nb-util-btn" onclick="exitQuiz()">Close</button>
    </div>
  </div>

  <div class="nb-app">
    <header class="nb-header">
      <div class="nb-status-box">
        <strong id="nbItemIndicator">Question: 1 of 1</strong>
        <span id="nbStatusMeta">Answered 0 of 1</span>
      </div>

      <div class="nb-header-center">
        <button class="nb-action-btn" id="nbMarkBtn" type="button" onclick="toggleMark()">⚑ Mark</button>
        <button class="nb-action-btn" id="nbHighlightBtn" type="button" onclick="toggleTool('hl')">Highlight</button>
        <button class="nb-action-btn" id="nbStrikeBtn" type="button" onclick="toggleTool('st')">Strikeout</button>
        <button class="nb-action-btn" type="button" onclick="clearMarks()">Clear</button>
        <button class="nb-mode-pill active" id="nbModeLearn" type="button" onclick="setMode('learn')">Learn</button>
        <button class="nb-mode-pill" id="nbModeExam" type="button" onclick="setMode('exam')">Testing</button>
        <button class="nb-action-btn" id="nbSummaryBtn" type="button" onclick="toggleSummaryPanel()" disabled="">See Score &amp; Summary</button>
        <div class="nb-item-picker">
          <label for="nbItemSelect">Question</label>
          <select id="nbItemSelect" aria-label="Jump to a question" onchange="goQ(parseInt(this.value,10))"></select>
        </div>
      </div>

      <div class="nb-nav-controls">
        <button class="nb-nav-btn" id="nbPrevBtn" type="button" onclick="prevQ()">
          <span class="icon">◀</span><span>Previous</span>
        </button>
        <button class="nb-nav-btn" id="nbNextBtn" type="button" onclick="nextQ()">
          <span class="icon">▶</span><span>Next</span>
        </button>
      </div>
    </header>

    <main class="nb-body">
      <aside class="nb-rail" aria-label="Question navigator">
        <div class="nb-rail-title">Questions</div>
        <button class="nb-rail-arrow" id="nbRailUpBtn" type="button" aria-label="Scroll question list up" onclick="scrollNbmeRail(-1)">▲</button>
        <div class="nb-rail-scroll" id="nbRailScroll" onscroll="syncNbmeRailArrows()">
          <div id="nbRailItems"></div>
        </div>
        <button class="nb-rail-arrow" id="nbRailDownBtn" type="button" aria-label="Scroll question list down" onclick="scrollNbmeRail(1)">▼</button>
      </aside>

      <section class="nb-stage">
        <div id="nbFinishBanner"></div>
        <div class="nb-question-scroll">
          <div id="nbContent"></div>
        </div>
      </section>
    </main>

    <footer class="nb-footer">
      <div class="nb-timer-box" id="nbTimerCard">
        <button class="nb-timer-mode" id="nbTimerModeLbl" type="button" onclick="toggleTimerDisplay()" title="Click to switch between elapsed and remaining time">Elapsed Time:</button><strong id="nbTimerTime">00:00</strong>
        <span>Status:</span><strong id="nbTimerStatus">Paused</strong>
        <small id="nbTimerNote">Same timer as the original interface</small>
        <div class="nb-timer-actions">
          <button class="nb-timer-mini" id="nbTimerToggle" type="button" onclick="toggleTimer()">Start</button>
          <button class="nb-timer-mini" type="button" onclick="resetTimer()">Reset</button>
        </div>
      </div>

      <div class="nb-footer-center">
        <div class="nb-score-chip">
          <span>Correct <strong id="nbScoreCorrect">0</strong></span>
          <span>Incorrect <strong id="nbScoreIncorrect">0</strong></span>
          <span>Score <strong id="nbScorePercent">—</strong></span>
        </div>
        <button class="nb-footer-tool" type="button" onclick="openLabs()">▤ Lab Values</button>
        <div class="nb-font-cluster">
          <label>Text</label>
          <button class="nb-font-btn" type="button" onclick="adjustFontSize(-1)">A-</button>
          <button class="nb-font-btn" type="button" onclick="resetFontSize()">A</button>
          <button class="nb-font-btn" type="button" onclick="adjustFontSize(1)">A+</button>
        </div>
      </div>

      <div class="nb-end-wrap">
        <button class="nb-end-btn" id="nbReviewBtn" type="button" onclick="handleNbmeEndAction()">Testing Mode Only</button>
      </div>
    </footer>
  </div>
</div>
</div>

<div class="lab-modal" id="labModal" onclick="if(event.target===this)closeLabs()">
  <div class="lab-shell">
    <div class="lab-card">
      <div class="lab-header">
        <div>
          <div class="lab-kicker">Reference Table</div>
          <h2 class="lab-title">Laboratory Values</h2>
          <div class="lab-sub">Shared lab reference for both quiz interfaces, imported from the NBME-style simulator so the values stay consistent.</div>
        </div>
        <button class="lab-close" type="button" onclick="closeLabs()">Close</button>
      </div>
      <div class="lab-controls">
        <div class="lab-toggle">
          <button class="lab-toggle-btn active" id="labUnitsUs" type="button" onclick="setLabUnits('us')">U.S. Units</button>
          <button class="lab-toggle-btn" id="labUnitsSi" type="button" onclick="setLabUnits('si')">SI Units</button>
        </div>
        <div class="lab-note">Switch units without leaving the question.</div>
      </div>
      <div class="lab-body">
        <div id="labTables"></div>
      </div>
    </div>
  </div>
</div>

<script>
// ── STATE ──
var questions=[],questionBank=[],answers={},selected={},marked={},stemMarkup={},choiceMarkup={},NC=0,NI=0,CQ=0;
var quizMode='learn';
var uiMode='classic';
var examSubmitted=false;
var reviewOpen=false;
var summaryVisible=false;
var finishBannerMinimized=false;
var toolMode='';
var highlightColor='#fff173', annotationRange=null, annotationRoot=null, suppressChoiceUntil=0;
var labUnitMode='us';
var timerSec=0,timerRunning=false,timerInterval=null;
var fontStep=0;
var LETTERS=['A','B','C','D','E','F','G','H'];
var MAX_ANSWER_CHOICES=8;
var PRELOADED_QUIZ_NAME="Hematopoiesis and Anemia I: Impaired Red Cell Production";
var PRELOADED_QUESTIONS_JSON="[{\"stem\": \"A 24-year-old man comes to the office due to progressive fatigue and easy bruising for the past 6 weeks. He has no chronic medical conditions, takes no daily medications, and does not use tobacco, alcohol, or illicit drugs. Temperature is 37.2 C (99 F), blood pressure is 118/72 mm Hg, and pulse is 96/min. Physical examination shows conjunctival pallor and scattered petechiae over both lower extremities; there is no lymphadenopathy, hepatomegaly, or splenomegaly. Complete blood count shows hemoglobin 7.8 g/dL, hematocrit 23%, leukocyte count 1,800/mm3, and platelet count 22,000/mm3, with a low reticulocyte count. Bone marrow aspiration and core biopsy are planned to evaluate for a primary marrow disorder. Sampling at which of the following sites is most likely to yield actively hematopoietic marrow in this patient?\", \"choices\": [\"A. Distal radial metaphysis\", \"B. Mid-shaft of the left femur\", \"C. Mid-shaft of the left humerus\", \"D. Posterior superior iliac spine\", \"E. Proximal tibial metaphysis\"], \"correct\": 3, \"explanation\": \"Hematopoiesis relocates over a lifetime: yolk sac -> fetal liver and spleen -> bone marrow before birth. In adults, red (hematopoietic) marrow retreats from the appendicular skeleton into the axial skeleton -> vertebrae, ribs, sternum, and pelvis, while the long bones convert to fatty yellow marrow. The posterior superior iliac spine is therefore the standard sampling site: it holds active marrow, is palpable with the patient prone, and is remote from vital structures. Both an aspirate (cytology, blast percentage, iron stain) and a core biopsy (architecture and cellularity) are obtained, because cellularity can be judged only on the core.\\nEducational objective: Adult hematopoiesis occurs in the axial skeleton (vertebrae, ribs, sternum, pelvis), whereas the long bones contain fatty yellow marrow. The posterior superior iliac spine is the standard biopsy site; the aspirate provides cytology and the core biopsy provides architecture and cellularity.\", \"wrongExplanations\": {\"0\": \"The distal radius contains hematopoietic marrow only in early infancy and is fatty yellow marrow in adults; it is used for vascular access and fracture fixation, not marrow sampling. This patient is an adult, in whom red marrow has receded to the axial skeleton.\", \"1\": \"The femoral shaft is a site of red marrow in the fetus and young infant and yields hematopoietic tissue only in that age group. In an adult it contains yellow (fatty) marrow and would produce a nondiagnostic specimen.\", \"2\": \"The humeral shaft is an accepted site for emergency intraosseous vascular access in adults, where the goal is drug delivery rather than tissue diagnosis. It does not contain appreciable hematopoietic marrow after childhood.\", \"4\": \"The proximal tibia contains hematopoietic marrow in infants and young children and is the preferred intraosseous access site in pediatric resuscitation. In a 24-year-old it has converted to yellow marrow.\"}, \"eli5\": \"Your body makes blood inside bones, but as you grow up the blood factories shut down in your arms and legs and stay only in the bones at your center. That is why doctors take a marrow sample from the back of the hip. Poking a leg bone in an adult would just find fat.\"}, {\"stem\": \"A 66-year-old man is admitted to the hospital due to crushing substernal chest pain for the past 2 hours and receives a single 325-mg dose of aspirin. Three days later, after the aspirin has been fully cleared from his plasma, he sustains a superficial laceration while ambulating, and the wound edges ooze for 20 minutes before hemostasis is achieved. Platelet count is 265,000/mm3, and prothrombin time and activated partial thromboplastin time are normal. His hemostatic defect is expected to persist for approximately 7-10 days. Which of the following properties of the affected blood element best explains the persistence of this defect long after the drug itself has been eliminated?\", \"choices\": [\"A. Absence of a cell nucleus\", \"B. Biconcave disc morphology\", \"C. Derivation from a lymphoid progenitor\", \"D. Presence of dense cytoplasmic granules\", \"E. Regulation of production by thrombopoietin\"], \"correct\": 0, \"explanation\": \"Aspirin irreversibly acetylates cyclooxygenase-1 in platelets. Platelets are not true cells; they are anucleate membrane fragments blebbed from marrow megakaryocytes -> no nucleus -> no transcription -> no replacement enzyme can be synthesized. The inhibition therefore lasts the entire 7- to 10-day platelet lifespan, and function returns only as the marrow releases new platelets. This is why aspirin must be stopped days, not hours, before elective surgery.\\nEducational objective: Platelets are anucleate cytoplasmic fragments derived from megakaryocytes and cannot synthesize new protein. An irreversible inhibitor such as aspirin therefore disables a platelet for its entire 7- to 10-day lifespan, and function recovers only through production of new platelets.\", \"wrongExplanations\": {\"1\": \"Biconcave disc morphology describes the erythrocyte, where it maximizes surface area for gas exchange and permits deformation through capillaries; its loss produces spherocytes. It has no bearing on the duration of drug-induced platelet inhibition.\", \"2\": \"Derivation from a lymphoid progenitor characterizes B cells, T cells, and natural killer cells. Platelets arise from the myeloid branch via the megakaryocyte, and lineage of origin does not determine the duration of enzyme inhibition.\", \"3\": \"Dense granules store adenosine diphosphate, serotonin, and calcium and are the basis of platelet amplification and of storage pool disorders. Granule content is depleted and resynthesized during activation and does not explain irreversibility.\", \"4\": \"Thrombopoietin regulation determines the rate at which new platelets are produced and explains the timeline of recovery, not the persistence of the defect in an individual platelet. The platelet count here is normal, so production is intact.\"}, \"eli5\": \"A platelet is more like a broken-off piece of a bigger cell than a whole cell, and it has no instruction manual inside. Aspirin permanently breaks one of its tools, and it cannot build a replacement. So it stays broken until your body makes brand-new platelets about a week later.\"}, {\"stem\": \"A 19-year-old man comes to the emergency department due to fever, fatigue, and gum bleeding for the past 10 days. Temperature is 38.6 C (101.5 F) and pulse is 112/min. Physical examination shows pallor, gingival hypertrophy, and scattered ecchymoses. Complete blood count shows hemoglobin 6.9 g/dL, leukocyte count 62,000/mm3, and platelet count 14,000/mm3, with a low reticulocyte count. Bone marrow core biopsy is markedly hypercellular, with almost no residual fat and more than 85% of the marrow space replaced by a uniform population of immature cells of a single myeloid line; erythroid and megakaryocytic precursors are nearly absent. Which of the following best describes the abnormality at the level of the hematopoietic stem or progenitor cell in this patient?\", \"choices\": [\"A. Differentiation proceeding without self-renewal\", \"B. Fibrotic replacement of the stem cell niche\", \"C. Loss of both self-renewal and differentiation capacity\", \"D. Mobilization of stem cells from the niche into the blood\", \"E. Self-renewal uncoupled from differentiation\"], \"correct\": 4, \"explanation\": \"A hematopoietic stem cell is defined by two properties: self-renewal (it copies itself, so the pool never runs out) and differentiation (it produces committed daughter cells). Continued division is normal for a stem cell; malignancy arises when proliferation continues while maturation stops. Here a myeloid progenitor proliferates without maturing -> accumulation of immature cells -> a hypercellular marrow that crowds out erythroid and megakaryocytic lines -> anemia, thrombocytopenia, and a low reticulocyte count despite a packed marrow. That is acute leukemia.\\nEducational objective: Leukemia results from proliferation uncoupled from maturation in a hematopoietic stem or progenitor cell. The marrow becomes hypercellular with immature cells of a single line, while the remaining lineages fail from crowding out, producing anemia and thrombocytopenia with a low reticulocyte count.\", \"wrongExplanations\": {\"0\": \"Differentiation without self-renewal describes exhaustion of the stem cell pool, as occurs after marrow-ablative injury; the marrow becomes hypocellular and all lineages fall together. This patient's marrow is markedly hypercellular with a single expanding population.\", \"1\": \"Fibrotic replacement of the niche characterizes primary myelofibrosis, in which the marrow cannot be aspirated (dry tap) and the smear shows teardrop cells with nucleated red cells and immature granulocytes. There is no fibrosis described here, and the marrow is packed with cells rather than collagen.\", \"2\": \"Loss of both stem cell properties describes aplastic anemia, where the core biopsy shows a hypocellular marrow that is mostly fat with rare hematopoietic elements. This patient has the opposite finding.\", \"3\": \"Mobilization from the niche into the peripheral blood is a normal, inducible process exploited to harvest stem cells for transplantation; it depends on loss of adhesion to the extracellular matrix and does not produce marrow replacement by immature cells.\"}, \"eli5\": \"Blood stem cells are supposed to do two things: make copies of themselves and grow up into working blood cells. In leukemia they keep making copies but never grow up. The marrow fills with useless half-made cells and pushes out the ones that carry oxygen and stop bleeding.\"}, {\"stem\": \"A 68-year-old man comes to the office for routine follow-up. He has end-stage renal disease due to type 2 diabetes mellitus and has been on maintenance hemodialysis for 3 years. He reports fatigue and dyspnea when climbing a flight of stairs but has had no melena, hematuria, or heavy bleeding, and he takes no anticoagulants. Vital signs are within normal limits. Physical examination shows conjunctival pallor; the abdomen is soft and nontender without organomegaly, and stool is negative for occult blood. Laboratory studies show hemoglobin 8.4 g/dL, hematocrit 25%, mean corpuscular volume 90 fL, ferritin 190 ng/mL, transferrin saturation 28%, and a reticulocyte count of 0.5%. Which of the following additional findings is most likely in this patient?\", \"choices\": [\"A. Elevated serum erythropoietin level\", \"B. Elevated serum methylmalonic acid level\", \"C. Hypersegmented neutrophils on peripheral smear\", \"D. Inappropriately low serum erythropoietin level\", \"E. Schistocytes and helmet cells on peripheral smear\"], \"correct\": 3, \"explanation\": \"The kidney continuously senses tissue oxygen delivery and releases erythropoietin (EPO), which drives erythroid progenitor division and pushes reticulocytes into the blood. In end-stage renal disease the sensor and the source of the signal are the same failed organ -> the marrow is never told to build -> a normocytic anemia with a low reticulocyte count despite adequate iron stores. In any other anemia of this severity the EPO level would be high; here it is inappropriately low for the degree of anemia. Treatment is an erythropoiesis-stimulating agent, after iron stores are confirmed adequate, since the order is useless without the raw material.\\nEducational objective: Anemia of chronic kidney disease results from deficient erythropoietin production and is normocytic with a low reticulocyte count and normal iron studies. The erythropoietin level is inappropriately low for the degree of anemia, in contrast to every other cause, in which it rises.\", \"wrongExplanations\": {\"0\": \"An elevated erythropoietin level is the expected, appropriate response to anemia or hypoxia when the kidneys are intact, as in blood loss, hemolysis, or residence at high altitude. It is precisely the response this patient cannot mount.\", \"1\": \"An elevated methylmalonic acid level indicates vitamin B12 (cobalamin) deficiency and is accompanied by a macrocytic anemia with neurologic findings. This patient's mean corpuscular volume is 90 fL, which excludes megaloblastic anemia.\", \"2\": \"Hypersegmented neutrophils, with six or more nuclear lobes, reflect defective DNA synthesis and point specifically to B12 or folate deficiency. They are absent in a normocytic anemia of impaired erythropoietin signaling.\", \"4\": \"Schistocytes indicate mechanical fragmentation of erythrocytes in microangiopathic hemolytic anemia, which would produce a high reticulocyte count with elevated lactate dehydrogenase and low haptoglobin. This patient's reticulocyte count is 0.5%, indicating a production problem rather than destruction.\"}, \"eli5\": \"The kidney is the part of the body that notices when oxygen is running low and shouts an order to the bone marrow to build more red cells. When the kidney fails, nobody shouts the order. The bricks are all there, but no one is telling the factory to work.\"}, {\"stem\": \"A 34-year-old woman with acute myeloid leukemia in first complete remission is admitted to the hospital for an allogeneic hematopoietic stem cell transplant from a matched sibling donor. Beginning 7 days before the planned stem cell infusion, she receives high-dose chemotherapy. She is counseled that she will become profoundly pancytopenic and will require transfusion support and isolation until engraftment. A marrow biopsy obtained on the day of infusion would be expected to be markedly hypocellular. Which of the following best describes the purpose of the high-dose chemotherapy administered before the stem cell infusion?\", \"choices\": [\"A. Ablation of the marrow niche and suppression of host immunity\", \"B. Direct stimulation of osteoblasts lining the bone trabeculae\", \"C. Increased renal secretion of erythropoietin\", \"D. Mobilization of donor stem cells into the peripheral blood\", \"E. Suppression of hepatic thrombopoietin synthesis\"], \"correct\": 0, \"explanation\": \"Hematopoietic stem cells do not float free; they occupy a structured niche of stromal cells, extracellular matrix, sinusoidal vessels, and signaling molecules that balances quiescence against activation. A graft cannot engraft into an occupied niche. Conditioning chemotherapy therefore serves three purposes at once: it empties the niche so donor cells have physical space and signaling support, it suppresses recipient immunity so the graft is not rejected, and in malignancy it kills residual leukemic cells. The expected consequence is a transiently hypocellular, essentially empty-appearing marrow, which reflects the treatment working rather than failing.\\nEducational objective: Conditioning chemotherapy before hematopoietic stem cell transplantation ablates the recipient marrow to vacate the stem cell niche, suppresses host immunity to prevent graft rejection, and eliminates residual malignant cells. A markedly hypocellular marrow at the time of infusion is the intended result, not a treatment failure.\", \"wrongExplanations\": {\"1\": \"Osteoblasts along the endosteal bone surface are stromal components that anchor stem cells and secrete retention signals, and they are targets in experimental niche-directed therapy. Cytotoxic conditioning damages rather than stimulates the niche.\", \"2\": \"Increased renal erythropoietin secretion is the goal of erythropoiesis-stimulating agents given for anemia of chronic kidney disease. Erythropoietin acts on committed erythroid progenitors and cannot create space for a graft.\", \"3\": \"Mobilization into the peripheral blood, achieved with granulocyte colony-stimulating factor or plerixafor by disrupting stem cell adhesion to the extracellular matrix, is performed in the donor before collection. It is a harvesting maneuver, not a recipient conditioning maneuver.\", \"4\": \"Suppression of thrombopoietin synthesis would worsen the thrombocytopenia that already complicates transplantation and serves no therapeutic purpose. Thrombopoietin receptor agonists are used to raise platelet counts, for example in immune thrombocytopenia.\"}, \"eli5\": \"Stem cells need a room to live in inside the bone, and all the rooms are already taken. Strong chemotherapy empties the hotel so the donated cells have somewhere to check in. That is why the marrow looks empty right before the transplant, and that is exactly what is supposed to happen.\"}, {\"stem\": \"A 45-year-old woman comes to the office due to fatigue and dyspnea when climbing stairs that used to be easy, present for the past 4 months. She has no chronic medical conditions and takes no daily medications. Vital signs are within normal limits. Physical examination shows pallor of the conjunctivae and palmar creases; the remainder of the examination is normal. A capillary blood sample is drawn and centrifuged in a microhematocrit tube. The packed red column occupies 24% of the total height of the column of blood, and the plasma layer above it is straw-yellow with no pink discoloration. Which of the following is the best estimate of this patient's hemoglobin concentration?\", \"choices\": [\"A. 4 g/dL\", \"B. 6 g/dL\", \"C. 8 g/dL\", \"D. 12 g/dL\", \"E. 16 g/dL\"], \"correct\": 2, \"explanation\": \"Hematocrit is the percentage of whole blood volume occupied by erythrocytes, measured physically as the height of the packed red column after centrifugation; it is also called the packed cell volume. Hemoglobin is measured chemically by spectrophotometry and reported in g/dL. The two describe the same red cell mass and are related by the approximation hematocrit is roughly three times the hemoglobin. A hematocrit of 24% therefore corresponds to a hemoglobin near 8 g/dL, which is well below the female reference range and consistent with her exertional dyspnea and pallor. The straw-yellow plasma is normal; pink or red plasma would indicate free hemoglobin from intravascular hemolysis.\\nEducational objective: Hematocrit is approximately three times the hemoglobin concentration. This approximation is used to sanity-check laboratory values that appear discordant; a normal spun plasma layer is straw-yellow, whereas pink plasma indicates intravascular hemolysis.\", \"wrongExplanations\": {\"0\": \"A hemoglobin of 4 g/dL would pair with a hematocrit near 12% and represents profound, usually transfusion-requiring anemia with resting dyspnea and hemodynamic compromise. This patient's packed cell column is twice that height.\", \"1\": \"A hemoglobin of 6 g/dL corresponds to a hematocrit near 18% and is the level at which many patients develop symptoms at rest. It does not match a measured 24% column.\", \"3\": \"A hemoglobin of 12 g/dL corresponds to a hematocrit near 36% and sits at the lower end of the normal female range of roughly 37%-47%. This would not explain conjunctival and palmar pallor.\", \"4\": \"A hemoglobin of 16 g/dL corresponds to a hematocrit near 48%, a normal-to-high value seen in adult men and in polycythemia. An elevated hematocrit is polycythemia, the opposite of this patient's problem.\"}, \"eli5\": \"If you spin a tube of blood, the red cells sink and you can measure how tall that red layer is; that percentage is the hematocrit. There is a handy shortcut: the hematocrit is about three times the hemoglobin number. So a red layer of 24% means a hemoglobin of about 8.\"}, {\"stem\": \"A 28-year-old woman is brought to the emergency department due to abdominal pain after a high-speed motor vehicle collision 30 minutes ago. She has no chronic medical conditions. Blood pressure is 84/52 mm Hg and pulse is 132/min. Physical examination shows a distended, diffusely tender abdomen with a seat-belt contusion across the lower abdominal wall, and the extremities are cool with delayed capillary refill. Focused ultrasonography shows free intraperitoneal fluid. Complete blood count obtained on arrival shows hemoglobin 13.6 g/dL, hematocrit 41%, mean corpuscular volume 89 fL, and platelet count 240,000/mm3. Which of the following best explains this patient's initial hemoglobin concentration?\", \"choices\": [\"A. Compensatory reticulocytosis released from the marrow\", \"B. Loss of plasma and erythrocytes in equal proportion\", \"C. Redistribution of iron from macrophage stores\", \"D. Splenic contraction releasing sequestered erythrocytes\", \"E. Suppression of hepcidin with increased iron absorption\"], \"correct\": 1, \"explanation\": \"Hemoglobin and hematocrit are concentration measurements, not measurements of total red cell mass. In acute hemorrhage the patient loses whole blood -> plasma and erythrocytes leave the vasculature in the same proportion -> the concentration is initially unchanged, even with life-threatening blood loss. The value falls only over hours, as interstitial fluid shifts into the intravascular space or resuscitation fluid is given. The immediate threat is intravascular volume, and management is directed at hemodynamics and the bleeding source, not at the reassuring number on the complete blood count.\\nEducational objective: Hemoglobin and hematocrit measure concentration, so they are normal immediately after acute hemorrhage because plasma and erythrocytes are lost in equal proportion. The values fall only after fluid shifts or resuscitation dilute the remaining red cell mass; management is guided by hemodynamics, not the initial value.\", \"wrongExplanations\": {\"0\": \"A compensatory reticulocytosis does raise the red cell count after blood loss, but it requires several days of erythropoietin-driven marrow response and cannot occur within 30 minutes. It also would not maintain a normal hemoglobin at the moment of the bleed.\", \"2\": \"Redistribution of iron from macrophage stores replenishes erythropoiesis over days to weeks and is regulated by hepcidin and ferroportin. Mobilizing stored iron does not create circulating erythrocytes acutely.\", \"3\": \"Splenic contraction meaningfully augments circulating red cell mass in animals such as dogs and horses, in which the spleen is a reservoir organ. The human spleen holds too small a fraction of the red cell mass to preserve the hemoglobin during major hemorrhage.\", \"4\": \"Suppressed hepcidin with increased duodenal iron absorption is the appropriate chronic adaptation to iron loss and to increased erythropoietic drive. It operates over weeks and has no effect on an immediate post-traumatic hemoglobin value.\"}, \"eli5\": \"When you bleed, you lose the red cells and the liquid they float in at the same time, so what is left is just as red as before. The blood test measures how concentrated the blood is, not how much of it you have. That is why a normal number right after a car crash can fool you.\"}, {\"stem\": \"A 61-year-old man comes to the office due to fatigue and dyspnea on exertion for the past 4 months. He has hypertension treated with amlodipine and reports no abdominal pain, change in bowel habits, or visible blood in the stool. He has smoked a pack of cigarettes daily for 35 years. Vital signs are within normal limits. Physical examination shows conjunctival pallor and koilonychia; the abdomen is soft and nontender without organomegaly, and rectal examination shows no mass. Laboratory studies show hemoglobin 10.4 g/dL, hematocrit 31%, mean corpuscular volume 71 fL, red cell distribution width 18.6% (N=11.5-14.5), ferritin 6 ng/mL, total iron binding capacity increased, and transferrin saturation 7%. In addition to iron repletion, which of the following is the most appropriate next step in management of this patient?\", \"choices\": [\"A. Bone marrow aspiration and biopsy\", \"B. Colonoscopy\", \"C. Measurement of serum erythropoietin\", \"D. Measurement of serum methylmalonic acid\", \"E. Transfusion of packed red blood cells\"], \"correct\": 1, \"explanation\": \"The microcytic, hypochromic anemia with a ferritin of 6 ng/mL, an increased total iron binding capacity, and a transferrin saturation of 7% establishes iron deficiency. Iron deficiency is a symptom, not a final diagnosis, and the question that must always follow is where the iron went. Dietary lack is uncommon in an adult man with abundant food, and there is no menstrual loss; chronic occult gastrointestinal blood loss is the dominant cause in the Western world. Colonic adenocarcinoma can present with iron deficiency anemia and nothing else, because the loss is slow, insidious, and invisible in the stool. Iron deficiency in an adult male or postmenopausal woman is therefore due to gastrointestinal blood loss until proven otherwise, and mandates endoscopic evaluation.\\nEducational objective: Iron deficiency anemia in an adult man or a postmenopausal woman should be attributed to gastrointestinal blood loss until proven otherwise and requires endoscopic evaluation, because colorectal adenocarcinoma may present with anemia alone. Prescribing iron without identifying the source misses the diagnosis that matters.\", \"wrongExplanations\": {\"0\": \"Bone marrow aspiration and biopsy are reserved for suspected primary marrow disease, such as unexplained pancytopenia, suspected leukemia or myelodysplasia, lymphoma staging, or confirmation of remission. Iron deficiency is diagnosed from peripheral blood, and this patient's iron studies are already definitive.\", \"2\": \"Serum erythropoietin measurement is useful in anemia of chronic kidney disease, in which the level is inappropriately low for the degree of anemia, and in evaluating polycythemia. This patient has normocytic renal function issues neither suggested nor supported by his iron-deficient indices.\", \"3\": \"Methylmalonic acid is measured to separate vitamin B12 deficiency, in which it is elevated, from folate deficiency, in which it is normal. Both produce macrocytosis with hypersegmented neutrophils, whereas this patient's mean corpuscular volume is 71 fL.\", \"4\": \"Transfusion is indicated for hemodynamic instability or symptomatic severe anemia, typically at much lower hemoglobin levels. This patient is stable with a hemoglobin of 10.4 g/dL and will respond to iron repletion, with a reticulocyte rise expected within about a week.\"}, \"eli5\": \"Running low on iron is a clue, not the whole answer, because the real question is where the iron is leaking out. In a grown man there are no periods to blame, so the usual leak is slow bleeding from the gut. Sometimes a colon cancer is the only thing causing it, so doctors look inside with a camera.\"}, {\"stem\": \"A 32-year-old woman comes to the office due to fatigue and lightheadedness for the past 5 months. She reports menstrual periods lasting 8 days that require changing a pad every 2 hours on the heaviest days. She has no chronic medical conditions and takes no daily medications. Vital signs are within normal limits. Physical examination shows pallor of the conjunctivae and nail beds; the abdomen is soft and nontender. Laboratory studies show hemoglobin 9.2 g/dL, hematocrit 28%, and mean corpuscular volume 70 fL. Peripheral smear shows small erythrocytes with an enlarged central pale zone occupying more than half of each cell, and ferritin is 5 ng/mL. Which of the following mechanisms best explains the reduced size of this patient's erythrocytes?\", \"choices\": [\"A. Additional divisions before a target hemoglobin concentration is reached\", \"B. Arrest of nuclear division with continued cytoplasmic maturation\", \"C. Impaired globin chain synthesis with precipitation of unpaired chains\", \"D. Retention of ribosomal RNA within newly released erythrocytes\", \"E. Sequestration of iron within reticuloendothelial macrophages\", \"F. Suppression of erythroid proliferation by inflammatory cytokines\"], \"correct\": 0, \"explanation\": \"An erythroid precursor divides while it accumulates hemoglobin and stops dividing only once it reaches a target intracellular hemoglobin concentration. In iron deficiency the precursor cannot reach that concentration on schedule -> it undergoes one or two extra divisions before maturing -> each division halves the cell. One mechanism therefore produces both findings at once: the cell is hypochromic because there is too little hemoglobin to fill it, and microcytic because of the extra divisions. This is the exact opposite of vitamin B12 and folate deficiency, in which the cytoplasm matures normally while nuclear division stalls, so the cell ends up too large.\\nEducational objective: Iron deficiency produces a hypochromic microcytic anemia because erythroid precursors undergo extra divisions while failing to reach the target hemoglobin concentration that normally halts division. Vitamin B12 and folate deficiency do the reverse, arresting nuclear division while the cytoplasm matures, yielding macrocytes.\", \"wrongExplanations\": {\"1\": \"Arrested nuclear division with continued cytoplasmic maturation is nuclear-cytoplasmic asynchrony, the mechanism of megaloblastic anemia from B12 or folate deficiency. It produces macro-ovalocytes and hypersegmented neutrophils, with a mean corpuscular volume above 100 fL.\", \"2\": \"Impaired globin chain synthesis with precipitation of unpaired chains describes thalassemia, which also causes microcytosis but with normal or high iron studies, a normal-to-high red blood cell count, and a normal red cell distribution width. This patient's ferritin of 5 ng/mL establishes true iron deficiency.\", \"3\": \"Retained ribosomal RNA defines the reticulocyte, which is slightly larger than a mature erythrocyte; a marked reticulocytosis raises rather than lowers the mean corpuscular volume. Reticulocytes are low in a production-failure anemia such as this one.\", \"4\": \"Sequestration of iron in reticuloendothelial macrophages is the hepcidin-driven mechanism of anemia of chronic disease, which is usually normocytic and shows a high ferritin with a low total iron binding capacity. This patient's ferritin is 5 ng/mL, meaning the stores are empty rather than locked.\", \"5\": \"Direct cytokine suppression of erythroid precursors is another arm of anemia of inflammation and reduces the number of cells produced rather than their size. There is no inflammatory illness in this patient, whose loss is menstrual.\"}, \"eli5\": \"A young red cell keeps dividing until it is stuffed full of hemoglobin, and then it stops. Without iron it can never get full, so it divides a couple of extra times and each division makes it smaller. That is why iron-poor blood cells end up both pale and tiny.\"}, {\"stem\": \"A 25-year-old woman comes to the office due to fatigue, shortness of breath on exertion, and pale skin for the past 3 months. She reports a daily craving to crunch and chew ice, which she has satisfied several times an hour for several weeks. Her menstrual periods have been heavy since menarche, and she has followed a vegetarian diet for 6 years. She has no chronic medical conditions and takes no daily medications. Blood pressure is 106/64 mm Hg and pulse is 104/min. Physical examination shows marked conjunctival pallor and a soft systolic flow murmur; the abdomen is soft and nontender with no organomegaly, and there is no lymphadenopathy. Laboratory studies show hemoglobin 7.0 g/dL, hematocrit 21%, and mean corpuscular volume 74 fL. Which of the following sets of laboratory findings is most likely in this patient?\\n\\n     Serum iron | Ferritin | Total iron binding capacity\", \"choices\": [\"A. Decreased | Decreased | Decreased\", \"B. Decreased | Decreased | Increased\", \"C. Decreased | Increased | Decreased\", \"D. Increased | Decreased | Increased\", \"E. Increased | Increased | Decreased\", \"F. Normal | Normal | Normal\"], \"correct\": 1, \"explanation\": \"Chronic menstrual loss plus a diet low in bioavailable iron -> depletion of storage iron first -> iron deficiency anemia, and pagophagia (craving ice) is a distinctive associated clue. Ferritin reflects total body stores and is the earliest value to fall. Serum iron falls because less iron is circulating. Total iron binding capacity measures transferrin binding sites not occupied by iron: picture transferrin carrying cups, most of them empty, so the capacity to bind more iron is high; the liver also increases transferrin synthesis. Transferrin saturation is therefore low, typically under 15%, and marrow Prussian blue staining would show absent iron.\\nEducational objective: Iron deficiency anemia shows low serum iron, low ferritin, increased total iron binding capacity, and a transferrin saturation under 15%. Total iron binding capacity rises because unoccupied transferrin binding sites increase, the reverse of anemia of chronic disease, in which it falls.\", \"wrongExplanations\": {\"0\": \"Low serum iron with low ferritin and low total iron binding capacity is the pattern of combined iron deficiency and inflammation, or of protein-calorie malnutrition, in which transferrin synthesis is also reduced. This patient has no inflammatory or malnourishing illness, so the compensatory rise in transferrin is intact.\", \"2\": \"Low serum iron with high ferritin and low total iron binding capacity is the signature of anemia of chronic disease, in which hepcidin traps iron inside macrophages. That patient has a chronic infection, immune disorder, or neoplasm, none of which is present here.\", \"3\": \"High serum iron with low ferritin and high total iron binding capacity is an internally inconsistent set that corresponds to no real entity, since abundant circulating iron would saturate the available binding sites.\", \"4\": \"High serum iron with high ferritin and low total iron binding capacity occurs in iron overload states such as hereditary hemochromatosis and in sideroblastic anemia, in which iron is plentiful but cannot be incorporated into heme. Those patients are not iron depleted.\", \"5\": \"Entirely normal iron studies with microcytosis suggest thalassemia trait, which also shows a normal-to-high red blood cell count and a normal red cell distribution width. That picture does not fit a patient with years of menorrhagia, a restricted diet, and pica.\"}, \"eli5\": \"Think of the iron carrier in blood as a tray of cups. When your iron tank is empty, most cups ride around with nothing in them, so the tray's spare capacity is high. Empty tank, empty cups, big capacity, and that is iron deficiency.\"}, {\"stem\": \"A 71-year-old woman comes to the office due to fatigue and mild dyspnea on exertion for the past 6 months. Her medical conditions include seropositive rheumatoid arthritis of 22 years' duration with persistently swollen wrists and metacarpophalangeal joints. She reports no melena, hematuria, or heavy vaginal bleeding, and she has not been pregnant since menopause at age 51. Vital signs are within normal limits. Physical examination shows pallor and symmetric ulnar deviation of the fingers with synovial thickening; stool is negative for occult blood. Laboratory studies show hemoglobin 9.5 g/dL, hematocrit 29%, mean corpuscular volume 88 fL, reticulocyte count 0.7%, and an elevated C-reactive protein. Which of the following sets of findings is most likely in this patient?\\n\\n     Serum iron | Ferritin | Total iron binding capacity | Marrow macrophage iron\", \"choices\": [\"A. Decreased | Decreased | Increased | Absent\", \"B. Decreased | Increased | Decreased | Increased\", \"C. Decreased | Normal | Increased | Absent\", \"D. Increased | Increased | Decreased | Increased\", \"E. Normal | Normal | Normal | Normal\"], \"correct\": 1, \"explanation\": \"Chronic inflammation -> interleukin-6 -> hepatic hepcidin synthesis -> degradation of ferroportin, the only iron export channel on macrophages and enterocytes -> recycled and dietary iron is trapped where it sits. Serum iron therefore falls although total body iron is normal or increased, and marrow macrophages are loaded with iron. Ferritin rises both because stores are full and because it is a positive acute phase reactant. Transferrin is a negative acute phase reactant, so fewer binding sites exist and the total iron binding capacity falls. Cytokines additionally blunt erythropoietin release and directly suppress erythroid proliferation, producing the low reticulocyte count.\\nEducational objective: Anemia of chronic disease is driven by interleukin-6-induced hepcidin, which degrades ferroportin and sequesters iron in macrophages. Ferritin is high and total iron binding capacity is low, the mirror image of iron deficiency; serum iron is low in both conditions and therefore discriminates nothing.\", \"wrongExplanations\": {\"0\": \"Low serum iron with low ferritin, high total iron binding capacity, and absent marrow iron is classic iron deficiency, seen with chronic gastrointestinal or menstrual loss. This patient has no bleeding source, a negative occult blood test, and active systemic inflammation.\", \"2\": \"Low serum iron with a normal ferritin, high binding capacity, and absent marrow iron describes early or inflammation-masked iron deficiency, in which ferritin is falsely normal because it is an acute phase reactant. The discriminator would be a high rather than low total iron binding capacity, and the marrow stain would show no iron.\", \"3\": \"High serum iron with high ferritin, low binding capacity, and abundant marrow iron occurs in iron overload states such as hereditary hemochromatosis and in sideroblastic anemia. Serum iron is low, not high, when hepcidin blocks export from macrophages.\", \"4\": \"Entirely normal iron studies would be expected in anemia of chronic kidney disease, in which the defect is deficient erythropoietin rather than iron handling. That patient has a rising creatinine and an inappropriately low erythropoietin level.\"}, \"eli5\": \"In long-lasting inflammation, the body hides its iron inside storage cells and locks the doors so germs cannot use it. The iron is in the building; it just cannot get out to the blood factory. That is why the storage number looks high while the amount floating in blood looks low.\"}, {\"stem\": \"A 58-year-old man comes to the office for follow-up of anemia. He has had chronic osteomyelitis of the left tibia for 5 months following an open fracture and continues to have purulent drainage from a sinus tract. Six weeks ago he was found to have hemoglobin 9.8 g/dL, mean corpuscular volume 88 fL, low serum iron, ferritin 480 ng/mL, decreased total iron binding capacity, and a reticulocyte count of 0.6%, and oral ferrous sulfate three times daily was started. He reports full adherence and no vomiting or diarrhea. Vital signs are within normal limits. Repeat laboratory studies show hemoglobin 9.7 g/dL with unchanged indices. Which of the following best explains the failure of oral iron therapy in this patient?\", \"choices\": [\"A. Autoantibodies directed against gastric parietal cells\", \"B. Competitive uptake of dietary iron by intestinal bacteria\", \"C. Hepcidin-mediated degradation of enterocyte ferroportin\", \"D. Loss of the duodenal ferric reductase that generates Fe2+\", \"E. Reduced hepatic synthesis of transferrin\", \"F. Saturation of transcobalamin II binding sites\"], \"correct\": 2, \"explanation\": \"Chronic infection -> interleukin-6 -> hepatic hepcidin release -> degradation of ferroportin, the sole iron export channel on duodenal enterocytes and macrophages. Iron absorbed into the enterocyte cannot be exported to plasma, and iron recycled from senescent erythrocytes cannot leave the macrophage. The problem is iron release, not iron supply, which is why the ferritin is 480 ng/mL and marrow macrophages are iron-loaded while serum iron stays low. Adding more oral iron simply pushes iron at a locked door. The correct management is control of the underlying infection, with an erythropoiesis-stimulating agent considered only if the patient is symptomatic.\\nEducational objective: In anemia of chronic disease, interleukin-6-driven hepcidin degrades ferroportin and blocks iron export from enterocytes and macrophages, so oral iron is ineffective. Treatment is directed at the underlying inflammatory condition, which corrects the anemia.\", \"wrongExplanations\": {\"0\": \"Anti-parietal cell antibodies are found in 85%-90% of patients with pernicious anemia and cause loss of intrinsic factor and vitamin B12 malabsorption. That produces a macrocytic anemia with hypersegmented neutrophils, not a normocytic anemia with a high ferritin.\", \"1\": \"Competitive uptake of a nutrient by intestinal organisms is the mechanism of B12 deficiency in small intestinal bacterial overgrowth and in Diphyllobothrium latum infection. It is not a recognized cause of iron malabsorption, and this patient's iron stores are abundant rather than depleted.\", \"3\": \"Loss of duodenal reduction of Fe3+ to the absorbable Fe2+ form contributes to malabsorptive iron deficiency, as in celiac disease, gastrectomy, and acid suppression. Those patients have a low ferritin and a high total iron binding capacity, the opposite of this pattern.\", \"4\": \"Reduced transferrin synthesis does occur here, since transferrin is a negative acute phase reactant, and it explains the low total iron binding capacity. It does not explain why supplemental iron never reaches the plasma, which requires a block in cellular export.\", \"5\": \"Transcobalamin II is the plasma carrier that delivers absorbed vitamin B12 to tissues and has nothing to do with iron transport, which uses transferrin. Its saturation would not affect erythropoiesis in a normocytic, iron-sequestered anemia.\"}, \"eli5\": \"Iron leaves a gut cell through a single doorway. During long infections the body makes a hormone that destroys that doorway on purpose, to starve germs of iron. Swallowing more iron pills does nothing when the door itself is gone.\"}, {\"stem\": \"An investigator is studying the prevalence of iron deficiency among patients hospitalized with active rheumatoid arthritis and other chronic inflammatory conditions. Iron deficiency is defined solely by a serum ferritin below 30 ng/mL, and every patient above that threshold is classified as iron replete. Bone marrow aspirates obtained for unrelated indications in a validation subgroup are stained with Prussian blue, and a substantial proportion of patients whose serum ferritin exceeded the threshold are found to have completely absent stainable marrow iron. The proportion of patients misclassified in the opposite direction is negligible. Which of the following effects will this measurement approach most likely have on the reported results of the study?\", \"choices\": [\"A. Increased random error without a systematic shift in prevalence\", \"B. No effect, because serum ferritin directly reflects total body iron stores\", \"C. Overestimation of the prevalence of iron deficiency\", \"D. Selection bias toward patients with more severe anemia\", \"E. Underestimation of the prevalence of iron deficiency\"], \"correct\": 4, \"explanation\": \"Ferritin is a positive acute phase reactant: it rises in inflammation, infection, liver disease, and malignancy regardless of iron stores. In an inflamed population, a genuinely iron-deficient patient can therefore show a normal or even elevated ferritin -> truly deficient patients are classified as replete -> systematic misclassification in one direction only. Because the error moves cases into the noncase group and essentially never the reverse, the measured prevalence is systematically lower than the truth. This is the same reason iron studies must be read as a panel in sick patients: ferritin is interpreted alongside transferrin saturation, total iron binding capacity, C-reactive protein, and, when needed, a marrow iron stain.\\nEducational objective: Ferritin is an acute phase reactant, so it may be normal or elevated in an inflamed patient who is genuinely iron deficient. Using ferritin alone in an inflammatory population produces one-directional misclassification of true cases as noncases and systematically underestimates prevalence.\", \"wrongExplanations\": {\"0\": \"Nondifferential, random measurement error occurs when misclassification is equally likely in both directions, and it biases estimates of association toward the null without systematically shifting a prevalence. Here the error runs in only one direction, since inflammation raises ferritin but does not lower it.\", \"1\": \"Serum ferritin does reflect total body stores in a patient without inflammation, which is why it is the earliest and most useful marker in uncomplicated iron deficiency. The validation subgroup here directly demonstrates the failure of that assumption in inflamed patients.\", \"2\": \"Overestimation would require patients with adequate stores to be labeled deficient, which happens when a threshold is set too high or when a marker falls for reasons other than iron loss. The stated misclassification runs the other way.\", \"3\": \"Selection bias arises from how participants enter a study, for example by sampling only transfused or symptomatic patients. The flaw described here is in how the exposure or condition is measured within an already assembled cohort, which is information bias.\"}, \"eli5\": \"Ferritin is supposed to be the fuel gauge for iron, but inflammation pushes the needle up even when the tank is empty. So in sick patients, a normal-looking gauge can hide real iron deficiency. A study that trusts the gauge alone will count too few deficient patients.\"}, {\"stem\": \"A 41-year-old woman comes to the office due to fatigue and tingling in both feet for the past 4 months. She has Crohn disease and underwent resection of 35 cm of terminal ileum 4 years ago; she takes azathioprine and reports two to three formed stools daily. She has never had gastric surgery, follows an omnivorous diet, and drinks no alcohol. Vital signs are within normal limits. Physical examination shows pallor, a smooth beefy-red tongue, and reduced vibration sense at both great toes. Laboratory studies show hemoglobin 9.6 g/dL, mean corpuscular volume 114 fL, and a reticulocyte count of 0.5%; peripheral smear shows oval macrocytes and neutrophils with six or more nuclear lobes. Serum folate is normal, methylmalonic acid is elevated, and anti-intrinsic factor antibody is negative. Impairment of which of the following steps is most likely responsible for this patient's condition?\", \"choices\": [\"A. Binding of cobalamin to haptocorrin in the stomach\", \"B. Binding of cobalamin to transcobalamin II in the plasma\", \"C. Cleavage of the haptocorrin-cobalamin complex by pancreatic proteases\", \"D. Liberation of cobalamin from dietary protein by gastric acid and pepsin\", \"E. Secretion of intrinsic factor by gastric parietal cells\", \"F. Uptake of the cobalamin-intrinsic factor complex in the ileum\"], \"correct\": 5, \"explanation\": \"Vitamin B12 (cobalamin) absorption is a long relay: gastric acid and pepsin liberate B12 from food protein -> salivary haptocorrin carries it through the stomach -> pancreatic proteases strip haptocorrin in the duodenum -> B12 binds intrinsic factor from gastric parietal cells -> the complex is taken up by cubilin receptors in the terminal ileum -> transcobalamin II delivers it to tissues. The terminal ileum is the only site of absorption, so ileal resection or Crohn ileitis interrupts the relay at its final step. Deficiency then impairs both DNA synthesis (megaloblastic anemia with macro-ovalocytes and hypersegmented neutrophils) and myelin maintenance (paresthesias, sensory ataxia, and ultimately subacute combined degeneration). The elevated methylmalonic acid confirms B12 rather than folate deficiency, and the negative anti-intrinsic factor antibody with intact gastric anatomy excludes pernicious anemia.\\nEducational objective: The cobalamin-intrinsic factor complex is absorbed exclusively by cubilin receptors in the terminal ileum, so ileal resection, Crohn ileitis, or bacterial overgrowth causes vitamin B12 deficiency despite normal gastric function. An elevated methylmalonic acid distinguishes B12 from folate deficiency, which leaves it normal.\", \"wrongExplanations\": {\"0\": \"Failure of haptocorrin binding would occur with severe salivary gland dysfunction and is a vanishingly rare cause of deficiency, since haptocorrin merely protects B12 during gastric transit. This patient's stomach and salivary function are intact.\", \"1\": \"Impaired binding to transcobalamin II is a rare congenital transport defect that presents in infancy with megaloblastic anemia and failure to thrive despite normal absorption. It would not follow an ileal resection in adulthood.\", \"2\": \"Failure of pancreatic proteases to release B12 from haptocorrin causes deficiency in chronic pancreatitis and cystic fibrosis, typically alongside steatorrhea and fat-soluble vitamin deficiency. This patient has formed stools and no evidence of exocrine pancreatic failure.\", \"3\": \"Failure to liberate B12 from dietary protein occurs with atrophic gastritis and with long-term proton pump inhibitor or H2 blocker use, in which acid and pepsin are lacking. This patient has never had gastric surgery and takes no acid-suppressing medication.\", \"4\": \"Loss of intrinsic factor secretion defines pernicious anemia and also follows gastrectomy or bariatric surgery, and it is supported by anti-parietal cell and anti-intrinsic factor antibodies. Her anti-intrinsic factor antibody is negative and her stomach is anatomically intact.\"}, \"eli5\": \"Vitamin B12 has to be passed along a chain of helpers before it can get into the body, and the very last handoff happens in one specific part of the small intestine. If a surgeon removes that part, the vitamin has nowhere to go in. Eating more of it does not help.\"}, {\"stem\": \"A 63-year-old woman comes to the office due to fatigue and numbness of both hands for the past 6 months. She has hypothyroidism treated with levothyroxine and follows an omnivorous diet. She has had no gastrointestinal surgery and takes no acid-suppressing medication. Vital signs are within normal limits. Physical examination shows conjunctival pallor, a smooth tongue, and diminished vibration and position sense in the fingers and toes with an unsteady tandem gait. Laboratory studies show hemoglobin 8.6 g/dL, mean corpuscular volume 118 fL, reticulocyte count 0.4%, and elevated lactate dehydrogenase; the smear shows macro-ovalocytes and hypersegmented neutrophils. Serum vitamin B12 is low, methylmalonic acid is elevated, and anti-intrinsic factor antibody is positive. This patient is at greatest risk for which of the following additional conditions?\", \"choices\": [\"A. Duodenal ulceration from gastric acid hypersecretion\", \"B. Gastric adenocarcinoma\", \"C. Hepatic iron overload\", \"D. Neural tube defect in a future pregnancy\", \"E. Pancreatic exocrine insufficiency\"], \"correct\": 1, \"explanation\": \"Pernicious anemia is autoimmune destruction of the gastric mucosa with loss of parietal cells, which produce both intrinsic factor and gastric acid. Its consequences involve three organs, not one: megaloblastic anemia from B12 deficiency, myelin degeneration of the dorsal and lateral spinal columns (subacute combined degeneration), and chronic atrophic gastritis with intestinal metaplasia, which carries an increased long-term risk of gastric carcinoma and warrants surveillance. Anti-parietal cell antibodies are more sensitive (85%-90%) and anti-intrinsic factor antibodies more specific (about 75%). Because absorption cannot be restored, B12 must be given by a route that bypasses intrinsic factor: intramuscular injection or high-dose oral therapy relying on passive diffusion.\\nEducational objective: Pernicious anemia is autoimmune loss of gastric parietal cells and intrinsic factor, producing megaloblastic anemia, subacute combined degeneration, and atrophic gastritis with intestinal metaplasia that raises the risk of gastric adenocarcinoma. Anti-parietal cell antibodies are more sensitive and anti-intrinsic factor antibodies more specific.\", \"wrongExplanations\": {\"0\": \"Duodenal ulceration from acid hypersecretion occurs with Helicobacter pylori infection and with gastrinoma in Zollinger-Ellison syndrome. Pernicious anemia destroys the acid-secreting parietal cells, producing achlorhydria rather than hypersecretion.\", \"2\": \"Hepatic iron overload results from hereditary hemochromatosis, repeated transfusion, or ineffective erythropoiesis in thalassemia, and presents with a high serum iron, high ferritin, and high transferrin saturation. Autoimmune gastritis does not increase iron absorption; loss of gastric acid tends to impair it.\", \"3\": \"Neural tube defects are prevented by periconceptional folate and are the reason folate is in every prenatal vitamin. This patient is 63 years old and her deficiency is of B12, not folate.\", \"4\": \"Pancreatic exocrine insufficiency arises in chronic pancreatitis and cystic fibrosis and causes B12 deficiency by preventing cleavage of the haptocorrin-cobalamin complex, along with steatorrhea. It is not a consequence of autoimmune gastritis.\"}, \"eli5\": \"In pernicious anemia the immune system attacks the stomach lining itself, not just the vitamin factory inside it. Over years that damaged lining can change into something abnormal and eventually into stomach cancer. So these patients need their stomach watched, not just their vitamin levels topped up.\"}, {\"stem\": \"A 58-year-old man is evaluated for gait difficulty. He has followed a strict vegan diet for 20 years and was found 8 weeks ago to have hemoglobin 8.8 g/dL, mean corpuscular volume 116 fL, and hypersegmented neutrophils on smear, along with paresthesias of both feet. Folic acid 1 mg daily was started at that visit and no other testing was performed. He reports excellent adherence. Vital signs are within normal limits. Repeat laboratory studies show hemoglobin 13.1 g/dL and mean corpuscular volume 92 fL with resolution of the hypersegmented neutrophils. However, he now has a wide-based unsteady gait, absent vibration sense to the knees, and a positive Romberg sign. Which of the following best explains this patient's neurologic deterioration?\", \"choices\": [\"A. Direct neurotoxicity of supraphysiologic doses of folic acid\", \"B. Folate-induced depletion of pyridoxine and riboflavin stores\", \"C. Iron deficiency precipitated by accelerated erythropoiesis\", \"D. Persistent cobalamin deficiency with methylmalonic acidemia\", \"E. Thiamine deficiency precipitated by carbohydrate refeeding\"], \"correct\": 3, \"explanation\": \"Vitamin B12 (cobalamin) has two jobs: it is required for DNA synthesis, a role it shares with folate, and it is required for maintenance of the myelin surrounding neurons, a role it does not share. Folate can substitute for B12 in the thymidine pathway -> nuclear maturation resumes -> the megaloblastic anemia and hypersegmented neutrophils correct handsomely. Nothing supplies the second job: methylmalonyl-CoA mutase remains B12 dependent, methylmalonic acid continues to accumulate, and demyelination of the dorsal and lateral spinal columns advances toward irreversible subacute combined degeneration. A strict vegan diet is a genuine cause of B12 deficiency because plants contain almost no cobalamin. A serum B12 level must always be obtained before treating a macrocytic anemia with folate.\\nEducational objective: Folate corrects the megaloblastic anemia of vitamin B12 deficiency but has no effect on its neurologic manifestations, which continue to progress toward irreversible subacute combined degeneration. Always check a B12 level before treating macrocytic anemia with folic acid.\", \"wrongExplanations\": {\"0\": \"Folic acid has an extremely wide therapeutic margin and is not directly neurotoxic even at supraphysiologic doses. The clinical harm of folate in this setting comes from masking a coexisting B12 deficiency, not from the drug itself.\", \"1\": \"Pyridoxine deficiency does cause a peripheral neuropathy and a sideroblastic (microcytic) anemia, and it classically follows isoniazid therapy. It is not induced by folate supplementation, and this patient's anemia was macrocytic.\", \"2\": \"Iron deficiency can emerge when a brisk erythropoietic response consumes stores, but it causes a falling mean corpuscular volume and fatigue rather than dorsal column dysfunction. His hemoglobin normalized to 13.1 g/dL with a normal mean corpuscular volume.\", \"4\": \"Thiamine deficiency causes dry beriberi and Wernicke encephalopathy with ophthalmoplegia, ataxia, and confusion, most often in chronic alcohol use or severe malnutrition. It does not produce isolated loss of vibration and position sense with a positive Romberg sign, and it would not have been corrected or worsened by folate.\"}, \"eli5\": \"Vitamin B12 does two jobs: it helps build DNA and it keeps the insulation on your nerves healthy. Folate can cover the first job, so the blood test looks fixed and everyone relaxes. But nothing is covering the second job, and the nerves quietly keep getting worse.\"}, {\"stem\": \"A 66-year-old woman is admitted to the hospital due to progressive weakness and confusion over the past 3 months. She underwent partial gastrectomy for peptic ulcer disease 15 years ago. Vital signs are within normal limits. Physical examination shows marked pallor and mild ataxia. Laboratory studies show hemoglobin 6.8 g/dL, mean corpuscular volume 120 fL, leukocyte count 3,200/mm3, and platelet count 108,000/mm3. Bone marrow aspiration shows a markedly hypercellular marrow containing enlarged erythroid precursors with abundant hemoglobinized cytoplasm but fine, delicate, open nuclear chromatin, together with giant band forms and giant metamyelocytes. Which of the following best explains these marrow findings?\", \"choices\": [\"A. Accelerated cytoplasmic hemoglobinization driven by erythropoietin excess\", \"B. Delayed nuclear maturation with normal cytoplasmic maturation\", \"C. Impaired globin chain synthesis with preserved nuclear maturation\", \"D. Loss of membrane cytoskeletal proteins with cellular sphering\", \"E. Premature extrusion of the nucleus from erythroid precursors\"], \"correct\": 1, \"explanation\": \"Vitamin B12 deficiency after gastrectomy -> loss of intrinsic factor -> impaired thymidine synthesis -> nuclear maturation and cell division stall. Hemoglobin synthesis in the cytoplasm requires iron rather than DNA and proceeds normally, so the cytoplasm outruns the nucleus. This nuclear-cytoplasmic asynchrony generates every finding at once: precursors keep growing but cannot divide, so the cells are large with immature open chromatin; because every dividing cell is affected, granulocyte precursors become giant bands and metamyelocytes and circulating neutrophils become hypersegmented; and pancytopenia develops because all three lineages share the defect.\\nEducational objective: Megaloblastic anemia results from nuclear-cytoplasmic asynchrony: impaired DNA synthesis delays nuclear maturation while cytoplasmic hemoglobinization proceeds normally. Because all dividing cells are affected, the marrow shows giant granulocyte precursors and the blood shows hypersegmented neutrophils and pancytopenia.\", \"wrongExplanations\": {\"0\": \"Erythropoietin excess, as in erythropoietin-secreting tumors or exogenous administration, drives increased production of normally proportioned erythroid precursors and raises the reticulocyte count. It does not produce nuclear immaturity or giant granulocyte precursors.\", \"2\": \"Impaired globin chain synthesis with intact nuclear maturation occurs in thalassemia, in which precursors are small and poorly hemoglobinized and the marrow shows erythroid hyperplasia with microcytic red cells. This patient's cells are large with abundant cytoplasmic hemoglobin.\", \"3\": \"Loss of membrane cytoskeletal proteins such as ankyrin and spectrin causes hereditary spherocytosis, in which the peripheral smear shows spherocytes lacking central pallor and the mean corpuscular hemoglobin concentration is high. Marrow precursor morphology is normal.\", \"4\": \"Premature nuclear extrusion is not a recognized pathologic mechanism; normal erythroid precursors extrude the nucleus only at the final maturation step before release. Nucleated red cells in the blood reflect marrow stress or infiltration, not accelerated extrusion.\"}, \"eli5\": \"A blood cell grows its body and its control center at the same time, and it can only split in two once the control center is ready. Without B12 or folate, the control center falls far behind while the body keeps growing. You end up with big, overgrown cells that never managed to divide.\"}, {\"stem\": \"A 59-year-old man is evaluated for anemia. He has a 4-month history of fatigue and was recently found to have a low serum vitamin B12 level with an elevated methylmalonic acid. Vital signs are within normal limits. Physical examination shows pallor and mild scleral icterus, with no splenomegaly and no lymphadenopathy. Laboratory studies show hemoglobin 7.4 g/dL, mean corpuscular volume 119 fL, reticulocyte count 0.4%, total bilirubin 2.6 mg/dL with a direct fraction of 0.3 mg/dL, and markedly elevated lactate dehydrogenase; haptoglobin is at the lower end of normal, and the direct antiglobulin test is negative. Bone marrow biopsy shows a markedly hypercellular marrow with abundant erythroid precursors. Which of the following best explains the combination of a hypercellular marrow with a low reticulocyte count in this patient?\", \"choices\": [\"A. Autoimmune destruction of circulating erythrocytes\", \"B. Fibrotic obliteration of the marrow space\", \"C. Impaired erythropoietin response to anemia\", \"D. Intramedullary destruction of erythroid precursors\", \"E. Mechanical fragmentation of erythrocytes in the microvasculature\", \"F. Splenic sequestration of mature erythrocytes\"], \"correct\": 3, \"explanation\": \"In megaloblastic anemia the marrow attempts to compensate and produces precursors in large numbers, giving a hypercellular marrow. Those precursors cannot complete nuclear division, so most are destroyed within the marrow before ever being released -> ineffective erythropoiesis. Few mature cells reach the blood, so the reticulocyte count stays low despite the packed marrow, and the intramedullary cell death spills lactate dehydrogenase and unconjugated bilirubin, producing the elevated enzyme and the indirect hyperbilirubinemia without true peripheral hemolysis. The negative direct antiglobulin test and preserved haptoglobin argue against destruction in the circulation.\\nEducational objective: Ineffective erythropoiesis means precursors are produced in abundance but destroyed within the marrow before release, giving a hypercellular marrow with a low reticulocyte count plus elevated lactate dehydrogenase and indirect bilirubin. It is characteristic of megaloblastic anemia, thalassemia, and myelodysplastic syndrome.\", \"wrongExplanations\": {\"0\": \"Autoimmune hemolysis destroys mature circulating erythrocytes and would show a positive direct antiglobulin test, spherocytes on the smear, an undetectable or markedly reduced haptoglobin, and a high reticulocyte count. This patient's antiglobulin test is negative and the reticulocyte count is 0.4%.\", \"1\": \"Fibrotic obliteration of the marrow space defines primary myelofibrosis, which yields a dry tap on aspiration and a leukoerythroblastic smear with teardrop cells, nucleated red cells, and immature granulocytes, usually with massive splenomegaly. This marrow is hypercellular with abundant erythroid precursors rather than fibrotic.\", \"2\": \"An impaired erythropoietin response is the mechanism of anemia in chronic kidney disease and contributes in anemia of chronic disease; the marrow is then normocellular or hypocellular because the stimulus to build is missing. Here the marrow is hypercellular, proving the drive is intact.\", \"4\": \"Mechanical fragmentation produces schistocytes and helmet cells in disseminated intravascular coagulation, thrombotic thrombocytopenic purpura, hemolytic uremic syndrome, and around prosthetic valves, always with a compensatory reticulocytosis. No schistocytes are described and the reticulocyte count is low.\", \"5\": \"Splenic sequestration removes cells from the circulation in hypersplenism and causes a mild pancytopenia with splenomegaly on examination. This patient has no splenomegaly, and sequestration would not suppress the reticulocyte count in the face of a hypercellular marrow.\"}, \"eli5\": \"The factory is working overtime and is crammed full of half-built red cells. The problem is that almost none of them survive long enough to ship out; they fall apart on the assembly line. That is why the marrow looks busy while very few new cells show up in the blood.\"}, {\"stem\": \"A 47-year-old woman comes to the office due to fatigue and dyspnea on exertion for the past 5 months. She underwent Roux-en-Y gastric bypass 3 years ago and stopped taking her prescribed supplements about 18 months ago. She reports no melena or heavy menstrual bleeding and drinks no alcohol. Vital signs are within normal limits. Physical examination shows conjunctival pallor and a smooth tongue; neurologic examination shows intact vibration sense. Laboratory studies show hemoglobin 9.1 g/dL, hematocrit 27%, mean corpuscular volume 92 fL, and red cell distribution width 21.4% (N=11.5-14.5). Peripheral smear shows two distinct populations: small hypochromic cells with enlarged central pallor and large oval cells, with occasional neutrophils having six nuclear lobes. Ferritin is 7 ng/mL and serum vitamin B12 is 148 pg/mL. Which of the following best explains this patient's normal mean corpuscular volume?\", \"choices\": [\"A. Averaging of coexisting microcytic and macrocytic populations\", \"B. Compensatory reticulocytosis raising the measured cell volume\", \"C. Early iron deficiency before microcytosis has developed\", \"D. Erythrocyte agglutination producing a laboratory artifact\", \"E. Selective splenic removal of the largest circulating erythrocytes\"], \"correct\": 0, \"explanation\": \"Roux-en-Y gastric bypass removes or bypasses the acid- and intrinsic-factor-producing stomach and bypasses the duodenum -> predictable combined deficiency of vitamin B12 and iron. Iron deficiency produces microcytes and B12 deficiency produces macro-ovalocytes; the mean corpuscular volume is only an average, so the two populations cancel and the index reads normal. Two findings expose the deception: a markedly elevated red cell distribution width, which measures the variability in cell size, and a dimorphic smear showing both populations directly, here confirmed by a ferritin of 7 ng/mL and a low B12. Bariatric patients require lifelong monitoring and supplementation.\\nEducational objective: A normal mean corpuscular volume is an average and can conceal coexisting microcytic and macrocytic disease, as in the combined iron and vitamin B12 deficiency that follows bariatric surgery. An elevated red cell distribution width and a dimorphic peripheral smear reveal the two populations.\", \"wrongExplanations\": {\"1\": \"A marked reticulocytosis does raise the mean corpuscular volume, since reticulocytes are larger than mature erythrocytes, and it occurs in hemolysis and in recovery from blood loss. This patient has a production failure from two nutrient deficiencies, so the reticulocyte response is low.\", \"2\": \"Early iron deficiency can indeed present with a normocytic anemia before microcytosis develops, but the smear then shows a single uniform population without macrocytes. This smear shows two distinct populations and a low vitamin B12.\", \"3\": \"Erythrocyte agglutination artifactually raises the mean corpuscular volume and is seen with cold agglutinin disease, in which clumping is visible on the smear and warming the sample corrects the reading. Agglutination is not described here and would not produce a dimorphic population.\", \"4\": \"Selective splenic removal of large cells is not a recognized physiologic mechanism; the spleen preferentially culls rigid, poorly deformable cells such as spherocytes. This patient also has no splenomegaly or evidence of hemolysis.\"}, \"eli5\": \"The average cell size looks normal only because she has two problems pulling in opposite directions: some cells are too small and some are too big. Averaging them together hides both. The clue is that her cells vary wildly in size, which a single problem would not cause.\"}, {\"stem\": \"A 29-year-old woman comes to the office for follow-up of iron deficiency anemia attributed to heavy menstrual bleeding. At her last visit 6 weeks ago her hemoglobin was 9.0 g/dL with a mean corpuscular volume of 72 fL and a ferritin of 5 ng/mL, and ferrous sulfate three times daily was prescribed. Today her hemoglobin is 9.1 g/dL. Vital signs are within normal limits and physical examination shows persistent conjunctival pallor. When asked how the iron has been going, she looks down and says, \\\"I stopped the pills after about a week. They made me nauseated and constipated, and then my stools turned black. I thought something was seriously wrong inside me, and I did not want to call and sound ridiculous.\\\" Which of the following is the most appropriate initial response by the physician?\", \"choices\": [\"A. \\\"Black stools are a completely harmless effect of iron tablets, so please restart the same dose tonight and let me know how you get on.\\\"\", \"B. \\\"It sounds like those side effects were frightening, especially the black stools; tell me what happened so we can make this easier.\\\"\", \"C. \\\"Stopping the iron was risky, and your blood count has not improved at all in the six weeks since you decided to stop taking it.\\\"\", \"D. \\\"We can skip the tablets altogether and schedule you for an intravenous iron infusion in the infusion center sometime next week.\\\"\", \"E. \\\"Your heavy periods are the real problem here, so let us get you an appointment with a gynecologist to deal with that part first.\\\"\"], \"correct\": 1, \"explanation\": \"Nonadherence to oral iron is extremely common, because nausea, constipation, metallic taste, and black stools are frequent and patients quit without telling anyone. This patient has disclosed both a physical barrier and an emotional one: she was frightened and embarrassed. The response that fits the communication hierarchy names and validates the emotion and then opens an exploratory question or concrete action in the same breath, which preserves the alliance and surfaces the information needed to fix the regimen (lower dose, alternate-day dosing, taking it with food, or a different preparation). Education about the black stools is correct information but belongs after her experience has been heard, not instead of hearing it.\\nEducational objective: When a patient discloses nonadherence, the physician should first acknowledge and validate the patient's experience and then explore it, before educating, persuading, or proposing a new plan. Addressing the emotion first preserves the therapeutic alliance and elicits the barrier that must be solved.\", \"wrongExplanations\": {\"0\": \"This response delivers accurate information but commits premature education, offering a fact before the patient's fear and embarrassment have been acknowledged. It also prescribes the identical regimen that she already could not tolerate, so the adherence problem is untouched.\", \"2\": \"This response assigns blame and emphasizes the consequence of her decision, which shames a patient who has just admitted something difficult. Moralizing predictably reduces future disclosure and worsens adherence.\", \"3\": \"This response jumps to a closed-ended plan before exploring the barrier, and it may well be the wrong plan; most patients tolerate oral iron with dose adjustment, and intravenous iron carries cost, access, and infusion-reaction considerations. A concrete intervention is appropriate only after the concern has been heard.\", \"4\": \"This response deflects to another service and substitutes the physician's agenda for the patient's immediate concern. Evaluating menorrhagia is genuinely indicated, but redirecting the conversation now abandons the disclosed problem of intolerance and nonadherence.\"}, \"eli5\": \"She quit her medicine because it upset her stomach and scared her, and she felt silly bringing it up. The best first thing a doctor can do is say that makes sense and ask her to tell them more. Facts and new plans work much better after someone feels heard.\"}]";
var PRELOADED_UI_MODE="nbme";
var DEFAULT_QUESTION_COUNT=15;
var MAX_AI_QUESTION_COUNT=25;
var DOWNLOAD_TEMPLATE='';
var LAB_SECTIONS=[{"title":"Serum","rows":[{"name":"Alanine aminotransferase (ALT)","us":"10–40 U/L","si":"10–40 U/L"},{"name":"Aspartate aminotransferase (AST)","us":"12–38 U/L","si":"12–38 U/L"},{"name":"Alkaline phosphatase","us":"25–100 U/L","si":"25–100 U/L"},{"name":"Amylase","us":"25–125 U/L","si":"25–125 U/L"},{"name":"Bilirubin, total // direct","us":"0.1–1.0 mg/dL // 0.0–0.3 mg/dL","si":"2–17 µmol/L // 0–5 µmol/L"},{"name":"Calcium","us":"8.4–10.2 mg/dL","si":"2.1–2.6 mmol/L"},{"group":"Cholesterol"},{"name":"Total","us":"Normal: &lt;200 mg/dL // High: &gt;240 mg/dL","si":"&lt;5.2 mmol/L // &gt;6.2 mmol/L"},{"name":"HDL","us":"40–60 mg/dL","si":"1.0–1.6 mmol/L"},{"name":"LDL","us":"&lt;160 mg/dL","si":"&lt;4.2 mmol/L"},{"name":"Triglycerides","us":"Normal: &lt;150 mg/dL // Borderline: 151–199 mg/dL","si":"&lt;1.70 mmol/L // 1.71–2.25 mmol/L"},{"name":"Cortisol","us":"0800 h: 5–23 µg/dL // 1600 h: 3–15 µg/dL","si":"138–635 nmol/L // 82–413 nmol/L"},{"name":"","us":"2000 h: &lt;50% of 0800 h","si":"Fraction of 0800 h: &lt;0.50"},{"name":"Creatine kinase","us":"Male: 25–90 U/L","si":"25–90 U/L"},{"name":"","us":"Female: 10–70 U/L","si":"10–70 U/L"},{"name":"Creatinine","us":"0.6–1.2 mg/dL","si":"53–106 µmol/L"},{"name":"Urea nitrogen","us":"7–18 mg/dL","si":"2.5–6.4 mmol/L"},{"name":"Creatinine clearance","us":"Male: 97–137 mL/min","si":"97–137 mL/min"},{"name":"","us":"Female: 88–128 mL/min","si":"88–128 mL/min"},{"group":"Electrolytes, serum"},{"name":"Sodium (Na<sup>+</sup>)","us":"136–146 mEq/L","si":"136–146 mmol/L"},{"name":"Potassium (K<sup>+</sup>)","us":"3.5–5.0 mEq/L","si":"3.5–5.0 mmol/L"},{"name":"Chloride (Cl<sup>−</sup>)","us":"95–105 mEq/L","si":"95–105 mmol/L"},{"name":"Bicarbonate (HCO<sub>3</sub><sup>−</sup>)","us":"22–28 mEq/L","si":"22–28 mmol/L"},{"name":"Magnesium (Mg<sup>2+</sup>)","us":"1.5–2.0 mg/dL","si":"0.75–1.0 mmol/L"},{"name":"Ferritin","us":"Male: 20–250 ng/mL","si":"20–250 µg/L"},{"name":"","us":"Female: 10–120 ng/mL","si":"10–120 µg/L"},{"name":"Follicle-stimulating hormone","us":"Male: 4–25 mIU/mL","si":"4–25 U/L"},{"name":"","us":"Female: premenopause 4–30 mIU/mL","si":"4–30 U/L"},{"name":"","us":"midcycle peak 10–90 mIU/mL","si":"10–90 U/L"},{"name":"","us":"postmenopause 40–250 mIU/mL","si":"40–250 U/L"},{"name":"Glucose","us":"Fasting: 70–100 mg/dL","si":"3.8–5.6 mmol/L"},{"name":"","us":"Random, non-fasting: &lt;140 mg/dL","si":"&lt;7.77 mmol/L"},{"name":"Growth hormone - arginine stimulation","us":"Fasting: &lt;5 ng/mL","si":"&lt;5 µg/L"},{"name":"","us":"Provocative stimuli: &gt;7 ng/mL","si":"&gt;7 µg/L"},{"name":"Iron","us":"Male: 65–175 µg/dL","si":"11.6–31.3 µmol/L"},{"name":"","us":"Female: 50–170 µg/dL","si":"9.0–30.4 µmol/L"},{"name":"Total iron-binding capacity","us":"250–400 µg/dL","si":"44.8–71.6 µmol/L"},{"name":"Transferrin","us":"200–360 mg/dL","si":"2.0–3.6 g/L"},{"name":"Lactate dehydrogenase","us":"45–200 U/L","si":"45–200 U/L"},{"name":"Lipase","us":"13–60 U/L","si":"13–60 U/L"},{"name":"Luteinizing hormone","us":"Male: 6–23 mIU/mL","si":"6–23 U/L"},{"name":"","us":"Female: follicular phase 5–30 mIU/mL","si":"5–30 IU/L"},{"name":"","us":"midcycle 75–150 mIU/mL","si":"75–150 IU/L"},{"name":"","us":"postmenopause 30–200 mIU/mL","si":"30–200 IU/L"},{"name":"Osmolality","us":"275–295 mOsmol/kg H<sub>2</sub>O","si":"275–295 mOsmol/kg H<sub>2</sub>O"},{"name":"Intact parathyroid hormone (PTH)","us":"10–60 pg/mL","si":"10–60 ng/L"},{"name":"Phosphorus (inorganic)","us":"3.0–4.5 mg/dL","si":"1.0–1.5 mmol/L"},{"name":"Prolactin (hPRL)","us":"Male: &lt;17 ng/mL","si":"&lt;17 µg/L"},{"name":"","us":"Female: &lt;25 ng/mL","si":"&lt;25 µg/L"},{"group":"Proteins"},{"name":"Total","us":"6.0–7.8 g/dL","si":"60–78 g/L"},{"name":"Albumin","us":"3.5–5.5 g/dL","si":"35–55 g/L"},{"name":"Globulin","us":"2.3–3.5 g/dL","si":"23–35 g/L"},{"name":"Troponin I","us":"≤0.04 ng/mL","si":"≤0.04 µg/L"},{"name":"TSH","us":"0.4–4.0 μU/mL","si":"0.4–4.0 mIU/L"},{"name":"Thyroidal iodine (<sup>123</sup>I) uptake","us":"8%–30% of administered dose/24 h","si":"0.08–0.30/24 h"},{"name":"Thyroxine (T<sub>4</sub>)","us":"5–12 µg/dL","si":"64–155 nmol/L"},{"name":"Free T<sub>4</sub>","us":"0.9–1.7 ng/dL","si":"12.0–21.9 pmol/L"},{"name":"Triiodothyronine (T<sub>3</sub>) (RIA)","us":"100–200 ng/dL","si":"1.5–3.1 nmol/L"},{"name":"Triiodothyronine (T<sub>3</sub>) resin uptake","us":"25%–35%","si":"0.25–0.35"},{"name":"Uric acid","us":"3.0–8.2 mg/dL","si":"0.18–0.48 mmol/L"},{"group":"Immunoglobulins"},{"name":"IgA","us":"76–390 mg/dL","si":"0.76–3.90 g/L"},{"name":"IgE","us":"0–380 IU/mL","si":"0–380 kIU/L"},{"name":"IgG","us":"650–1500 mg/dL","si":"6.5–15.0 g/L"},{"name":"IgM","us":"50–300 mg/dL","si":"0.5–3.0 g/L"},{"group":"Gases, arterial blood (room air)"},{"name":"pH","us":"7.35–7.45","si":"[H<sup>+</sup>] 36–44 nmol/L"},{"name":"Pco<sub>2</sub>","us":"33–45 mm Hg","si":"4.4–5.9 kPa"},{"name":"Po<sub>2</sub>","us":"75–105 mm Hg","si":"10.0–14.0 kPa"}]},{"title":"Cerebrospinal Fluid","rows":[{"name":"Cell count","us":"0–5/mm<sup>3</sup>","si":"0–5 x 10<sup>6</sup>/L"},{"name":"Chloride","us":"118–132 mEq/L","si":"118–132 mmol/L"},{"name":"Gamma globulin","us":"3%–12% total proteins","si":"0.03–0.12"},{"name":"Glucose","us":"40–70 mg/dL","si":"2.2–3.9 mmol/L"},{"name":"Pressure","us":"70–180 mm H<sub>2</sub>O","si":"70–180 mm H<sub>2</sub>O"},{"name":"Proteins, total","us":"&lt;40 mg/dL","si":"&lt;0.40 g/L"}]},{"title":"Hematologic","rows":[{"name":"Erythrocyte count (RBC)","us":"Male: 4.3–5.9 million/mm<sup>3</sup>","si":"4.3–5.9 x 10<sup>12</sup>/L"},{"name":"","us":"Female: 3.5–5.5 million/mm<sup>3</sup>","si":"3.5–5.5 x 10<sup>12</sup>/L"},{"name":"Erythrocyte sedimentation rate (Westergren)","us":"Male: 0–15 mm/h","si":"0–15 mm/h"},{"name":"","us":"Female: 0–20 mm/h","si":"0–20 mm/h"},{"name":"Hematocrit","us":"Male: 41%–53%","si":"0.41–0.53"},{"name":"","us":"Female: 36%–46%","si":"0.36–0.46"},{"name":"Hemoglobin, blood","us":"Male: 13.5–17.5 g/dL","si":"135–175 g/L"},{"name":"","us":"Female: 12.0–16.0 g/dL","si":"120–160 g/L"},{"name":"Hemoglobin A<sub>1c</sub>","us":"≤6%","si":"≤42 mmol/mol"},{"name":"Leukocyte count (WBC)","us":"4500–11,000/mm<sup>3</sup>","si":"4.5–11.0 x 10<sup>9</sup>/L"},{"name":"Neutrophils, segmented","us":"54%–62%","si":"0.54–0.62"},{"name":"Neutrophils, bands","us":"3%–5%","si":"0.03–0.05"},{"name":"Eosinophils","us":"1%–3%","si":"0.01–0.03"},{"name":"Basophils","us":"0%–0.75%","si":"0.00–0.0075"},{"name":"Lymphocytes","us":"25%–33%","si":"0.25–0.33"},{"name":"Monocytes","us":"3%–7%","si":"0.03–0.07"},{"name":"CD4+ T-lymphocyte count","us":"≥500/mm<sup>3</sup>","si":"≥0.5 x 10<sup>9</sup>/L"},{"name":"Platelet count","us":"150,000–400,000/mm<sup>3</sup>","si":"150–400 x 10<sup>9</sup>/L"},{"name":"Reticulocyte count","us":"0.5%–1.5%","si":"0.005–0.015"},{"name":"D-Dimer","us":"≤250 ng/mL","si":"≤1.4 nmol/L"},{"name":"Partial thromboplastin time (aPTT) (activated)","us":"25–40 seconds","si":"25–40 seconds"},{"name":"Prothrombin time (PT)","us":"11–15 seconds","si":"11–15 seconds"},{"name":"Mean corpuscular hemoglobin (MCH)","us":"25–35 pg/cell","si":"0.39–0.54 fmol/cell"},{"name":"Mean corpuscular hemoglobin concentration (MCHC)","us":"31%–36% Hb/cell","si":"4.8–5.6 mmol Hb/L"},{"name":"Mean corpuscular volume (MCV)","us":"80–100 µm<sup>3</sup>","si":"80–100 fL"},{"group":"Volume"},{"name":"Plasma","us":"Male: 25–43 mL/kg","si":"0.025–0.043 L/kg"},{"name":"","us":"Female: 28–45 mL/kg","si":"0.028–0.045 L/kg"},{"name":"Red cell","us":"Male: 20–36 mL/kg","si":"0.020–0.036 L/kg"},{"name":"","us":"Female: 19–31 mL/kg","si":"0.019–0.031 L/kg"}]},{"title":"Urine","rows":[{"name":"Calcium","us":"100–300 mg/24 h","si":"2.5–7.5 mmol/24 h"},{"name":"Osmolality","us":"50–1200 mOsmol/kg H<sub>2</sub>O","si":"50–1200 mOsmol/kg H<sub>2</sub>O"},{"name":"Oxalate","us":"8–40 µg/mL","si":"90–445 µmol/L"},{"name":"Proteins, total","us":"&lt;150 mg/24 h","si":"&lt;0.15 g/24 h"},{"name":"17-Hydroxycorticoster