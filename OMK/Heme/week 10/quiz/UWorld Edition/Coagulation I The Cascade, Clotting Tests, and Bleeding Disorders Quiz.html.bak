      <label class="lbl">Paste AI responses here</label>
      <div class="field-note">Paste the AI's full copied response into Set 1. If you ask the AI to make questions in smaller groups, paste each extra group into Set 2, Set 3, or Set 4. Launch Quiz will put all filled sets together.</div>
      <div class="paste-tabs" role="tablist" aria-label="AI response sets">
        <button class="paste-tab active" id="pasteTab1" type="button" role="tab" aria-selected="true" aria-controls="pastePanel1" onclick="showPasteSetTab(1)">Set 1</button>
        <button class="paste-tab" id="pasteTab2" type="button" role="tab" aria-selected="false" aria-controls="pastePanel2" onclick="showPasteSetTab(2)">Set 2</button>
        <button class="paste-tab" id="pasteTab3" type="button" role="tab" aria-selected="false" aria-controls="pastePanel3" onclick="showPasteSetTab(3)">Set 3</button>
        <button class="paste-tab" id="pasteTab4" type="button" role="tab" aria-selected="false" aria-controls="pastePanel4" onclick="showPasteSetTab(4)">Set 4</button>
      </div>
      <div class="paste-panels">
        <div class="paste-panel active" id="pastePanel1" role="tabpanel" aria-labelledby="pasteTab1">
          <label class="lbl" for="pasteArea1">Set 1</label>
          <div class="field-note">Use this for your first AI batch.</div>
          <textarea class="ta" id="pasteArea1" placeholder="Paste AI response for Set 1…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel2" role="tabpanel" aria-labelledby="pasteTab2" hidden="">
          <label class="lbl" for="pasteArea2">Set 2</label>
          <div class="field-note">Use this for your second AI batch.</div>
          <textarea class="ta" id="pasteArea2" placeholder="Paste AI response for Set 2…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel3" role="tabpanel" aria-labelledby="pasteTab3" hidden="">
          <label class="lbl" for="pasteArea3">Set 3</label>
          <div class="field-note">Use this for your third AI batch.</div>
          <textarea class="ta" id="pasteArea3" placeholder="Paste AI response for Set 3…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel4" role="tabpanel" aria-labelledby="pasteTab4" hidden="">
          <label class="lbl" for="pasteArea4">Set 4</label>
          <div class="field-note">Use this for your fourth AI batch.</div>
          <textarea class="ta" id="pasteArea4" placeholder="Paste AI response for Set 4…" oninput="syncPasteSetTabs()"></textarea>
        </div>
      </div>
    </div>
    <div class="setup-actions">
      <button class="launch-btn" onclick="launchQuiz()">🚀 Launch Quiz</button>
      <button class="ghost-btn" onclick="downloadQuiz()">⬇ Download My Quiz</button>
    </div>
    <div class="err-msg" id="errMsg"></div>
  </div>

</div>
</div>
</div>

<!-- ══════════ QUIZ VIEW ══════════ -->
<div class="view" id="viewQuiz">
<div class="quiz-page">

  <!-- top bar -->
  <div class="qt-bar">
    <div class="qt-name" id="qtName">Quiz</div>
    <button class="qt-btn" id="qtClassicUiBtn" onclick="switchQuizUI('nbme')">⇄ NBME UI</button>
    <button class="qt-btn" id="qtMarkBtn" onclick="toggleMark()">⚑ Mark</button>
    <button class="qt-btn" id="qtSubmitBtn" onclick="submitExam()">🧾 Submit Exam</button>
    <button class="qt-btn" onclick="downloadQuiz()">⬇ Download Quiz</button>
    <button class="qt-btn" onclick="resetQuiz()">↺ Reset</button>
    <button class="qt-btn" onclick="exitQuiz()">✕ Close</button>
  </div>

  <!-- grid -->
  <div class="qin">

    <!-- LEFT SIDEBAR -->
    <div class="sidebar">

      <!-- score boxes -->
      <div class="score-panel">
        <div class="score-box correct"><div class="sv" id="sC">0</div><div class="sl">Correct</div></div>
        <div class="score-box incorrect"><div class="sv" id="sI">0</div><div class="sl">Incorrect</div></div>
        <div class="score-box"><div class="sv" id="sP">—</div><div class="sl">Score</div></div>
      </div>

      <!-- mode toggle -->
      <div class="mode-toggle">
        <button class="mode-btn active" id="modeLearn" onclick="setMode('learn')"><span class="mode-icon">📚</span>Learn Mode</button>
        <button class="mode-btn" id="modeExam" onclick="setMode('exam')"><span class="mode-icon">📝</span>Exam Mode</button>
      </div>

      <!-- timer -->
      <div class="timer-card" id="timerCard">
        <div class="timer-lbl" id="timerModeLbl" onclick="toggleTimerDisplay()" title="Click to switch between elapsed and remaining time">TIMER · ELAPSED</div>
        <div class="timer-time" id="timerTime">00:00</div>
        <button class="tbtn" id="timerPlayBtn" onclick="toggleTimer()">▶</button>
        <button class="tbtn" onclick="resetTimer()">↺</button>
      </div>

      <!-- tools -->
      <div class="tool-panel">
        <button class="q-tool hl-tool" id="hlTool" onclick="toggleTool('hl')">🖊 Highlight</button>
        <button class="q-tool st-tool" id="stTool" onclick="toggleTool('st')">✂ Strikethrough</button>
        <button class="q-tool" onclick="clearMarks()">✖ Clear Marks</button>
        <button class="q-tool lab-tool" onclick="openLabs()">🧪 Lab Values</button>
        <div class="font-tools">
          <span class="font-tools-label">Text Size</span>
          <div class="font-tools-group">
            <button class="font-btn" onclick="adjustFontSize(-1)" aria-label="Decrease question and answer text size">A-</button>
            <button class="font-btn reset" onclick="resetFontSize()" aria-label="Reset question and answer text size">A</button>
            <button class="font-btn" onclick="adjustFontSize(1)" aria-label="Increase question and answer text size">A+</button>
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT: QUESTION -->
    <div>
      <div id="finBanner"></div>
      <div id="qArea"></div>
    </div>

  </div>
</div>
</div>

<!-- ══════════ NBME / NBOME VIEW ══════════ -->
<div class="view" id="viewQuizNbme">
<div class="nb-wrap">
  <div class="nb-util">
    <div class="nb-util-name" id="nbQuizTitle">Quiz</div>
    <div class="nb-util-actions">
      <button class="nb-util-btn" onclick="toggleFullscreen()" id="nbFsBtn">⛶ Fullscreen</button>
      <button class="nb-util-btn" onclick="switchQuizUI('classic')">UNE UI</button>
      <button class="nb-util-btn" onclick="downloadQuiz()">Download</button>
      <button class="nb-util-btn" onclick="resetQuiz()">Reset</button>
      <button class="nb-util-btn" onclick="exitQuiz()">Close</button>
    </div>
  </div>

  <div class="nb-app">
    <header class="nb-header">
      <div class="nb-status-box">
        <strong id="nbItemIndicator">Question: 1 of 1</strong>
        <span id="nbStatusMeta">Answered 0 of 1</span>
      </div>

      <div class="nb-header-center">
        <button class="nb-action-btn" id="nbMarkBtn" type="button" onclick="toggleMark()">⚑ Mark</button>
        <button class="nb-action-btn" id="nbHighlightBtn" type="button" onclick="toggleTool('hl')">Highlight</button>
        <button class="nb-action-btn" id="nbStrikeBtn" type="button" onclick="toggleTool('st')">Strikeout</button>
        <button class="nb-action-btn" type="button" onclick="clearMarks()">Clear</button>
        <button class="nb-mode-pill active" id="nbModeLearn" type="button" onclick="setMode('learn')">Learn</button>
        <button class="nb-mode-pill" id="nbModeExam" type="button" onclick="setMode('exam')">Testing</button>
        <button class="nb-action-btn" id="nbSummaryBtn" type="button" onclick="toggleSummaryPanel()" disabled="">See Score &amp; Summary</button>
        <div class="nb-item-picker">
          <label for="nbItemSelect">Question</label>
          <select id="nbItemSelect" aria-label="Jump to a question" onchange="goQ(parseInt(this.value,10))"></select>
        </div>
      </div>

      <div class="nb-nav-controls">
        <button class="nb-nav-btn" id="nbPrevBtn" type="button" onclick="prevQ()">
          <span class="icon">◀</span><span>Previous</span>
        </button>
        <button class="nb-nav-btn" id="nbNextBtn" type="button" onclick="nextQ()">
          <span class="icon">▶</span><span>Next</span>
        </button>
      </div>
    </header>

    <main class="nb-body">
      <aside class="nb-rail" aria-label="Question navigator">
        <div class="nb-rail-title">Questions</div>
        <button class="nb-rail-arrow" id="nbRailUpBtn" type="button" aria-label="Scroll question list up" onclick="scrollNbmeRail(-1)">▲</button>
        <div class="nb-rail-scroll" id="nbRailScroll" onscroll="syncNbmeRailArrows()">
          <div id="nbRailItems"></div>
        </div>
        <button class="nb-rail-arrow" id="nbRailDownBtn" type="button" aria-label="Scroll question list down" onclick="scrollNbmeRail(1)">▼</button>
      </aside>

      <section class="nb-stage">
        <div id="nbFinishBanner"></div>
        <div class="nb-question-scroll">
          <div id="nbContent"></div>
        </div>
      </section>
    </main>

    <footer class="nb-footer">
      <div class="nb-timer-box" id="nbTimerCard">
        <button class="nb-timer-mode" id="nbTimerModeLbl" type="button" onclick="toggleTimerDisplay()" title="Click to switch between elapsed and remaining time">Elapsed Time:</button><strong id="nbTimerTime">00:00</strong>
        <span>Status:</span><strong id="nbTimerStatus">Paused</strong>
        <small id="nbTimerNote">Same timer as the original interface</small>
        <div class="nb-timer-actions">
          <button class="nb-timer-mini" id="nbTimerToggle" type="button" onclick="toggleTimer()">Start</button>
          <button class="nb-timer-mini" type="button" onclick="resetTimer()">Reset</button>
        </div>
      </div>

      <div class="nb-footer-center">
        <div class="nb-score-chip">
          <span>Correct <strong id="nbScoreCorrect">0</strong></span>
          <span>Incorrect <strong id="nbScoreIncorrect">0</strong></span>
          <span>Score <strong id="nbScorePercent">—</strong></span>
        </div>
        <button class="nb-footer-tool" type="button" onclick="openLabs()">▤ Lab Values</button>
        <div class="nb-font-cluster">
          <label>Text</label>
          <button class="nb-font-btn" type="button" onclick="adjustFontSize(-1)">A-</button>
          <button class="nb-font-btn" type="button" onclick="resetFontSize()">A</button>
          <button class="nb-font-btn" type="button" onclick="adjustFontSize(1)">A+</button>
        </div>
      </div>

      <div class="nb-end-wrap">
        <button class="nb-end-btn" id="nbReviewBtn" type="button" onclick="handleNbmeEndAction()">Testing Mode Only</button>
      </div>
    </footer>
  </div>
</div>
</div>

<div class="lab-modal" id="labModal" onclick="if(event.target===this)closeLabs()">
  <div class="lab-shell">
    <div class="lab-card">
      <div class="lab-header">
        <div>
          <div class="lab-kicker">Reference Table</div>
          <h2 class="lab-title">Laboratory Values</h2>
          <div class="lab-sub">Shared lab reference for both quiz interfaces, imported from the NBME-style simulator so the values stay consistent.</div>
        </div>
        <button class="lab-close" type="button" onclick="closeLabs()">Close</button>
      </div>
      <div class="lab-controls">
        <div class="lab-toggle">
          <button class="lab-toggle-btn active" id="labUnitsUs" type="button" onclick="setLabUnits('us')">U.S. Units</button>
          <button class="lab-toggle-btn" id="labUnitsSi" type="button" onclick="setLabUnits('si')">SI Units</button>
        </div>
        <div class="lab-note">Switch units without leaving the question.</div>
      </div>
      <div class="lab-body">
        <div id="labTables"></div>
      </div>
    </div>
  </div>
</div>

<script>
// ── STATE ──
var questions=[],questionBank=[],answers={},selected={},marked={},stemMarkup={},choiceMarkup={},NC=0,NI=0,CQ=0;
var quizMode='learn';
var uiMode='classic';
var examSubmitted=false;
var reviewOpen=false;
var summaryVisible=false;
var finishBannerMinimized=false;
var toolMode='';
var highlightColor='#fff173', annotationRange=null, annotationRoot=null, suppressChoiceUntil=0;
var labUnitMode='us';
var timerSec=0,timerRunning=false,timerInterval=null;
var fontStep=0;
var LETTERS=['A','B','C','D','E','F','G','H'];
var MAX_ANSWER_CHOICES=8;
var PRELOADED_QUIZ_NAME="Coagulation I: The Cascade, Clotting Tests, and Bleeding Disorders";
var PRELOADED_QUESTIONS_JSON="[{\"stem\":\"A 22-year-old man comes to the emergency department due to a painful, enlarging swelling of the right thigh that developed over the past 12 hours following an intramuscular injection. He had two episodes of a swollen, warm knee after minor falls in childhood and a large hematoma after a dental nerve block. He has never had nosebleeds, gum bleeding, or petechiae. His mother's brother had a similar bleeding problem. Vital signs are within normal limits. Physical examination shows a tense, tender swelling of the anterior thigh with overlying ecchymosis and no petechiae or mucosal bleeding. Which of the following sets of laboratory findings is most likely in this patient?\\n\\n     Prothrombin time | Activated partial thromboplastin time | Platelet count | 1:1 mixing study\",\"choices\":[\"A. Normal | Normal | Decreased | Not applicable\",\"B. Normal | Normal | Normal | Not applicable\",\"C. Normal | Prolonged | Normal | Corrects\",\"D. Normal | Prolonged | Normal | Does not correct\",\"E. Prolonged | Normal | Normal | Corrects\",\"F. Prolonged | Prolonged | Decreased | Corrects\"],\"correct\":2,\"explanation\":\"Deep tissue bleeding into joints and muscles with no mucocutaneous bleeding, in a male with an affected maternal uncle, indicates an X-linked deficiency of factor VIII or factor IX. Both are intrinsic pathway factors -> the activated partial thromboplastin time (aPTT) is prolonged while the prothrombin time (PT), which measures the extrinsic and common pathways, is normal. Platelets are unaffected. Because this is a missing factor rather than an inhibitor, adding normal plasma supplies each factor at roughly 50% of normal, which is enough for hemostasis, so the mixing study corrects. Factor VIII and factor IX activity assays are then required, since the two hemophilias are clinically and on screening tests indistinguishable.\\nEducational objective: Hemophilia A and B produce an isolated prolonged aPTT with a normal PT and platelet count, and a 1:1 mixing study that corrects. Failure of the mix to correct indicates an inhibitor (eg, acquired factor VIII antibody, lupus anticoagulant) rather than a deficiency.\",\"wrongExplanations\":{\"0\":\"Normal clotting times with isolated thrombocytopenia describe immune thrombocytopenia and other platelet-number disorders, which bleed mucocutaneously with petechiae. This patient has deep tissue bleeding and no petechiae.\",\"1\":\"A completely normal screen with a significant bleeding history points to factor XIII deficiency, antiplasmin deficiency, von Willebrand disease, or a platelet function defect. Factor XIII deficiency gives delayed bleeding, and the others bleed mucocutaneously, neither of which matches recurrent hemarthrosis.\",\"3\":\"An isolated prolonged aPTT that does not correct on mixing indicates an inhibitor, classically an acquired factor VIII autoantibody or a lupus anticoagulant. Acquired hemophilia presents as a new diathesis in an older adult with no lifetime history, the opposite of this patient's childhood-onset pattern.\",\"4\":\"An isolated prolonged PT that corrects on mixing reflects factor VII deficiency or early vitamin K deficiency or warfarin effect, since factor VII has the shortest half-life. This pattern spares the intrinsic pathway and would not explain recurrent hemarthrosis.\",\"5\":\"Prolongation of both times with thrombocytopenia occurs in disseminated intravascular coagulation and advanced liver disease, where multiple factors and platelets are consumed or not made. Both are acquired illnesses of ill patients, not lifelong bleeding since childhood.\"},\"eli5\":\"Platelets patch surfaces, so when they fail you bleed from skin, gums, and the nose. Fibrin fills spaces, so when a clotting factor is missing you bleed into joints and muscles. This man bleeds into spaces, which points at the factor arm of the system.\"},{\"stem\":\"A 34-year-old woman is evaluated for prolonged bleeding after a dental extraction and for menstrual periods that have required transfusion twice. Her parents are first cousins, and a sister has a similar bleeding history. Vital signs are within normal limits. Physical examination shows ecchymoses over both thighs and no petechiae or joint deformity. Laboratory studies show prothrombin time 22 seconds and activated partial thromboplastin time 58 seconds, both prolonged, with a normal platelet count, normal fibrinogen concentration, and a normal thrombin time. A 1:1 mix with normal pooled plasma corrects both clotting times. Factor V, factor VIII, and factor IX activities are all within normal limits. Deficiency of which of the following factors is most likely in this patient?\",\"choices\":[\"A. Factor VII\",\"B. Factor VIII\",\"C. Factor X\",\"D. Factor XI\",\"E. Factor XII\",\"F. Factor XIII\"],\"correct\":2,\"explanation\":\"The cascade is read as two arms feeding a shared trunk. The intrinsic arm (factors XII, XI, IX, VIII) is measured by the activated partial thromboplastin time (aPTT); the extrinsic arm (factor VII) is measured by the prothrombin time (PT); the arms converge at factor X and run down the common pathway X -> V -> II (thrombin) -> fibrinogen -> fibrin, which moves both tests. Prolongation of both times with a normal thrombin time and fibrinogen localizes the defect to the common pathway; normal factor V leaves factor X (or prothrombin). Correction on mixing confirms a deficiency rather than an inhibitor, and consanguinity fits a rare autosomal recessive factor deficiency.\\nEducational objective: A defect in the common pathway (factors X, V, II, or fibrinogen) prolongs both the PT and the aPTT, whereas intrinsic factor defects prolong only the aPTT and factor VII deficiency prolongs only the PT. A normal thrombin time excludes a fibrinogen abnormality.\",\"wrongExplanations\":{\"0\":\"Factor VII deficiency prolongs the PT alone, since factor VII is the sole component of the extrinsic pathway; it is also why the PT is the first test to prolong in vitamin K deficiency and warfarin therapy. This patient's aPTT is prolonged as well.\",\"1\":\"Factor VIII deficiency causes hemophilia A, an X-linked disorder producing an isolated prolonged aPTT with joint and muscle bleeding. Her factor VIII activity is explicitly normal, and the PT would not be affected.\",\"3\":\"Factor XI deficiency (hemophilia C) is autosomal, affects both sexes, is enriched in Ashkenazi Jewish populations, and causes mild bleeding that correlates poorly with the factor level. It prolongs only the aPTT.\",\"4\":\"Factor XII deficiency prolongs the aPTT and causes no bleeding at all, because in vivo a backup contact system compensates while the in vitro reagent genuinely requires it. It also leaves the PT normal.\",\"5\":\"Factor XIII cross-links fibrin after the clot has already formed, so every screening test, including the PT, aPTT, and platelet count, is normal. Its deficiency causes delayed bleeding and delayed wound healing and requires a specific assay.\"},\"eli5\":\"Think of clotting as two roads that merge into one highway. One test watches the left road, one watches the right road, and both watch the shared highway. When both tests are slow, the problem is on the shared stretch that everyone drives on.\"},{\"stem\":\"A 31-year-old woman comes to the office for evaluation of an abnormal coagulation study found before elective laparoscopic cholecystectomy. She has had two spontaneous second-trimester pregnancy losses and an unprovoked left calf deep venous thrombosis 2 years ago. She has never had abnormal bleeding, including after a tonsillectomy at age 9. Vital signs are within normal limits and physical examination is normal. Laboratory studies show activated partial thromboplastin time 56 seconds, prothrombin time 12 seconds, and platelet count 118,000/mm3. A 1:1 mix with normal pooled plasma does not correct the activated partial thromboplastin time, and adding excess phospholipid to the assay shortens it into the normal range. A rapid plasma reagin test is reactive, and confirmatory treponemal testing is negative. Which of the following best explains this patient's laboratory findings?\",\"choices\":[\"A. Alloantibody directed against infused factor VIII\",\"B. Antibody directed against a phospholipid-protein complex\",\"C. Autoantibody directed against ADAMTS13\",\"D. Autoantibody directed against platelet glycoprotein IIb/IIIa\",\"E. Deficiency of a contact activation factor\"],\"correct\":1,\"explanation\":\"A prolonged aPTT that fails to correct on mixing indicates an inhibitor, not a deficiency. Correction on addition of excess phospholipid identifies the target: the antibody is directed against phospholipid-bound proteins rather than against a specific clotting factor, so flooding the assay with phospholipid overwhelms it. This is a lupus anticoagulant, and the accompanying picture of thrombosis, recurrent fetal loss, mild thrombocytopenia, and a false-positive nontreponemal syphilis test is antiphospholipid syndrome. The paradox is essential: the antibody prolongs clotting in vitro, because it interferes with a phospholipid-dependent assay, while in vivo it increases thrombosis risk.\\nEducational objective: A lupus anticoagulant prolongs the aPTT, fails to correct on 1:1 mixing, and corrects with excess phospholipid, identifying an antibody against phospholipid-protein complexes. Despite prolonging clotting times in vitro, it causes thrombosis, recurrent fetal loss, and a false-positive nontreponemal syphilis test in vivo.\",\"wrongExplanations\":{\"0\":\"An alloantibody against infused factor VIII arises in patients with severe hemophilia A who lose response to replacement therapy; the mix fails to correct, but there is a lifelong bleeding history and no thrombosis. This patient has never bled and has never received factor.\",\"2\":\"An autoantibody against ADAMTS13 causes acquired thrombotic thrombocytopenic purpura, with microangiopathic hemolytic anemia, schistocytes, profound thrombocytopenia, and neurologic or renal findings. The PT and aPTT are normal in that disorder.\",\"3\":\"Autoantibodies against platelet glycoprotein IIb/IIIa opsonize platelets for splenic destruction in immune thrombocytopenia, producing isolated thrombocytopenia with mucocutaneous bleeding and normal clotting times. They do not prolong the aPTT or cause thrombosis.\",\"4\":\"Factor XII deficiency prolongs the aPTT in an asymptomatic patient and is the classic incidental finding on preoperative screening, but it is a deficiency, so a 1:1 mix corrects. It also carries no thrombotic or obstetric risk.\"},\"eli5\":\"This antibody sticks to the fatty surfaces that clotting reactions need, which makes the laboratory test look slow. In the body, though, it actually makes clots more likely. So the test says bleeding while the patient's real risk is clotting.\"},{\"stem\":\"A 68-year-old man is admitted to the hospital due to a 10-day history of large spontaneous bruises over the flanks and a painful swelling of the left forearm. He has had no bleeding at any point in his life, including after a cholecystectomy at age 52, and he takes no anticoagulants. His medical conditions include rheumatoid arthritis. Vital signs are within normal limits. Physical examination shows extensive ecchymoses and a tense forearm hematoma; there are no petechiae. Laboratory studies show activated partial thromboplastin time 64 seconds, prothrombin time 12 seconds, and platelet count 244,000/mm3. An immediate 1:1 mix with normal pooled plasma corrects the activated partial thromboplastin time to 33 seconds, and the team concludes that a factor deficiency is present. Which of the following is the most appropriate next step in management of this patient?\",\"choices\":[\"A. Assay of factor XII activity\",\"B. Bone marrow aspiration and biopsy\",\"C. Measurement of ristocetin cofactor activity\",\"D. Repeat mixing study after incubation at 37 C for 60 minutes\",\"E. Transfusion of fresh frozen plasma\"],\"correct\":3,\"explanation\":\"A new bleeding diathesis in an older adult with no lifetime history is acquired hemophilia A until proven otherwise, and it is frequently associated with autoimmune disease or malignancy. Acquired factor VIII autoantibodies are time and temperature dependent -> on an immediate 1:1 mix the antibody has not yet neutralized the donated factor VIII, so the clotting time corrects and mimics a deficiency. Incubating the mixture at 37 C for 30-60 minutes and re-timing allows the antibody to act, and the aPTT drifts back out. Confirmation is a factor VIII activity level with a Bethesda titer; treatment is a bypassing agent for bleeding plus immunosuppression to eradicate the antibody.\\nEducational objective: An immediate 1:1 mixing study that corrects does not exclude an inhibitor, because acquired factor VIII autoantibodies are slow acting. When a new bleeding diathesis appears in an older adult with no lifetime history, request an incubated mixing study, a factor VIII level, and a Bethesda titer.\",\"wrongExplanations\":{\"0\":\"A factor XII assay is appropriate for an asymptomatic prolonged aPTT found incidentally on preoperative screening, since factor XII deficiency prolongs the test without causing bleeding. This patient is bleeding severely, which factor XII deficiency never explains.\",\"1\":\"Marrow aspiration and biopsy evaluate suspected primary marrow disease when there is cytopenia, circulating blasts, or an unexplained pancytopenia. This patient's platelet count is normal and the defect is in plasma coagulation.\",\"2\":\"Ristocetin cofactor activity is the functional assay for von Willebrand disease, including acquired von Willebrand disease from aortic stenosis or a paraprotein. That disorder bleeds mucocutaneously and would not typically produce a deep forearm hematoma with an aPTT of 64 seconds.\",\"4\":\"Fresh frozen plasma supplies factors at low concentration and is ineffective when a high-titer inhibitor is neutralizing them; hemophilia patients should receive concentrates rather than plasma. Treatment should also follow, not precede, identification of the inhibitor.\"},\"eli5\":\"The test that checks whether something is missing or something is attacking can be fooled, because some attacking antibodies work slowly. If you warm the mixture and wait an hour, the antibody has time to act and the test turns abnormal again. An immediate normal result is not proof.\"},{\"stem\":\"A 57-year-old man is in the intensive care unit on the fourth day of treatment for pneumococcal pneumonia. He has a triple-lumen central venous catheter in the right internal jugular vein whose unused lumen is maintained with a heparin lock; he is not receiving systemic anticoagulation and has had no bleeding. Vital signs are stable. Routine coagulation studies drawn from the catheter show an activated partial thromboplastin time greater than 150 seconds with a prothrombin time of 13 seconds and a platelet count of 210,000/mm3. A repeat specimen obtained 30 minutes later by peripheral venipuncture into a properly filled citrate tube shows an activated partial thromboplastin time of 31 seconds. Which of the following best explains the initial result?\",\"choices\":[\"A. Consumption of coagulation factors within the catheter lumen\",\"B. Contamination of the specimen with heparin from the catheter\",\"C. Excess citrate relative to blood volume in the collection tube\",\"D. In vitro platelet clumping induced by ethylenediaminetetraacetic acid\",\"E. Presence of a circulating lupus anticoagulant\"],\"correct\":1,\"explanation\":\"Heparin acts by potentiating antithrombin, which neutralizes thrombin and factor Xa -> the aPTT is markedly prolonged while the PT is relatively spared at low concentrations. A specimen drawn through a heparin-locked line carries residual heparin into the tube, producing a dramatically abnormal result in a patient who is not anticoagulated and is not bleeding. The diagnostic maneuver is exactly what happened here: redraw peripherally, and the abnormality disappears. Recognizing pre-analytic artifact matters because the alternative is an unnecessary hematology workup and, worse, withholding a needed procedure.\\nEducational objective: A markedly prolonged aPTT with a normal PT in a patient drawn through a heparinized catheter is usually specimen contamination; a peripheral redraw resolves it. Other pre-analytic causes of falsely prolonged clotting times include an underfilled citrate tube, which breaks the required 9:1 blood-to-citrate ratio.\",\"wrongExplanations\":{\"0\":\"Consumption of factors describes disseminated intravascular coagulation, in which both clotting times are prolonged with a falling platelet count and fibrinogen and a rising D-dimer. It is a systemic process and does not occur locally within a catheter lumen.\",\"2\":\"Excess citrate from an underfilled blue-top tube does falsely prolong clotting times, because the added calcium is chelated by the surplus citrate. It typically prolongs both the PT and the aPTT, and the tube here was noted to be properly filled on the confirmatory draw.\",\"3\":\"Ethylenediaminetetraacetic acid-dependent platelet clumping causes pseudothrombocytopenia on a lavender-top complete blood count specimen, resolved by redrawing into citrate. It affects the platelet count rather than the clotting times, and this patient's platelet count is normal.\",\"4\":\"A lupus anticoagulant prolongs the aPTT and would persist on a peripheral redraw, failing to correct on a 1:1 mix and correcting only with excess phospholipid. This patient's repeat aPTT was entirely normal.\"},\"eli5\":\"Blood drawn through a line that is kept open with a blood thinner picks up some of that thinner on the way into the tube. The test then measures the drug, not the patient. Drawing from a vein in the arm gives the real answer.\"},{\"stem\":\"A 29-year-old man is brought to the operating room after a motor vehicle collision with a grade IV splenic laceration. Over 90 minutes he receives 12 units of packed red blood cells, 8 units of plasma, and 2 units of apheresis platelets. Temperature is maintained at 36.9 C (98.4 F) with a warming device. Toward the end of the operation the surgeon notes diffuse oozing from cut surfaces and needle holes. Laboratory studies show platelet count 140,000/mm3, prothrombin time 14 seconds, activated partial thromboplastin time 36 seconds, and fibrinogen 210 mg/dL (normal: 150-400). Ionized calcium is 0.72 mmol/L (normal: 1.10-1.35), the QT interval is prolonged, and the anesthesiologist notes carpopedal spasm when the blood pressure cuff inflates. Which of the following best explains this patient's ongoing oozing?\",\"choices\":[\"A. Chelation of calcium by citrate contained in transfused blood products\",\"B. Dilution of coagulation factors by crystalloid resuscitation\",\"C. Hyperfibrinolysis from massive tissue plasminogen activator release\",\"D. Hypothermia-induced slowing of coagulation enzyme kinetics\",\"E. Platelet dysfunction from accumulated uremic toxins\"],\"correct\":0,\"explanation\":\"Calcium was historically numbered factor IV because it is an obligatory cofactor throughout the cascade, required for the assembly of the vitamin K-dependent factors on phospholipid surfaces. Blood products are anticoagulated with citrate, which chelates calcium -> rapid, large-volume transfusion delivers a citrate load faster than the liver can metabolize it -> ionized hypocalcemia with perioral paresthesias, Trousseau sign, QT prolongation, and impaired coagulation. Treatment is intravenous calcium. The same principle explains why the coagulation specimen tube contains citrate and why the laboratory must add calcium back before the reaction can start.\\nEducational objective: Calcium is an obligatory cofactor in the coagulation cascade, and citrate in transfused blood products chelates it. Rapid massive transfusion therefore causes ionized hypocalcemia with tetany, QT prolongation, and coagulopathy, which is corrected with intravenous calcium rather than more plasma.\",\"wrongExplanations\":{\"1\":\"Dilutional coagulopathy from crystalloid and red cells does complicate massive transfusion and prolongs both clotting times while lowering fibrinogen. This patient's prothrombin time, activated partial thromboplastin time, and fibrinogen are essentially normal, which excludes a meaningful factor deficit.\",\"2\":\"Hyperfibrinolysis occurs in severe trauma and is treated with tranexamic acid; it is accompanied by a very low fibrinogen and a markedly elevated D-dimer. Fibrinogen here is 210 mg/dL, which is inconsistent with fulminant fibrinolysis.\",\"3\":\"Hypothermia impairs both enzyme kinetics and platelet function and is a classic component of the trauma lethal triad. Active warming has kept this patient at 36.9 C, explicitly excluding it.\",\"4\":\"Uremic platelet dysfunction causes mucocutaneous bleeding in advanced renal failure and is treated with desmopressin or dialysis. It develops over weeks of azotemia rather than within 90 minutes of an injury.\"},\"eli5\":\"Blood in a bag is kept liquid with a chemical that grabs calcium, and calcium is something clotting cannot happen without. Pour in a dozen bags quickly and you strip the patient's own calcium too. Giving calcium back fixes both the muscle cramps and the oozing.\"},{\"stem\":\"An investigator is characterizing a plasma fragment generated during clot breakdown. In a reaction vessel containing purified fibrinogen, thrombin, factor XIII, and calcium, addition of plasmin releases the fragment in abundance. When the same reaction is run with a specific factor XIII inhibitor present, fibrin still forms and plasmin still degrades it, but the fragment is no longer detectable. When plasmin is added to fibrinogen that has not been exposed to thrombin, the fragment is likewise absent. Detection of this fragment in a patient's plasma therefore indicates that which of the following sequences has occurred?\",\"choices\":[\"A. Fibrinogen cleaved by thrombin -> fibrin polymerized -> cross-linked by factor XIII -> degraded by plasmin\",\"B. Fibrinogen cleaved by thrombin -> fibrin polymerized -> degraded by plasmin without cross-linking\",\"C. Fibrinogen degraded by plasmin -> fragments released -> no fibrin formed -> no cross-linking\",\"D. Plasminogen converted to plasmin -> circulating plasmin activity -> no fibrin formed -> no degradation\",\"E. Prothrombin converted to thrombin -> thrombin bound by antithrombin -> no fibrinogen cleavage -> no fibrin\"],\"correct\":0,\"explanation\":\"Fibrin monomers contain regions designated D and E. Factor XIII covalently cross-links two adjacent D regions of neighboring monomers, and plasmin cannot cleave that covalent bond -> when plasmin digests the mesh, the released fragment carries two D regions, a D-dimer. The experiment reproduces each requirement: no thrombin means no fibrin, no factor XIII means no cross-link, and either abolishes the fragment. This is exactly why a D-dimer is a marker of clot turnover rather than of clotting alone, and why it rises in venous thromboembolism and in disseminated intravascular coagulation.\\nEducational objective: A D-dimer can be generated only if fibrinogen has been cleaved to fibrin, the fibrin has been cross-linked by factor XIII, and the cross-linked mesh has then been degraded by plasmin. It is therefore a marker of clot formation and breakdown, not simply of coagulation activation.\",\"wrongExplanations\":{\"1\":\"Plasmin degradation of uncross-linked fibrin releases fibrin degradation products, which are measurable but are not D-dimers, since no covalent D-D bond exists to survive digestion. This is precisely the condition the factor XIII inhibitor created, in which the fragment disappeared.\",\"2\":\"Plasmin acting directly on fibrinogen releases fibrinogen degradation products, as occurs in primary hyperfibrinolysis. The experiment showed that omitting thrombin abolishes the fragment, so fibrinogenolysis alone cannot generate it.\",\"3\":\"Circulating plasmin without fibrin formation describes a purely fibrinolytic state and generates no fibrin-derived fragment at all. Some substrate must first have been converted to cross-linked fibrin.\",\"4\":\"Thrombin neutralization by antithrombin, the mechanism heparin potentiates, prevents fibrin formation entirely. Without fibrin there is nothing to cross-link and nothing to degrade.\"},\"eli5\":\"When a clot is built, an enzyme welds neighboring strands together at specific spots. The dissolving enzyme can cut almost everywhere except through those welds. So a fragment carrying two welded pieces proves a real clot was built and then taken apart.\"},{\"stem\":\"A 58-year-old man is admitted to the hospital due to jaundice and one episode of hematemesis. He has a 20-year history of heavy alcohol use and was found last month to have thrombocytopenia and splenomegaly. Temperature is 38.4 C (101.1 F), blood pressure is 96/58 mm Hg, and pulse is 116/min. Physical examination shows scleral icterus, spider angiomata, ascites, and blood oozing from two venipuncture sites. Laboratory studies show prothrombin time 21 seconds, activated partial thromboplastin time 48 seconds, platelet count 62,000/mm3, fibrinogen 128 mg/dL (normal: 150-400), and a markedly elevated D-dimer; the peripheral smear shows occasional schistocytes. The team is uncertain whether this represents hepatic synthetic failure or disseminated intravascular coagulation complicating an infection. Measurement of which of the following would be most helpful in distinguishing between the two?\",\"choices\":[\"A. Antithrombin activity\",\"B. Factor V activity\",\"C. Factor VII activity\",\"D. Factor VIII activity\",\"E. Protein C activity\",\"F. Von Willebrand factor antigen\"],\"correct\":3,\"explanation\":\"The liver synthesizes every coagulation protein except von Willebrand factor and factor VIII, which come from endothelium (and megakaryocytes). In hepatic synthetic failure, factor VIII is therefore spared and is characteristically normal or elevated even when the prothrombin time, fibrinogen, and platelet count are all abnormal. In disseminated intravascular coagulation, factor VIII is consumed along with everything else and falls. Factor VIII is thus the discriminating assay when the two overlap clinically, as they do here.\\nEducational objective: The liver makes all coagulation factors except factor VIII and von Willebrand factor. Factor VIII activity is therefore normal or increased in liver disease but decreased in disseminated intravascular coagulation, making it the assay that separates the two when clotting times, fibrinogen, and platelets are abnormal in both.\",\"wrongExplanations\":{\"0\":\"Antithrombin is hepatically synthesized and also consumed in disseminated intravascular coagulation, so it falls in both conditions and discriminates nothing. Its measurement is useful in evaluating inherited thrombophilia and heparin resistance.\",\"1\":\"Factor V is the assay that separates vitamin K deficiency from liver disease, since it is hepatically made but not vitamin K dependent: normal in vitamin K deficiency, low in liver disease. It is consumed in disseminated intravascular coagulation as well, so it falls in both conditions here.\",\"2\":\"Factor VII has the shortest half-life of the vitamin K-dependent factors and is the first to fall in warfarin therapy and vitamin K deficiency. It is reduced both by hepatic synthetic failure and by consumption, so it cannot distinguish them.\",\"4\":\"Protein C is a hepatically synthesized, vitamin K-dependent natural anticoagulant that falls in liver disease and is also consumed in disseminated intravascular coagulation. Its main role is in evaluating thrombophilia and warfarin-induced skin necrosis.\",\"5\":\"Von Willebrand factor is endothelial in origin and is a positive acute phase reactant, so it is normal or elevated in both liver disease and sepsis-associated disseminated intravascular coagulation. It cannot separate them, whereas its cargo, factor VIII, can.\"},\"eli5\":\"Almost every clotting protein is built by the liver, with two exceptions made by blood vessel lining instead. So if the liver is failing, those two stay normal while everything else drops. If clotting proteins are being used up all over the body, even those two fall.\"},{\"stem\":\"A 3-year-old boy is evaluated in the hematology clinic 6 months after being diagnosed with severe hemophilia A; his factor VIII activity is less than 1%. He has had two spontaneous knee hemarthroses and one spontaneous elbow bleed, each treated with factor VIII concentrate at the time of the episode. He is now started on factor VIII concentrate given on a fixed schedule several times weekly rather than only when bleeding occurs. His parents ask why the medication is given when he is well. Which of the following best describes the reason for this approach?\",\"choices\":[\"A. It eliminates the risk of developing an inhibitor to infused factor VIII\",\"B. It maintains the factor level above the threshold at which spontaneous bleeding occurs\",\"C. It normalizes the activated partial thromboplastin time between doses\",\"D. It permits substitution of fresh frozen plasma for factor concentrate\",\"E. It restores the platelet contribution to overall clot strength\"],\"correct\":1,\"explanation\":\"Hemophilia severity is defined by the factor level: below 1% is severe with spontaneous bleeding, 1%-5% is moderate with bleeding after minor trauma, and above 5%-30% is mild with bleeding mainly after surgery or significant trauma. Keeping the trough level above roughly 5%, and ideally 20%-30%, converts a severe phenotype into a mild one and largely abolishes spontaneous bleeding. This matters because repeated hemarthroses scar the synovium and cartilage, and progressive hemophilic arthropathy is the major cause of long-term morbidity. Prophylaxis, not on-demand treatment, is what preserves joints.\\nEducational objective: Prophylactic factor replacement in severe hemophilia maintains the trough factor level above the threshold for spontaneous bleeding, preventing the recurrent hemarthroses that cause hemophilic arthropathy. The therapeutic goal is a mild phenotype, not a normal factor level.\",\"wrongExplanations\":{\"0\":\"Inhibitor development is the single largest management problem in hemophilia, and prophylaxis does not eliminate it; the risk relates to the underlying mutation and early exposure pattern. Loss of response to a previously effective dose signals an inhibitor and is confirmed by a non-correcting mixing study and a Bethesda titer.\",\"2\":\"Normalizing a laboratory value is not the goal, and the activated partial thromboplastin time is not used to titrate factor replacement; factor activity levels are. Treating the number rather than the phenotype also appears in liver disease, where a prolonged prothrombin time does not by itself justify plasma transfusion.\",\"3\":\"Patients with hemophilia should specifically not receive plasma or cryoprecipitate except as an absolute last resort, a rule that dates from transfusion-transmitted HIV and hepatitis in the 1980s. Modern concentrates undergo viral inactivation.\",\"4\":\"Platelet function is entirely normal in hemophilia, which is a disorder of secondary hemostasis; that is why these patients bleed into joints and muscles rather than mucocutaneously. Factor replacement restores fibrin generation, not platelet activity.\"},\"eli5\":\"Every bleed into a joint scars it a little, and enough of them leave the joint permanently damaged. Giving the missing protein on a schedule keeps the level just high enough that bleeds do not start on their own. You are protecting the joints, not chasing a normal blood test.\"},{\"stem\":\"A 66-year-old man is evaluated on hospital day 6 for an abnormal coagulation study. He was admitted with complicated diverticulitis, has been receiving broad-spectrum antibiotics, and has taken almost nothing by mouth. He takes no anticoagulants and has no history of liver disease or bleeding. Vital signs are within normal limits. Physical examination shows a soft abdomen with a healing incision and no bruising, jaundice, or stigmata of chronic liver disease. Laboratory studies show prothrombin time 19 seconds with an international normalized ratio of 1.8, activated partial thromboplastin time 33 seconds, platelet count 288,000/mm3, fibrinogen 420 mg/dL (normal: 150-400), and normal transaminases and bilirubin. Which of the following best explains why the prothrombin time is prolonged while the activated partial thromboplastin time remains normal at this stage?\",\"choices\":[\"A. Factor V is not vitamin K dependent and remains normal\",\"B. Factor VII has the shortest plasma half-life of the vitamin K-dependent factors\",\"C. Factor VIII rises as a positive acute phase reactant during infection\",\"D. Factor XII is the principal determinant of the activated partial thromboplastin time\",\"E. Fibrinogen concentration is preserved in early deficiency\"],\"correct\":1,\"explanation\":\"Vitamin K is required for gamma-carboxylation of factors II, VII, IX, and X and of proteins C and S; poor intake plus antibiotic suppression of gut flora depletes it. Factor VII has by far the shortest plasma half-life of the group, roughly 4-6 hours -> its activity falls first -> the prothrombin time, which is most sensitive to factor VII, prolongs while the activated partial thromboplastin time is still normal. Only as factors IX, X, and II fall does the aPTT follow. This is the same sequence warfarin exploits, and it is why the international normalized ratio responds within a day of starting or stopping the drug.\\nEducational objective: In early vitamin K deficiency or warfarin therapy, factor VII falls first because it has the shortest half-life of the vitamin K-dependent factors, producing an isolated prolonged prothrombin time. The activated partial thromboplastin time prolongs later, as factors IX, X, and II decline.\",\"wrongExplanations\":{\"0\":\"Factor V being vitamin K independent is the point that separates vitamin K deficiency, in which factor V is normal, from liver disease, in which factor V falls with everything else. It explains the discriminating assay rather than why the prothrombin time prolongs before the activated partial thromboplastin time.\",\"2\":\"Factor VIII does rise during inflammation and is normal or high in liver disease, which is why it separates liver disease from disseminated intravascular coagulation. It could mask a mild activated partial thromboplastin time prolongation but is not the reason the prothrombin time moves first.\",\"3\":\"Factor XII strongly influences the activated partial thromboplastin time in vitro, which is why its deficiency prolongs the test without causing bleeding. It is not vitamin K dependent and plays no part in this sequence.\",\"4\":\"Fibrinogen is preserved here and is in fact elevated as an acute phase reactant, but fibrinogen sits in the common pathway and affects both clotting times equally. It cannot explain why one test is prolonged and the other is not.\"},\"eli5\":\"Vitamin K is needed to finish four clotting proteins, and one of them wears out much faster than the others. When the vitamin runs short, that fast-turnover protein disappears first. The test that watches it goes abnormal days before the other one does.\"},{\"stem\":\"A 3-day-old male infant is brought to the emergency department due to oozing from the umbilical stump and two bloody stools over the past 6 hours. He was delivered at term at home after an uncomplicated pregnancy by a healthy mother who took no medications, and he received no injections after delivery. He has been exclusively breastfed and is feeding well. Vital signs are appropriate for age. Physical examination shows persistent oozing from the umbilical stump and scattered ecchymoses over the trunk; there is no hepatosplenomegaly, jaundice, or dysmorphism. Laboratory studies show a markedly prolonged prothrombin time, a prolonged activated partial thromboplastin time, a normal platelet count, normal fibrinogen concentration, and a normal D-dimer. Which of the following best explains this infant's bleeding?\",\"choices\":[\"A. Consumption of coagulation factors within widespread microthrombi\",\"B. Deficient gamma-carboxylation of factors II, VII, IX, and X\",\"C. Maternal antiplatelet alloantibody crossing the placenta\",\"D. Reduced hepatic synthesis of coagulation factors from neonatal hepatitis\",\"E. X-linked deficiency of factor VIII activity\"],\"correct\":1,\"explanation\":\"Newborns are relatively vitamin K deficient: placental transfer is poor, hepatic stores are low, the gut is not yet colonized by vitamin K-producing flora, and breast milk contains little. Without the routine intramuscular vitamin K given at birth, factors II, VII, IX, and X cannot be gamma-carboxylated and are functionally inactive -> both clotting times prolong while the platelet count, fibrinogen, and D-dimer stay normal -> hemorrhagic disease of the newborn, which can include catastrophic intracranial hemorrhage. Delivery outside a hospital is the classic history, because that is where the prophylactic injection is missed.\\nEducational objective: Vitamin K deficiency bleeding of the newborn follows omission of the routine vitamin K injection and produces prolonged prothrombin and activated partial thromboplastin times with a normal platelet count and fibrinogen. Vitamin K is required for gamma-carboxylation of factors II, VII, IX, and X and of proteins C and S.\",\"wrongExplanations\":{\"0\":\"Consumptive coagulopathy in a neonate accompanies sepsis, birth asphyxia, or necrotizing enterocolitis and shows thrombocytopenia, a low fibrinogen, and a markedly raised D-dimer. This infant is well appearing with a normal platelet count, fibrinogen, and D-dimer.\",\"2\":\"Maternal alloantibody against a paternally inherited platelet antigen causes neonatal alloimmune thrombocytopenia, presenting with petechiae, purpura, and a risk of intracranial hemorrhage. The platelet count would be very low and the clotting times normal.\",\"3\":\"Neonatal hepatitis and other causes of hepatic synthetic failure prolong clotting times but present with conjugated hyperbilirubinemia, jaundice, and hepatomegaly. This infant has none of those findings.\",\"4\":\"Hemophilia A can present in the newborn period with bleeding after circumcision or an intracranial hemorrhage, but it prolongs only the activated partial thromboplastin time and leaves the prothrombin time normal. Both times are prolonged here.\"},\"eli5\":\"Babies are born with very little vitamin K, which the body needs to finish building four clotting proteins. That is why every newborn gets a shot of it right after birth. A baby born at home who missed the shot can start bleeding a few days later.\"},{\"stem\":\"A 12-year-old boy with severe hemophilia A and a high-titer inhibitor to factor VIII is evaluated in clinic. Six months ago he was switched from factor VIII concentrate to a subcutaneously administered bispecific antibody, and he has had no bleeding episodes since. Vital signs are within normal limits and physical examination shows no joint swelling or effusion. Routine laboratory studies show an activated partial thromboplastin time of 22 seconds (reference range: 25-39), prothrombin time 12 seconds, and platelet count 268,000/mm3. A factor VIII activity assay performed by a one-stage clotting method reports a spuriously normal value. Which of the following best explains the shortened activated partial thromboplastin time?\",\"choices\":[\"A. Eradication of the factor VIII inhibitor by concurrent immunosuppression\",\"B. Recovery of endogenous factor VIII production from the mutant allele\",\"C. Restoration of the bridge between factor IXa and factor X by the administered antibody\",\"D. Spurious shortening from an underfilled sodium citrate collection tube\",\"E. Thrombocytosis increasing the phospholipid surface available to the assay\"],\"correct\":2,\"explanation\":\"Factor VIIIa is not an enzyme; it is a cofactor that holds factor IXa and factor X adjacent to one another so that factor X can be activated. Emicizumab is a bispecific antibody with one arm binding factor IXa and the other binding factor X -> it reproduces that geometry without reproducing the protein -> an anti-factor VIII antibody cannot neutralize it, which is why it works in inhibitor patients. Because the aPTT reagent measures exactly this intrinsic tenase reaction, the drug drives the clotting time to normal or short values that do not reflect hemostatic capacity, and one-stage factor VIII assays are likewise invalid. Monitoring requires chromogenic assays using bovine reagents.\\nEducational objective: Emicizumab is a bispecific antibody that bridges factor IXa and factor X, substituting for factor VIIIa without being recognized by anti-factor VIII inhibitors. It markedly shortens the activated partial thromboplastin time and invalidates one-stage factor VIII assays, so these tests cannot be used to monitor therapy.\",\"wrongExplanations\":{\"0\":\"Immune tolerance induction and immunosuppression can eradicate an inhibitor, which is confirmed by a fall in the Bethesda titer and a restored response to factor VIII. That would normalize rather than shorten the activated partial thromboplastin time, and no such therapy is described.\",\"1\":\"Endogenous factor VIII production does not recover in severe hemophilia A, which reflects a germline mutation in the F8 gene. Even if it did, a normal factor level would return the clotting time into the reference range, not below it.\",\"3\":\"An underfilled citrate tube prolongs clotting times, because excess citrate chelates the calcium the laboratory adds back; it never shortens them. That artifact is a common cause of a spurious coagulopathy.\",\"4\":\"The activated partial thromboplastin time is performed on platelet-poor plasma, from which platelets have been removed by centrifugation, so the platelet count cannot influence it. This is also why the test is blind to von Willebrand disease and platelet function defects.\"},\"eli5\":\"The missing protein in hemophilia A works like a clamp that holds two other proteins next to each other so they can react. This drug is a manufactured clamp with an arm for each one. Because it is not the original protein, the patient's antibodies cannot see it, but it also confuses the laboratory test.\"},{\"stem\":\"A 28-year-old woman is evaluated for a lifelong history of easy bruising, recurrent epistaxis, and heavy menstrual bleeding. Prothrombin time, activated partial thromboplastin time, and platelet count are normal. To assess the plasma component of platelet adhesion, the laboratory adds her plasma to normal formalin-fixed donor platelets, adds ristocetin, and measures agglutination as an increase in light transmission through the stirred suspension. Agglutination in her sample is markedly reduced compared with pooled normal plasma, whereas her von Willebrand factor antigen concentration measured by enzyme-linked immunosorbent assay is near normal. Ristocetin most directly promotes which of the following interactions?\",\"choices\":[\"A. Binding of fibrinogen to platelet glycoprotein IIb/IIIa\",\"B. Binding of von Willebrand factor to platelet glycoprotein Ib\",\"C. Cleavage of von Willebrand factor multimers by ADAMTS13\",\"D. Release of dense granule contents from activated platelets\",\"E. Release of von Willebrand factor from endothelial Weibel-Palade bodies\",\"F. Thrombin-mediated conversion of fibrinogen to fibrin\"],\"correct\":1,\"explanation\":\"Primary hemostasis runs collagen -> von Willebrand factor -> platelet glycoprotein Ib -> platelet. Ristocetin, originally an antibiotic withdrawn because it caused thrombocytopenia and bruising, artificially drives von Willebrand factor onto glycoprotein Ib, forcing that adhesion step to occur in a test tube. Because the assay supplies normal fixed platelets, the platelet side of the handshake is held constant and the result reads von Willebrand factor function alone. Reduced activity with a near-normal antigen level gives a low activity-to-antigen ratio, indicating a qualitative defect (type 2 von Willebrand disease) rather than a quantitative one.\\nEducational objective: The ristocetin cofactor assay measures von Willebrand factor function by forcing it to bind platelet glycoprotein Ib on normal fixed platelets. A low activity with a near-normal antigen level indicates a qualitative (type 2) defect, whereas activity and antigen falling together indicates a quantitative (type 1 or 3) defect.\",\"wrongExplanations\":{\"0\":\"Fibrinogen binding to glycoprotein IIb/IIIa mediates platelet-to-platelet aggregation and is the step lost in Glanzmann thrombasthenia, which shows reduced aggregation to arachidonic acid, collagen, and ADP with a normal ristocetin response. Ristocetin does not act at this receptor.\",\"2\":\"ADAMTS13 trims von Willebrand factor multimers to size, and its deficiency causes thrombotic thrombocytopenic purpura. It is measured by a separate activity assay, and ristocetin does not activate it.\",\"3\":\"Dense granule secretion is measured by ATP-driven luciferase luminescence in lumi-aggregometry and is reduced in delta granule storage pool disease, as in Hermansky-Pudlak syndrome. Ristocetin tests adhesion rather than secretion.\",\"4\":\"Desmopressin releases stored von Willebrand factor and factor VIII from endothelial Weibel-Palade bodies and is the first-line treatment for type 1 disease. It acts in vivo on endothelium, not in a cuvette on fixed platelets.\",\"5\":\"Thrombin-mediated fibrin formation is the endpoint of the prothrombin time and activated partial thromboplastin time, both of which are normal in this patient. It belongs to secondary hemostasis, which this assay deliberately bypasses.\"},\"eli5\":\"There is a handshake between a sticky plasma protein and a receptor on the platelet surface. Ristocetin forces that handshake to happen inside a test tube so it can be measured. Using donor platelets means anything abnormal must be coming from the patient's plasma.\"},{\"stem\":\"A 26-year-old woman with a lifelong history of easy bruising, epistaxis, and heavy menstrual bleeding is evaluated before a dental extraction. Vital signs are within normal limits and physical examination shows scattered ecchymoses. Laboratory studies show von Willebrand factor antigen 68%, ristocetin cofactor activity 24%, factor VIII activity 62%, platelet count 96,000/mm3, and normal prothrombin and activated partial thromboplastin times; multimer analysis shows loss of the high molecular weight forms. She is given desmopressin as a therapeutic trial. One hour later she develops gum bleeding, and the platelet count has fallen to 44,000/mm3. Which of the following best explains the decline in her platelet count?\",\"choices\":[\"A. Antibody-mediated destruction of desmopressin-coated platelets\",\"B. Dilutional decrease from desmopressin-induced free water retention\",\"C. Increased binding of abnormal von Willebrand factor to platelet glycoprotein Ib\",\"D. Splenic sequestration from desmopressin-induced splenic congestion\",\"E. Suppression of megakaryocyte maturation by desmopressin\"],\"correct\":2,\"explanation\":\"An activity-to-antigen ratio of 24/68, well below 0.5-0.7, with loss of high molecular weight multimers identifies a qualitative defect, that is, type 2 von Willebrand disease; the accompanying thrombocytopenia points specifically to type 2B. In type 2B the abnormal von Willebrand factor binds platelet glycoprotein Ib with excessive avidity even without vascular injury -> circulating platelets are bound and cleared -> baseline thrombocytopenia. Desmopressin releases more of this abnormal protein from endothelial stores -> more spontaneous platelet binding and clearance -> the platelet count falls further and bleeding worsens. Type 2B and type 3 are therefore treated with a plasma-derived von Willebrand factor/factor VIII concentrate rather than desmopressin.\\nEducational objective: Desmopressin is contraindicated in type 2B von Willebrand disease, because releasing more of the abnormally avid von Willebrand factor increases its binding to platelet glycoprotein Ib and worsens thrombocytopenia. Type 2B and type 3 disease are treated with von Willebrand factor-containing concentrates instead.\",\"wrongExplanations\":{\"0\":\"Antibody-mediated platelet destruction defines immune thrombocytopenia, in which autoantibodies against glycoprotein IIb/IIIa opsonize platelets for splenic clearance. There is no immune mechanism linking desmopressin to platelet antibodies, and this patient has a von Willebrand factor abnormality on multimer analysis.\",\"1\":\"Desmopressin does cause free water retention and hyponatremia, which is why fluid restriction accompanies its use, particularly in young children. Dilution of this magnitude within an hour would produce symptomatic hyponatremia rather than halving the platelet count.\",\"3\":\"Splenic sequestration lowers the platelet count in hypersplenism from portal hypertension and is accompanied by splenomegaly and often pancytopenia. Desmopressin does not cause splenic congestion, and no splenomegaly is described.\",\"4\":\"Suppression of megakaryocyte maturation lowers platelet counts over days to weeks, as with cytotoxic chemotherapy or alcohol. It cannot account for a fall occurring within 1 hour of a single dose.\"},\"eli5\":\"In this form of the disease, the sticky protein grabs platelets even when there is no injury, and those platelets get cleared out. The drug works by releasing a big extra supply of that protein from storage. Giving more of a protein that is already grabbing platelets makes the count drop further.\"},{\"stem\":\"A 21-year-old woman is evaluated for a single episode of prolonged bleeding after removal of a wisdom tooth 3 years ago, which stopped with local packing. She has no history of epistaxis, gum bleeding, easy bruising, or heavy menstrual periods, and no family history of bleeding. Vital signs are within normal limits and physical examination is normal. Laboratory studies show prothrombin time 12 seconds, activated partial thromboplastin time 30 seconds, and platelet count 265,000/mm3. Von Willebrand factor antigen is 44%, ristocetin cofactor activity is 42%, and factor VIII activity is 78%; multimer analysis shows a normal distribution with a mildly reduced overall amount. Her blood type is O positive. Which of the following best explains this patient's von Willebrand factor level?\",\"choices\":[\"A. Accelerated multimer proteolysis from increased ADAMTS13 activity\",\"B. Blood group O is associated with a lower baseline von Willebrand factor level\",\"C. Consumption of von Willebrand factor across a stenotic aortic valve\",\"D. Loss of high molecular weight multimers from a qualitative defect\",\"E. Reduced hepatic synthesis of von Willebrand factor\"],\"correct\":1,\"explanation\":\"Von Willebrand factor levels vary substantially with ABO blood group: group O individuals have levels roughly 25% lower than non-O individuals, because group O von Willebrand factor is cleared more rapidly. A level of 44% in a group O patient with a normal activity-to-antigen ratio, normal multimers, and essentially no bleeding history is most consistent with normal physiologic variation. Levels of 30%-50% occupy a deliberate grey zone between normal and type 1 disease, and the bleeding history rather than the number decides; interpreting the level without reference to blood group is how von Willebrand disease is over-diagnosed.\\nEducational objective: Von Willebrand factor levels are approximately 25% lower in blood group O individuals, so a level of 30%-50% must be interpreted against blood type and bleeding history. A normal activity-to-antigen ratio with normal multimers and no bleeding history argues against von Willebrand disease.\",\"wrongExplanations\":{\"0\":\"Excessive ADAMTS13-mediated proteolysis strips out high molecular weight multimers and produces a type 2A pattern, with activity much lower than antigen. This patient's activity and antigen are essentially equal and her multimer pattern is normal.\",\"2\":\"Shear stress across a stenotic aortic valve unfolds von Willebrand factor and exposes it to ADAMTS13, stripping high molecular weight multimers and causing acquired von Willebrand disease with gastrointestinal bleeding from angiodysplasia (Heyde syndrome). This patient is 21 years old with a normal examination and no murmur.\",\"3\":\"Loss of high molecular weight multimers defines the qualitative type 2 defects and produces an activity-to-antigen ratio below 0.5-0.7. Her ratio is 42/44, and multimer analysis is explicitly normal.\",\"4\":\"The liver synthesizes almost every coagulation protein except von Willebrand factor and factor VIII, which come from endothelial cells and megakaryocytes. Hepatic synthetic failure therefore does not lower von Willebrand factor, and she has no evidence of liver disease.\"},\"eli5\":\"How much of this clotting protein you carry depends partly on your blood type, and people with type O naturally run about a quarter lower. So a somewhat low number in a type O person with no bleeding problems is usually just normal for them. The bleeding history matters more than the number.\"},{\"stem\":\"A 30-year-old man with type 1 von Willebrand disease is evaluated before an elective inguinal hernia repair. He has had epistaxis and prolonged bleeding after dental work since childhood. Baseline laboratory studies show von Willebrand factor antigen 28%, ristocetin cofactor activity 26%, and factor VIII activity 34%, with a normal multimer distribution. He is given a test dose of desmopressin, and serial samples are drawn. Sixty minutes later, von Willebrand factor antigen is 96%, ristocetin cofactor activity is 92%, and factor VIII activity is 105%. Vital signs remain within normal limits. This rise in circulating von Willebrand factor is most directly due to which of the following?\",\"choices\":[\"A. Increased hepatic synthesis of von Willebrand factor\",\"B. Increased transcription of the VWF gene in megakaryocytes\",\"C. Inhibition of ADAMTS13-mediated multimer cleavage\",\"D. Reduced renal clearance of circulating von Willebrand factor\",\"E. Release of stored von Willebrand factor from endothelial Weibel-Palade bodies\"],\"correct\":4,\"explanation\":\"Endothelial cells store preformed von Willebrand factor in Weibel-Palade bodies. Desmopressin, a vasopressin analogue acting at the V2 receptor, triggers exocytosis of these granules -> stored von Willebrand factor and the factor VIII it carries are released into plasma within minutes to an hour. This works in type 1 disease precisely because the stored protein is structurally normal and merely present in reduced quantity. It cannot work in type 3, where there is nothing stored to release, and it is hazardous in type 2B. A documented response is established with a test dose before an operation, so that a non-responder is identified in advance and given concentrate instead.\\nEducational objective: Desmopressin releases preformed von Willebrand factor and factor VIII from endothelial Weibel-Palade bodies, making it first-line therapy for type 1 von Willebrand disease. It is ineffective in type 3, in which no normal protein is stored, and can worsen thrombocytopenia in type 2B.\",\"wrongExplanations\":{\"0\":\"Hepatic synthesis is irrelevant here, because von Willebrand factor and factor VIII are the two coagulation proteins the liver does not make; they originate from endothelial cells and megakaryocytes. This is also why factor VIII is normal or high in liver disease.\",\"1\":\"Increased gene transcription would require hours to days to raise circulating protein levels and would not produce a fourfold rise within 60 minutes. The speed of the response is what identifies release of a preformed store.\",\"2\":\"Inhibiting ADAMTS13 would preserve ultra-large multimers and, taken to an extreme, produces thrombotic thrombocytopenic purpura. Desmopressin does not inhibit this protease, and the multimer distribution here was already normal.\",\"3\":\"Von Willebrand factor is a very large multimeric glycoprotein that is not cleared by glomerular filtration, so renal handling does not set its plasma level. Clearance differences do matter between ABO blood groups, but that is a chronic baseline effect rather than an acute drug response.\"},\"eli5\":\"The lining of your blood vessels keeps a stockpile of this clotting protein in tiny storage packets. The drug tells those packets to dump their contents into the blood. It only helps if what is stored actually works, which is why it is not used for every type of the disease.\"},{\"stem\":\"A 19-year-old woman is evaluated for a lifetime of nosebleeds lasting more than 20 minutes, bleeding after dental cleanings, and menstrual periods requiring hourly pad changes. Vital signs are within normal limits. Physical examination shows scattered ecchymoses on the arms and no petechiae, joint swelling, or organomegaly. Laboratory studies show prothrombin time 12 seconds, activated partial thromboplastin time 31 seconds, platelet count 262,000/mm3, and fibrinogen 290 mg/dL (normal: 150-400). Specific testing subsequently establishes a defect of platelet adhesion. Which of the following best explains why the prothrombin time and activated partial thromboplastin time failed to detect this patient's disorder?\",\"choices\":[\"A. Both assays are performed on plasma from which platelets have been removed\",\"B. Both assays are terminated at the first appearance of fibrin strands\",\"C. Platelet function is adequately reflected by the platelet count\",\"D. The activated partial thromboplastin time is insensitive to factor VIII\",\"E. The prothrombin time is reported as a standardized international normalized ratio\"],\"correct\":0,\"explanation\":\"The prothrombin time and activated partial thromboplastin time are plasma assays. The citrated specimen is centrifuged and the plasma alone is loaded, so every platelet is discarded with the cell pellet before the test begins; calcium is then added back and the time to fibrin formation is measured. These tests are therefore structurally incapable of detecting a disorder of primary hemostasis, and no reagent improvement can change that. This is why von Willebrand disease and platelet function defects have a completely normal coagulation screen, and why von Willebrand testing must be requested separately in any patient with a mucocutaneous bleeding history.\\nEducational objective: The prothrombin time and activated partial thromboplastin time are performed on platelet-poor plasma and cannot detect disorders of primary hemostasis. Von Willebrand disease and platelet function defects therefore have a normal coagulation screen and require specific testing (von Willebrand antigen, ristocetin cofactor activity, aggregometry).\",\"wrongExplanations\":{\"1\":\"Both assays do stop timing when the first fibrin appears, which is why factor XIII deficiency is invisible to them: factor XIII acts only after the clot has formed, cross-linking it. That explains delayed bleeding with a normal screen, not a defect of platelet adhesion.\",\"2\":\"The platelet count measures number, not function; a patient can have a normal count with platelets that do not adhere or aggregate, as in Bernard-Soulier syndrome, Glanzmann thrombasthenia, or aspirin exposure. This is precisely the distinction the patient's normal count fails to capture.\",\"3\":\"The activated partial thromboplastin time is in fact highly sensitive to factor VIII, which is why hemophilia A prolongs it and why severe von Willebrand disease can prolong it secondarily through loss of the factor VIII carrier. This patient's factor VIII is evidently adequate.\",\"4\":\"The international normalized ratio is a mathematical standardization that makes prothrombin time results comparable between laboratories and is the number warfarin is dosed against. Standardization does not change which components of hemostasis the assay can see.\"},\"eli5\":\"Before these clotting tests are run, the blood is spun and the platelets are thrown away with the cells. So the test literally never sees the platelets. A patient whose problem is entirely with platelets will have a perfectly normal result.\"},{\"stem\":\"A 14-year-old boy with oculocutaneous albinism is evaluated for lifelong easy bruising, recurrent epistaxis, and bleeding that required packing after a tonsillectomy at age 6. Vital signs are within normal limits. Physical examination shows pale skin and light hair with nystagmus, and scattered ecchymoses over both shins. Laboratory studies show prothrombin time 12 seconds, activated partial thromboplastin time 30 seconds, and platelet count 232,000/mm3, with normal platelet size and morphology on the peripheral smear. Von Willebrand factor antigen and ristocetin cofactor activity are normal. Which of the following sets of lumi-aggregometry findings is most likely in this patient?\\n\\n     ATP release (thrombin) | Ristocetin | ADP | Collagen\",\"choices\":[\"A. Decreased | Decreased | Normal | Normal\",\"B. Decreased | Normal | Decreased | Decreased\",\"C. Normal | Decreased | Normal | Normal\",\"D. Normal | Normal | Decreased | Decreased\",\"E. Normal | Normal | Normal | Normal\"],\"correct\":1,\"explanation\":\"Oculocutaneous albinism with a lifelong mucocutaneous bleeding disorder and normal-sized platelets points to Hermansky-Pudlak syndrome, a disorder of lysosome-related organelle biogenesis affecting melanosomes and platelet dense (delta) granules. Absent dense granules -> no ADP, serotonin, or ATP is released on activation -> the luciferase channel records decreased ATP release, and because released ADP normally recruits and amplifies aggregation, responses to ADP and collagen are secondarily reduced. Ristocetin-induced agglutination is normal, because the glycoprotein Ib-von Willebrand factor axis is intact. Electron microscopy confirms the absent granules.\\nEducational objective: Delta (dense) granule storage pool disease shows decreased ATP release with variably reduced aggregation to ADP and collagen and a normal ristocetin response; it occurs in Hermansky-Pudlak and Chediak-Higashi syndromes. Read the ristocetin column first: it is reduced only when the glycoprotein Ib-von Willebrand factor axis is broken.\",\"wrongExplanations\":{\"0\":\"Reduced ATP release with a reduced ristocetin response and otherwise normal aggregation does not correspond to a single recognized entity, since dense granule deficiency spares ristocetin and glycoprotein Ib defects spare secretion. Combining them would require two simultaneous disorders.\",\"2\":\"An isolated decrease in ristocetin-induced agglutination with everything else normal indicates a defect of the glycoprotein Ib-IX-V receptor, that is, Bernard-Soulier syndrome, or von Willebrand disease when patient platelets are used. Bernard-Soulier also shows thrombocytopenia with characteristically large platelets, and this patient's count and platelet size are normal.\",\"3\":\"Normal ATP release and ristocetin response with decreased aggregation to ADP, collagen, and arachidonic acid describe Glanzmann thrombasthenia, a deficiency of glycoprotein IIb/IIIa, the fibrinogen receptor; aspirin exposure produces a similar pattern. Adhesion is intact in that disorder but secretion would not be reduced.\",\"4\":\"Entirely normal aggregometry would be expected in a patient whose bleeding arises from a vascular or connective tissue disorder such as hereditary hemorrhagic telangiectasia or Ehlers-Danlos syndrome. This patient's albinism points directly to a granule biogenesis defect.\"},\"eli5\":\"Platelets carry tiny packets of chemicals they spray out to call in more platelets. In this condition those packets are never built properly, and the same building fault also explains the pale skin and hair. Without the call for backup, the platelet plug is weak.\"},{\"stem\":\"A 46-year-old man is evaluated for easy bruising and prolonged oozing after a punch skin biopsy performed 2 weeks ago. He had a myocardial infarction 3 years ago and takes aspirin 81 mg daily, atorvastatin, and metoprolol. He reports no bleeding before the myocardial infarction and no family history of bleeding. Vital signs are within normal limits. Physical examination shows scattered ecchymoses over the forearms and no petechiae or telangiectasias. Laboratory studies show prothrombin time 12 seconds, activated partial thromboplastin time 31 seconds, platelet count 244,000/mm3, and normal von Willebrand factor antigen and ristocetin cofactor activity. Lumi-aggregometry shows markedly decreased aggregation to arachidonic acid with variably decreased responses to collagen and ADP; ristocetin-induced agglutination and thrombin-stimulated ATP release are normal. Which of the following is the most appropriate next step in management of this patient?\",\"choices\":[\"A. Flow cytometry for platelet glycoprotein IIb/IIIa expression\",\"B. Measurement of factor XIII activity\",\"C. Platelet electron microscopy\",\"D. Repeat aggregometry 7 to 10 days after discontinuing aspirin\",\"E. Transfusion of platelets before any further procedures\"],\"correct\":3,\"explanation\":\"Aspirin irreversibly acetylates platelet cyclooxygenase-1, blocking thromboxane A2 synthesis. Because platelets are anucleate and cannot synthesize replacement enzyme, the effect persists for the 7- to 10-day platelet lifespan -> aggregometry shows a pattern indistinguishable from an inherited thromboxane pathway defect, with arachidonic acid affected most and collagen and ADP variably reduced. A normal ristocetin response excludes Bernard-Soulier syndrome and von Willebrand disease, and normal ATP release excludes a storage pool defect. The history is decisive: bleeding began only after aspirin was started. Repeating the study after 7-10 days off the drug, once new platelets have circulated, distinguishes drug effect from an inherited defect.\\nEducational objective: Aspirin produces an aggregometry pattern identical to an inherited thromboxane pathway defect, with reduced arachidonic acid-induced aggregation and a normal ristocetin response. Because inhibition is irreversible and platelets are anucleate, the study must be repeated 7-10 days after stopping the drug before an inherited disorder is diagnosed.\",\"wrongExplanations\":{\"0\":\"Flow cytometry for glycoprotein IIb/IIIa (CD41/CD61) confirms Glanzmann thrombasthenia, which abolishes aggregation to arachidonic acid, collagen, and ADP in a patient with lifelong bleeding. This patient bled only after starting aspirin, and the responses are reduced rather than absent.\",\"1\":\"Factor XIII activity is measured when bleeding is delayed by hours after hemostasis was initially achieved and all screening tests, including the platelet count, are normal. This patient's abnormality has already been localized to platelet aggregation.\",\"2\":\"Platelet electron microscopy is used to confirm a granule storage pool defect when ATP release is reduced, as in Hermansky-Pudlak and Chediak-Higashi syndromes. Thrombin-stimulated ATP release is normal here, so granules are present and functional.\",\"4\":\"Platelet transfusion is reserved for active significant bleeding or high-risk procedures in a patient with a confirmed, uncorrectable defect. Transfusing before establishing whether the abnormality is simply a reversible drug effect exposes the patient to unnecessary risk.\"},\"eli5\":\"Aspirin permanently switches off one of the platelet's tools, and platelets cannot build a new one. So the laboratory test looks exactly like an inherited platelet disease. You have to stop the drug and wait for a fresh batch of platelets before the test means anything.\"},{\"stem\":\"A 43-year-old woman comes to the office due to nosebleeds occurring several times weekly for the past 20 years, now severe enough that she takes daily oral iron. Her father and one brother have similar nosebleeds, and her father required argon plasma coagulation for gastrointestinal bleeding. Vital signs are within normal limits. Physical examination shows conjunctival pallor and multiple 1-3 mm blanching red lesions on the vermilion border of the lips, the tongue, and the fingertips; there are no petechiae, ecchymoses, or joint abnormalities. Laboratory studies show hemoglobin 10.4 g/dL with a mean corpuscular volume of 74 fL, platelet count 310,000/mm3, prothrombin time 12 seconds, activated partial thromboplastin time 30 seconds, fibrinogen 320 mg/dL (normal: 150-400), normal von Willebrand factor antigen and ristocetin cofactor activity, and normal platelet aggregometry. Which of the following best explains this patient's bleeding?\",\"choices\":[\"A. Abnormal vascular wall structure with dilated, fragile vessels\",\"B. Accelerated clot lysis from antiplasmin deficiency\",\"C. Deficient cross-linking of fibrin by factor XIII\",\"D. Immune complex deposition in small vessel walls\",\"E. Impaired platelet adhesion to subendothelial collagen\"],\"correct\":0,\"explanation\":\"Recurrent epistaxis, mucocutaneous telangiectasias, an autosomal dominant family history, and visceral involvement identify hereditary hemorrhagic telangiectasia. Mutations in endoglin or ALK1 disrupt transforming growth factor beta signaling in endothelium -> abnormal vessel wall architecture with dilated, thin-walled telangiectasias and arteriovenous malformations -> bleeding that has nothing to do with platelets or coagulation factors, which is why the entire hemostatic workup is normal. The chronic blood loss explains the microcytic iron deficiency anemia. Proper coagulation depends on blood vessels and endothelium as well as on platelets and fibrin, so a normal coagulation panel does not end a bleeding workup.\\nEducational objective: Bleeding can arise from the vessel wall itself, with an entirely normal coagulation and platelet workup. Hereditary hemorrhagic telangiectasia, Ehlers-Danlos syndrome, small vessel vasculitis, and Kasabach-Merritt phenomenon are vascular and connective tissue causes of bleeding that the hemostatic panel cannot detect.\",\"wrongExplanations\":{\"1\":\"Antiplasmin deficiency allows premature lysis of a formed clot and causes delayed bleeding, hours after hemostasis is initially achieved, with normal screening tests. It produces no telangiectasias and does not run with visible mucocutaneous lesions.\",\"2\":\"Factor XIII deficiency also causes delayed bleeding and delayed wound healing with a normal prothrombin time, activated partial thromboplastin time, and platelet count, classically after circumcision or dental extraction. The bleeding here is immediate and arises from visible vascular lesions.\",\"3\":\"Immune complex deposition in small vessels causes IgA vasculitis and other small vessel vasculitides, presenting with palpable purpura, arthralgia, abdominal pain, and hematuria. Her lesions blanch and are neither purpuric nor palpable.\",\"4\":\"Impaired adhesion to subendothelial collagen occurs in von Willebrand disease and Bernard-Soulier syndrome and produces mucocutaneous bleeding, which could superficially fit. Her von Willebrand studies and aggregometry are normal, and neither disorder causes telangiectasias.\"},\"eli5\":\"Sometimes the clotting system is perfect and the blood vessels themselves are the problem. Here the tiny vessels are built wrong, so they are widened and fragile and break open easily. That is why every clotting test comes back normal.\"},{\"stem\":\"A 27-year-old man is evaluated after bleeding heavily during removal of an impacted wisdom tooth, requiring surgical repacking. This was the first bleeding episode of his life; he played contact sports through high school without unusual bruising and has never had a swollen joint or a spontaneous hematoma. His mother's brother had prolonged bleeding after a knee operation. Vital signs are within normal limits and physical examination is normal. Laboratory studies show prothrombin time 12 seconds, activated partial thromboplastin time 44 seconds, platelet count 256,000/mm3, and fibrinogen 300 mg/dL (normal: 150-400). A 1:1 mix with normal pooled plasma corrects the activated partial thromboplastin time, and factor IX, factor XI, and von Willebrand studies are normal. Which of the following factor VIII activity levels is most likely in this patient?\",\"choices\":[\"A. Less than 1%\",\"B. 3%\",\"C. 15%\",\"D. 45%\",\"E. 80%\"],\"correct\":2,\"explanation\":\"Hemophilia severity is defined by the factor level rather than by symptoms: below 1% is severe, with spontaneous bleeding including hemarthrosis; 1%-5% is moderate, with bleeding after minor trauma; and above 5% to 30% is mild, with bleeding only after surgery or significant trauma. This patient reached adulthood, played contact sports, and bled for the first time during an extraction, which places him in the mild range. This also lines up with the 50% rule: roughly 50% factor activity is needed for full hemostasis, and levels of 30%-40% are hemostatically adequate day to day, while the activated partial thromboplastin time begins to prolong below about 50% and exceeds roughly 45 seconds once the level falls under 20%.\\nEducational objective: Hemophilia severity is graded by factor activity: below 1% (severe, spontaneous bleeding), 1%-5% (moderate, bleeding after minor trauma), and above 5%-30% (mild, bleeding after surgery or major trauma). Mild disease can go undetected until a first surgical challenge.\",\"wrongExplanations\":{\"0\":\"A level below 1% defines severe hemophilia, with spontaneous hemarthroses and deep hematomas typically beginning in the first years of life and an activated partial thromboplastin time often exceeding 100 seconds. This patient bled for the first time at age 27.\",\"1\":\"A level of 3% defines moderate hemophilia, with bleeding provoked by minor trauma such as a fall or a sports collision. His years of contact sport without unusual bruising argue against this range.\",\"3\":\"A level of 45% sits just below the 50% threshold needed for full hemostasis and is typical of a carrier female or a mild carrier state; the activated partial thromboplastin time would be normal or barely prolonged. It does not fit an activated partial thromboplastin time of 44 seconds with surgical bleeding.\",\"4\":\"A level of 80% is within the normal range and would produce a normal activated partial thromboplastin time and no bleeding tendency at all. Some other explanation would then be required for both the abnormal test and the surgical hemorrhage.\"},\"eli5\":\"How bad hemophilia is depends on how much of the clotting protein a person still makes. A tiny amount means bleeding for no reason at all; a moderate amount means you only bleed when something goes wrong, like surgery. That is why mild cases can go unnoticed for decades.\"},{\"stem\":\"A 19-month-old boy is brought to the office due to refusal to bear weight on the right leg for 2 days. Four days ago he received routine immunizations by intramuscular injection in the right thigh. His mother recalls prolonged oozing after a heel stick in the newborn period. Vital signs are appropriate for age. Physical examination shows a firm, tender swelling of the right anterolateral thigh with overlying ecchymosis; there are no petechiae, and the mucous membranes are normal. Laboratory studies show hemoglobin 10.2 g/dL, platelet count 310,000/mm3, prothrombin time 12 seconds, and activated partial thromboplastin time 62 seconds. A 1:1 mix with normal pooled plasma corrects the activated partial thromboplastin time, and von Willebrand factor antigen and ristocetin cofactor activity are normal. Which of the following would be most helpful in distinguishing hemophilia A from hemophilia B in this patient?\",\"choices\":[\"A. Bethesda inhibitor titer\",\"B. Factor IX activity assay\",\"C. Platelet aggregometry\",\"D. Ristocetin cofactor activity\",\"E. Thrombin time\"],\"correct\":1,\"explanation\":\"Hemophilia A (factor VIII deficiency, about 1 in 5,000 males) and hemophilia B (factor IX deficiency, about 1 in 30,000 males) are both X-linked, both cause deep tissue bleeding into joints and muscles, and both give an isolated prolonged aPTT with a normal PT, a normal platelet count, and a mixing study that corrects. Nothing on the bedside examination or the screening panel separates them -> specific factor activity assays are required. Measuring factor IX activity answers the question directly: a low level establishes hemophilia B, and a normal level in this setting points to factor VIII deficiency.\\nEducational objective: Hemophilia A and B are clinically and on screening tests indistinguishable; both produce an isolated prolonged activated partial thromboplastin time that corrects on mixing. Only specific factor VIII and factor IX activity assays separate them, and factor XI deficiency (hemophilia C) is autosomal and affects both sexes.\",\"wrongExplanations\":{\"0\":\"A Bethesda titer quantifies an inhibitor once a mixing study fails to correct or a patient loses response to replacement therapy. This patient's mix corrects, indicating a deficiency, and the titer would not identify which factor is deficient.\",\"2\":\"Platelet aggregometry evaluates suspected platelet function disorders such as Glanzmann thrombasthenia and storage pool disease, which cause mucocutaneous bleeding with normal clotting times. It sits in a second- or third-tier workup and is irrelevant to an isolated prolonged activated partial thromboplastin time.\",\"3\":\"Ristocetin cofactor activity measures von Willebrand factor function and would identify von Willebrand disease, which can lower factor VIII secondarily. It has already been reported as normal in this patient.\",\"4\":\"The thrombin time assesses the final conversion of fibrinogen to fibrin and is prolonged in hypofibrinogenemia, dysfibrinogenemia, and heparin contamination. It is normal in both hemophilias and cannot distinguish them.\"},\"eli5\":\"Two different missing proteins cause exactly the same illness and exactly the same abnormal test. You cannot tell them apart by looking at the child or reading the screening panel. You have to measure each protein directly.\"},{\"stem\":\"A hospital laboratory establishes a reference interval for the activated partial thromboplastin time by assaying specimens from 200 healthy adult volunteers with no personal or family bleeding history and reporting the central 95% of observed values as the normal range, which is 25 to 39 seconds. A 24-year-old woman with no personal or family history of bleeding, who has undergone an uncomplicated appendectomy and an uncomplicated cesarean delivery, has a preoperative activated partial thromboplastin time of 40 seconds with a normal prothrombin time and platelet count. Which of the following best explains why a healthy person may have a result outside this interval?\",\"choices\":[\"A. Approximately 5% of healthy individuals fall outside a reference interval by construction\",\"B. Reference intervals are derived from hospitalized rather than ambulatory populations\",\"C. The assay reagent is insensitive to common pathway factor deficiencies\",\"D. The specimen was collected into an ethylenediaminetetraacetic acid tube\",\"E. Undetected heterozygous factor VIII deficiency is present in most such individuals\"],\"correct\":0,\"explanation\":\"A reference interval is constructed as the central 95% of values measured in a healthy reference population. By that definition, 5% of entirely normal people, roughly 2.5% at each tail, fall outside it and are flagged as abnormal despite being healthy. This is why a value a whisker past the line, in a patient with a strong negative bleeding history through two prior operations, carries almost no diagnostic weight. It also fits the factor-level curve: the aPTT begins to prolong only around 50% factor activity, levels of 30%-40% remain hemostatically adequate, and meaningful hemophilia sits below 20% with an aPTT above roughly 45 seconds.\\nEducational objective: A reference interval is the central 95% of values in a healthy population, so about 5% of healthy people test outside it by construction. A marginally abnormal result in a patient with a strong negative bleeding history, especially through prior surgery, is usually normal variation rather than disease.\",\"wrongExplanations\":{\"1\":\"Reference intervals are deliberately derived from healthy volunteers rather than hospitalized patients, precisely to avoid contamination by illness and medication effects; that is how this laboratory's interval was established. Using inpatients would widen and shift the interval rather than explain a healthy outlier.\",\"2\":\"Insensitivity to common pathway deficiency would produce a falsely normal rather than a falsely prolonged result, and common pathway defects prolong the prothrombin time as well. This patient's prothrombin time is normal.\",\"3\":\"Ethylenediaminetetraacetic acid binds calcium irreversibly and cannot be used for clotting times at all; such a specimen would not clot rather than clot slightly late. Coagulation studies require a sodium citrate tube filled to a 9:1 blood-to-citrate ratio.\",\"4\":\"Heterozygous factor VIII deficiency in a female carrier can lower the factor level and mildly prolong the activated partial thromboplastin time, particularly with skewed X-inactivation. It is far from present in most healthy individuals and would not explain the statistical structure of a reference interval.\"},\"eli5\":\"The normal range is set by testing healthy people and drawing lines that cut off the top and bottom slivers. That means about one in twenty perfectly healthy people is labeled abnormal on purpose. A number just past the line in someone who has never bled is usually nothing.\"},{\"stem\":\"A 24-year-old woman comes to the office for follow-up after being diagnosed with type 1 von Willebrand disease. Since age 13 she has had menstrual periods lasting 9 days requiring hourly pad changes, and she required a 2-unit transfusion at age 19; she was told on several occasions that heavy periods are common in young women. Vital signs are within normal limits and physical examination shows pallor. Laboratory studies show hemoglobin 9.6 g/dL with a mean corpuscular volume of 71 fL and a ferritin of 5 ng/mL. During the visit she says, \\\"I spent eleven years being told this was just how periods are. I missed school, I missed work, and nobody ever ran a single test.\\\" Which of the following is the most appropriate initial response by the physician?\",\"choices\":[\"A. \\\"Heavy periods are extremely common, so it is understandable that your previous doctors did not investigate.\\\"\",\"B. \\\"It sounds like those years cost you a great deal, and it makes sense to be angry; tell me what has been hardest, and then we can go through the plan for managing your periods now.\\\"\",\"C. \\\"Let's focus on the future, now that we finally have a diagnosis and effective treatment.\\\"\",\"D. \\\"This disorder is missed in most women, so unfortunately your experience is fairly typical.\\\"\",\"E. \\\"You may want to request your prior records to see whether testing was ever considered.\\\"\"],\"correct\":1,\"explanation\":\"Von Willebrand disease is the most common inherited bleeding disorder, and menorrhagia is its most commonly missed presentation, in part because a routine coagulation screen is entirely normal and specific testing must be requested separately. This patient has disclosed a real injury: years of morbidity, a transfusion, iron deficiency, and the experience of not being believed. The response that fits the communication hierarchy names and validates the emotion and pairs it with a concrete action, inviting her to say more and then moving to the management plan she came for. Education about how commonly the diagnosis is missed may be true, but offered first it functions as a defense of the system rather than a response to her.\\nEducational objective: When a patient describes harm from a delayed or missed diagnosis, the physician should acknowledge and validate the experience and pair it with a concrete next step, rather than explaining, defending, or redirecting. Validation preserves the alliance and elicits information the plan depends on.\",\"wrongExplanations\":{\"0\":\"This response explains and excuses the previous clinicians' reasoning before the patient's experience has been acknowledged, placing the profession's perspective ahead of her concern. It also implicitly tells her the delay was reasonable, which she has just said it was not.\",\"2\":\"Redirecting to the future closes off a disclosure the patient has deliberately made and signals that her account is not worth hearing. Moving to the plan is appropriate only after the emotion has been addressed.\",\"3\":\"Telling her that most women with this disorder are also missed normalizes the failure and shifts the conversation to the health system rather than to her. Statistical reassurance is not validation.\",\"4\":\"Directing her to obtain prior records converts an emotional disclosure into an administrative task and offloads the response onto the patient. It also has no bearing on her current management.\"},\"eli5\":\"She is not just here for a treatment plan; she has just said that years of her life were dismissed. The best first move is to say that you hear that and ask her to tell you more, then get to the plan. Explaining why the other doctors missed it puts them first and her second.\"},{\"stem\":\"A 64-year-old man is brought to the emergency department due to sudden-onset right-sided weakness and difficulty producing speech that began 90 minutes ago while he was eating breakfast. He has hypertension and takes lisinopril; he takes no antiplatelet or anticoagulant medication. Blood pressure is 168/92 mm Hg and pulse is 88/min. Physical examination shows right facial droop with sparing of the forehead, right arm and leg weakness, and nonfluent speech with preserved comprehension. Noncontrast CT of the head shows no hemorrhage and no established infarct, and laboratory studies including platelet count, prothrombin time, and activated partial thromboplastin time are normal. An intravenous agent is administered within the treatment window. Which of the following best describes the mechanism of the administered agent?\",\"choices\":[\"A. Conversion of plasminogen to plasmin\",\"B. Direct inhibition of thrombin\",\"C. Inhibition of cyclooxygenase-1\",\"D. Inhibition of factor Xa\",\"E. Inhibition of vitamin K epoxide reductase\",\"F. Potentiation of antithrombin\"],\"correct\":0,\"explanation\":\"Fibrinolysis is the physiologic counterpart of coagulation and the fourth requirement of a working hemostatic system: once healing is complete, the clot must be dismantled and vessel patency restored. Tissue plasminogen activator converts plasminogen to plasmin -> plasmin digests fibrin into fibrin degradation products, of which the D-dimer is the measurable species. Given therapeutically within the treatment window of an acute ischemic stroke, alteplase generates plasmin at the site of the occluding thrombus and lyses it. The other listed mechanisms prevent new clot formation but cannot dissolve a clot that already exists.\\nEducational objective: Tissue plasminogen activator converts plasminogen to plasmin, which digests fibrin and releases fibrin degradation products including D-dimer. Thrombolytics dissolve an existing clot, whereas anticoagulants and antiplatelet agents only prevent further clot formation.\",\"wrongExplanations\":{\"1\":\"Direct thrombin inhibition is the mechanism of dabigatran, argatroban, and bivalirudin, used for atrial fibrillation, venous thromboembolism, and heparin-induced thrombocytopenia. These agents prevent fibrin generation but cannot lyse a clot already occluding a cerebral artery.\",\"2\":\"Cyclooxygenase-1 inhibition is the mechanism of aspirin, which irreversibly blocks thromboxane A2 synthesis and is given for secondary stroke prevention starting 24 hours after thrombolysis. It reduces platelet aggregation rather than dissolving fibrin.\",\"3\":\"Factor Xa inhibition describes apixaban, rivaroxaban, and fondaparinux, used to treat and prevent venous thromboembolism and to prevent cardioembolic stroke in atrial fibrillation. Like other anticoagulants, these prevent rather than reverse thrombus formation.\",\"4\":\"Inhibition of vitamin K epoxide reductase is the mechanism of warfarin, which lowers functional factors II, VII, IX, and X over days and is monitored by the international normalized ratio. Its onset is far too slow for an acute stroke.\",\"5\":\"Potentiation of antithrombin is how heparin and low molecular weight heparin work, accelerating neutralization of thrombin and factor Xa; antithrombin deficiency therefore causes heparin resistance. Heparin prevents clot propagation but does not lyse established thrombus.\"},\"eli5\":\"The body has an enzyme whose job is to chew up clots once they are no longer needed, and it is kept switched off until it is needed. This drug switches it on. Blood thinners only stop new clots from forming; this one takes apart the clot that is already there.\"}]";
var PRELOADED_UI_MODE="nbme";
